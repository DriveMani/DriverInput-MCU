#include "Rte_SWC_CanCom.h"

#define SWC_CanCom_START_SEC_CODE
#include "SWC_CanCom_MemMap.h"

FUNC(void, SWC_CanCom_CODE) CanCom_Tx_func(void)
{
    Std_ReturnType ret;

    boolean brakeSw = FALSE;
    boolean accelSw = FALSE;
    boolean driverInputFault = FALSE;
    uint8 socLevel = 0U;
    uint8 vehicleSpeed = 0U;
    static uint8 aliveCounter = 0U;

    /* RTE Read: 실패 시 초기값 유지 */
    ret = Rte_Read_R_DriverInputValidatedData_BrakeSw(&brakeSw);
    if (ret != E_OK)
    {
        brakeSw = FALSE;
    }

    ret = Rte_Read_R_DriverInputValidatedData_AccelSw(&accelSw);
    if (ret != E_OK)
    {
        accelSw = FALSE;
    }

    ret = Rte_Read_R_DriverInputValidatedData_DriverInputFault(&driverInputFault);
    if (ret != E_OK)
    {
        driverInputFault = FALSE;
    }

    ret = Rte_Read_R_DriverInputValidatedData_SocLevel(&socLevel);
    if (ret != E_OK)
    {
        socLevel = 0U;
    }

    ret = Rte_Read_R_DriverInputValidatedData_VehicleSpeed(&vehicleSpeed);
    if (ret != E_OK)
    {
        vehicleSpeed = 0U;
    }

    /* Alive Counter: 4bit rollover */
    aliveCounter++;
    aliveCounter &= 0x0FU;

    /* RTE Write */
    ret = Rte_Write_Project_DriverStatus_BrakeSw(brakeSw);
    if (ret != E_OK)
    {
        /* TODO: error handling */
    }

    ret = Rte_Write_Project_DriverStatus_AccelSw(accelSw);
    if (ret != E_OK)
    {
        /* TODO: error handling */
    }

    ret = Rte_Write_Project_DriverStatus_SocLevel(socLevel);
    if (ret != E_OK)
    {
        /* TODO: error handling */
    }

    ret = Rte_Write_Project_DriverStatus_DriverInputFault((uint8)driverInputFault);
    if (ret != E_OK)
    {
        /* TODO: error handling */
    }

    ret = Rte_Write_Project_DriverStatus_AliveCounter(aliveCounter);
    if (ret != E_OK)
    {
        /* TODO: error handling */
    }

    ret = Rte_Write_Project_DriverStatus_VehicleSpeed(vehicleSpeed);
    if (ret != E_OK)
    {
        /* TODO: error handling */
    }
}

FUNC(void, SWC_CanCom_CODE) CanCom_Rx_func(void)
{
    Std_ReturnType ret;

    boolean regenEnable = FALSE;
    uint8 regenLevel = 0U;
    uint8 limitReason = 0U;

    /* CAN Rx read: 실패 시 초기값 유지 */
    ret = Rte_Read_Project_VCURegenStatus_RegenEnable(&regenEnable);
    if (ret != E_OK)
    {
        regenEnable = FALSE;
    }

    ret = Rte_Read_Project_VCURegenStatus_RegenLevel(&regenLevel);
    if (ret != E_OK)
    {
        regenLevel = 0U;
    }

    ret = Rte_Read_Project_VCURegenStatus_LimitReason(&limitReason);
    if (ret != E_OK)
    {
        limitReason = 0U;
    }

    /* 내부 SWC 전달 */
    ret = Rte_Write_P_VcuToDrv_RegenEnable(regenEnable);
    if (ret != E_OK)
    {
        /* TODO: error handling */
    }

    ret = Rte_Write_P_VcuToDrv_RegenLevel(regenLevel);
    if (ret != E_OK)
    {
        /* TODO: error handling */
    }

    ret = Rte_Write_P_VcuToDrv_LimitReason(limitReason);
    if (ret != E_OK)
    {
        /* TODO: error handling */
    }
}

#define SWC_CanCom_STOP_SEC_CODE
#include "SWC_CanCom_MemMap.h"
