#include "Rte_SWC_CanCom.h"

#define SWC_CanCom_START_SEC_CODE
#include "SWC_CanCom_MemMap.h"

FUNC(void, SWC_CanCom_CODE) CanCom_Tx_func(void)
{
    Std_ReturnType ret1, ret2, ret3, ret4, ret5, ret6, ret7, ret8, ret9, ret10 ,ret11;

    boolean brakeSw = FALSE;
    boolean accelSw = FALSE;
    boolean driverInputFault = FALSE;
    uint8 socLevel = 0U;
    uint8 vehicleSpeed = 0U;
    uint8 aliveCounter = 0U;

    /* DriverInputValidatedData 수신 */
    ret1 = Rte_Read_R_DriverInputValidatedData_BrakeSw(&brakeSw);

    ret2 = Rte_Read_R_DriverInputValidatedData_AccelSw(&accelSw);

    ret3 = Rte_Read_R_DriverInputValidatedData_DriverInputFault(&driverInputFault);

    ret4 = Rte_Read_R_DriverInputValidatedData_SocLevel(&socLevel);

    ret5 = Rte_Read_R_DriverInputValidatedData_VehicleSpeed(&vehicleSpeed);

    /* Alive counter 관리 */
    aliveCounter++;
    aliveCounter &= 0x0FU;

    /* CAN Tx용 데이터 publish */
    ret6 = Rte_Write_Project_DriverStatus_BrakeSw(brakeSw);

    ret7 = Rte_Write_Project_DriverStatus_AccelSw(accelSw);

    ret8 = Rte_Write_Project_DriverStatus_SocLevel(socLevel);

    ret9 = Rte_Write_Project_DriverStatus_DriverInputFault((uint8)driverInputFault);

    ret10 = Rte_Write_Project_DriverStatus_AliveCounter(aliveCounter);

    ret11 = Rte_Write_Project_DriverStatus_VehicleSpeed(vehicleSpeed);

    if (ret1!=E_OK || ret2!=E_OK || ret3!=E_OK || ret4!=E_OK || ret5!=E_OK || ret6!=E_OK || ret7!=E_OK || ret8!=E_OK || ret9!=E_OK || ret10!=E_OK || ret11!=E_OK) {

    }
}

FUNC(void, SWC_CanCom_CODE) CanCom_Rx_func(void)
{
    Std_ReturnType ret1, ret2, ret3, ret4, ret5, ret6;

    boolean regenEnable = FALSE;
    uint8 regenLevel = 0U;
    uint8 limitReason = 0U;

    /* CAN Rx 데이터 read */
    ret1 = Rte_Read_Project_VCURegenStatus_RegenEnable(&regenEnable);
    (void)ret1;

    ret2 = Rte_Read_Project_VCURegenStatus_RegenLevel(&regenLevel);
    (void)ret2;

    ret3 = Rte_Read_Project_VCURegenStatus_LimitReason(&limitReason);
    (void)ret3;

    /* 다른 SWC로 전달 */
    ret4 = Rte_Write_P_VcuToDrv_RegenEnable(regenEnable);
    (void)ret4;

    ret5 = Rte_Write_P_VcuToDrv_RegenLevel(regenLevel);
    (void)ret5;

    ret6 = Rte_Write_P_VcuToDrv_LimitReason(limitReason);
    (void)ret6;
}

#define SWC_CanCom_STOP_SEC_CODE
#include "SWC_CanCom_MemMap.h"
