                <v:ctr name="McuPeripheralClkSet_2" type="IDENTIFIABLE">
                  <a:a name="LABEL" value="Mcu Peripheral Clk Set 2" />
                  <a:a name="TAB" value="McuPeripheralClkSet" />
                  <a:a name="DESC">
                    <a:v>
                      <![CDATA[EN:
                      <html>
