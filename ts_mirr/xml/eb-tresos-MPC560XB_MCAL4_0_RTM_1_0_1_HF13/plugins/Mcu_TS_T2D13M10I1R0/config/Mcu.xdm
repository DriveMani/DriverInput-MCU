                 <v:ctr name="McuClkMonitor" type="IDENTIFIABLE">
                  <a:a name="LABEL" value="Mcu Clock Monitor" />
                  <a:a name="DESC">
                    <a:v>
                      <![CDATA[EN:
                      <html>
                        <p>
                          This container contains the SPECIFIC configuration (parameters) of the  <b>Monitor 0 </b>.
                        </p>
                      </html>
                      ]]>
                    </a:v>
                  </a:a>
                  <a:a name="TAB" value="McuClkMonitor" />
                  <a:a name="UUID" value="ECUC:c2771756-3206-77de-9d39-402621f3274c" />
                  <v:var name="McuFmPllMonitor" type="BOOLEAN">
                    <a:a name="DESC">
                      <a:v>
                        <![CDATA[EN:
                        <html>
                          <p>
                            Enable/Disable the monitor on PLL.
                          </p>
                        </html>
                        ]]>
                      </a:v>
                    </a:a>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v class="PreCompile">VariantPreCompile</icc:v>
                      <icc:v class="PostBuild">VariantPostBuild</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="Freescale" />
                    <a:a name="LABEL" value="Pll Monitor" />
                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                    <a:a name="UUID" value="ECUC:d43053fb-fcc9-4172-97d1-777771cf94fb" />
                    <a:da name="DEFAULT" value="false" />
                    <a:da name="INVALID" type="XPath">
                       <a:tst expr="((. = 'true') and (../../GeneralClockSettings/McuPLLStatus='false'))" true="The PLL should be enabled." />
                    </a:da>
                  </v:var>

                  <v:var name="McuRCOSCSelection" type="ENUMERATION">
                    <a:a name="DESC">
                      <a:v>
                        <![CDATA[EN:
                        <html>
                          <p>
                            This parameter specifies the RC oscillator selection
                          </p>
                        </html>
                        ]]>
                      </a:v>
                    </a:a>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v class="PreCompile">VariantPreCompile</icc:v>
                      <icc:v class="PostBuild">VariantPostBuild</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="Freescale" />
                    <a:a name="LABEL" value="Mcu RCOSC Selection" />
                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                    <a:a name="UUID" value="ECUC:d43053fb-fcc9-4777-97d1-6e5d21cf94fb" />
                    <a:da name="DEFAULT" value="CK_IRCfast" />
                    <a:a name="ENABLE" value="true" />
                    <a:da name="RANGE" type="XPath" expr="ecu:list('MCU.McuRCOSCSelection.List')" />
                  </v:var>

                  <v:var name="McuRCDivisorFactor" type="FLOAT">
                    <a:a name="DESC">
                      <a:v>
                        <![CDATA[EN:
                        <html>
                          <p>
                            This value should build the following value  <b>x=16000000/(2^RC) </b>. So, the monitor detect if the freq of external quartz is smaller than x..
                          </p>
                        </html>
                        ]]>
                      </a:v>
                    </a:a>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v class="PreCompile">VariantPreCompile</icc:v>
                      <icc:v class="PostBuild">VariantPostBuild</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="Freescale" />
                    <a:a name="LABEL" value="RC Divisor Factor" />
                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                    <a:a name="UUID" value="ECUC:d43053fb-fcc9-4777-9331-6e5d21cf94fb" />
                    <a:da name="DEFAULT" value="3" />
                    <a:a name="ENABLE" value="true" />
                    <a:da name="INVALID" type="Range">
                      <a:tst expr="&lt;=3" />
                      <a:tst expr="&gt;=0" />
                    </a:da>
                  </v:var>
                  <v:var name="McuHighFrequencyRef" type="FLOAT">
                    <a:a name="DESC">
                      <a:v>
                        <![CDATA[EN:
                        <html>
                          <p>
                            The value of the Max Frequency. So, the monitor detect if the PLL_0 frequency is greater than McuHighFrequencyRef frequency value.
                          </p>
                        </html>
                        ]]>
                      </a:v>
                    </a:a>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v class="PreCompile">VariantPreCompile</icc:v>
                      <icc:v class="PostBuild">VariantPostBuild</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="Freescale" />
                    <a:a name="UUID" value="ECUC:d43053fb-fcc9-4777-97d1-6e5d21dd94fb" />
                    <a:a name="LABEL" value="HIGH Frequency Reference" />
                    <a:da name="DEFAULT" value="90000000" />
                    <a:a name="RANGE" type="XPath">
                      <a:tst expr=". &lt;=../../McuPll_0/McuPll0_Parameter/PLL_0_Frequency" true="High frequency must be greater than PLL out frequency" />
                    </a:a>
                    <a:a name="INVALID" type="Range">
                      <a:tst expr="&lt;=1024000000" />
                      <a:tst expr="&gt;=0" />
                    </a:a>
                    <a:a name="EDITABLE" type="XPath">
                        <a:tst expr="../McuFmPllMonitor='true'"/>
                    </a:a>
                  </v:var>
                  <v:var name="McuLowFrequencyRef" type="INTEGER">
                    <a:a name="DESC">
                      <a:v>
                        <![CDATA[EN:
                        <html>
                          <p>
                            The value of the Min Frequency. So, the monitor detect if the PLL_0 frequency value is smaller than McuLowFrequencyRef value.
                          </p>
                        </html>
                        ]]>
                      </a:v>
                    </a:a>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v class="PreCompile">VariantPreCompile</icc:v>
                      <icc:v class="PostBuild">VariantPostBuild</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="Freescale" />
                    <a:a name="UUID" value="ECUC:d46053fb-fcc9-4777-97d1-6e5d21dd94fb" />
                    <a:a name="LABEL" value="LOW Frequency Reference" />
                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                    <a:da name="DEFAULT" value="23000000" />
                    <a:a name="RANGE" type="XPath">
                      <a:tst expr=". &gt;=../../McuPll_0/McuPll0_Parameter/PLL_0_Frequency" true="Low frequency must be smaller than PLL out frequency" />
                    </a:a>
                    <a:a name="INVALID" type="Range">
                      <a:tst expr="&lt;=1024000000" />
                      <a:tst expr="&gt;=0" />
                    </a:a>
                    <a:a name="EDITABLE" type="XPath">
                        <a:tst expr="../McuFmPllMonitor='true'"/>
                    </a:a>
                  </v:var>
                </v:ctr>
                <v:ctr name="McuFlashPFCR0" type="IDENTIFIABLE">
                  <a:a name="LABEL" value="Mcu flash PFCR0" />
                  <a:a name="TAB" value="McuFlash" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                  <a:a name="LABEL" value="Mcu Flash PFCR0" />
                  <a:a name="DESC">
                    <a:v>
                      <![CDATA[EN:  <html> <p> This container contains the SPECIFIC configuration (parameters) of the Mcu Flash PFCR0 register. </p>
                      <p>Note: implementation specific parameter.</p>
                    </html> ]]></a:v>
                  </a:a>
                  <a:a name="UUID" value="ECUC:1b152ad2-5629-401b-91a6-09b47df549e0" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                  <v:var name="AddressPipeliningControl" type="INTEGER">
                  <a:a name="LABEL" value="Address Pipelining Control" />
                    <a:a name="DESC">
                      <a:v>
                                <![CDATA[
                                <html>
                                  <p>
                                    Bank0+2 Address Pipelining Control field is used to control the number of cycles between flash array access requests as mentioned below. This field is set to 0b00101 by hardware reset.
                                    The platform flash controller does not support access pipelining since this capability is not supported by the flash array. 
                                    As a result, the APC (Address Pipelining Control) field is typically set to the same value as the RWSC (Read Wait State Control) field for best performance, that is, Bn_APC = Bn_RWSC. 
                                    It cannot be less than the RWSC.
                                  </p>
                         <table>
                         <tbody>
                           <tr>
                             <th>Value </th>
                             <th>Description </th>
                           </tr>
                           <tr>
                             <td>00000</td>
                             <td>Accesses may be initiated on consecutive (back-to-back) cycles</td>
                           </tr>
                           <tr>
                             <td>00001</td>
                             <td>Access requests require one additional hold cycle</td>
                           </tr>
                           <tr>
                             <td>00010</td>
                             <td>Access requests require two additional hold cycles</td>
                           </tr>
                           <tr>
                             <td>....</td>
                             <td>.....</td>
                           </tr>
                           <tr>
                             <td>11110</td>
                             <td>Access requests require 30 additional hold cycles</td>                           
                           </tr>
                           <tr>
                             <td>11111</td>
                             <td>Access requests require 31 additional hold cycles</td>                           
                           </tr>
                         </tbody>
                        </table>
                                  </p>
                                  <p>
                                    Higher operating frequencies require non-zero settings for this field for proper flash operation. This field must be set to a value appropriate to the operating frequency of the PFLASH. Shown below are the maximum operating frequencies for legal APC settings based on estimated low-cost flash access times at 150C.
                                    <table>
                                      <tbody>
                                        <tr>
                                          <th>Operating Frequency</th>
                                          <th>APC value</th>
                                        </tr>
                                        <tr>
                                          <td>Greater than 0 MHz and Less than 20 MHz</td>
                                          <td>0</td>
                                        </tr>
                                        <tr>
                                          <td>Greater than or equal to 20 MHz and Less than 40 MHz</td>
                                          <td>1</td>
                                        </tr>
                                        <tr>
                                          <td>Greater than or equal to 40 MHz and Less than 60 MHz</td>
                                          <td>2</td>
                                        </tr>
                                        <tr>
                                          <td>Greater than or equal to 60 MHz and Less than 80 MHz</td>
                                          <td>3</td>
                                        </tr>
                                        <tr>
                                          <td>Greater than or equal to 80 MHz and Less than 100 MHz</td>
                                          <td>4</td>
                                        </tr>
                                        <tr>
                                          <td>Greater than or equal to 100 MHz and Less than 120 MHz</td>
                                          <td>5</td>
                                        </tr>
                                      </tbody>
                                    </table>
                                  </p>               
                        <p>Warning: APC must be equal to RWSC, else ECC error reporting is disabled.</p>                                  
                        <p>Note: implementation specific parameter.</p>
                      </html> ]]></a:v>
                    </a:a>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd">
                      <icc:v class="PreCompile" xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd">VariantPreCompile</icc:v>
                      <icc:v class="PostBuild" xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd">VariantPostBuild</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="Freescale" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                    <a:a name="SYMBOLICNAMEVALUE" value="false" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                    <a:a name="UUID" value="ECUC:09a7dd73-b834-432e-89d2-14bb481c4e49" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                    <a:da name="DEFAULT" type="XPath">
                      <a:tst expr="(node:fallback(../../McuSystemClockFrequency, 64000000) &gt; 0) and 
                      (node:fallback(../../McuSystemClockFrequency, 64000000) &lt;= 20000000)" true="0" />
                      <a:tst expr="(node:fallback(../../McuSystemClockFrequency, 64000000) &gt; 20000000) and (node:fallback(../../McuSystemClockFrequency, 64000000) &lt;= 40000000)" true="1" />
                      <a:tst expr="(node:fallback(../../McuSystemClockFrequency, 64000000) &gt; 40000000) and (node:fallback(../../McuSystemClockFrequency, 64000000) &lt;= ecu:get('Mcu.McuClockReferencePointFrequency.MaxClockFrequency'))" true="2" />
                    </a:da>
                    <a:a name="INVALID" type="Range">
                      <a:tst expr="&lt;=32" />
                      <a:tst expr="&gt;=0" />
                    </a:a>
                  </v:var>
                  <v:var name="WriteWaitStateControl" type="INTEGER">
                  <a:a name="LABEL" value="Write Wait State Control" />
                    <a:a name="DESC">
                      <a:v>
                        <![CDATA[EN:  <html> <p>Bank0+2 Write Wait State Control. This field is used to control the number of wait-states to be added to the flash array access time for writes. This field must be set to a value appropriate to the operating frequency of the PFLASH. The required settings are documented in the SoC specification. Higher operating frequencies require non-zero settings for this field for proper flash operation. This field is set to an appropriate value by hardware reset. This field is set to 0b00010 by hardware reset. </p>
                         <table>
                         <tbody>
                           <tr>
                             <th>Value </th>
                             <th>Description </th>
                           </tr>
                           <tr>
                             <td>00000</td>
                             <td>No additional wait-states are added</td>
                           </tr>
                           <tr>
                             <td>00001</td>
                             <td>1 additional wait-state is added</td>
                           </tr>
                           <tr>
                             <td>00010</td>
                             <td>2 additional wait-state is added</td>
                           </tr>
                           <tr>
                             <td>....</td>
                             <td>.....</td>
                           </tr>
                           <tr>
                             <td>11111</td>
                             <td>31 additional wait-state is added</td>                           
                           </tr>
                         </tbody>
                        </table>
                        <p>Note: implementation specific parameter.</p>
                      </html> ]]></a:v>
                    </a:a>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd">
                      <icc:v class="PreCompile" xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd">VariantPreCompile</icc:v>
                      <icc:v class="PostBuild" xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd">VariantPostBuild</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="Freescale" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                    <a:a name="SYMBOLICNAMEVALUE" value="false" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                    <a:a name="UUID" value="ECUC:f83429c6-754d-4640-a33c-81c649897c14" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                    <a:da name="DEFAULT" type="XPath">
                      <a:tst expr="(node:fallback(../../McuSystemClockFrequency, 64000000) &gt; 0) and 
                      (node:fallback(../../McuSystemClockFrequency, 64000000) &lt;= 20000000)" true="0" />
                      <a:tst expr="(node:fallback(../../McuSystemClockFrequency, 64000000) &gt; 20000000) and (node:fallback(../../McuSystemClockFrequency, 64000000) &lt;= 40000000)" true="1" />
                      <a:tst expr="(node:fallback(../../McuSystemClockFrequency, 64000000) &gt; 40000000) and (node:fallback(../../McuSystemClockFrequency, 64000000) &lt;= ecu:get('Mcu.McuClockReferencePointFrequency.MaxClockFrequency'))" true="2" />
                    </a:da>
                    <a:a name="INVALID" type="Range">
                      <a:tst expr="&lt;=32" />
                      <a:tst expr="&gt;=0" />
                    </a:a>
                  </v:var>
                  <v:var name="ReadWaitStateControl" type="INTEGER">
                  <a:a name="LABEL" value="Read Wait State Control" />
                    <a:a name="DESC">
                      <a:v>
                        <![CDATA[EN:  <html> 
                        <p> Bank0+2 Read Wait State Control. This field is used to control the number of wait-states to be added to the flash array access time for reads. This field must be set to a value corresponding to the operating frequency of the PFLASH and the actual read access time of the PFLASH. The required settings are documented in the SoC specification. Higher operating frequencies require non-zero settings for this field for proper flash operation.
                          Shown below are the maximum operating frequencies for legal APC and RWSC settings based on estimated low-cost flash access times at 150C. The integrator is bly encouraged to verify these settings based on actual silicon results.
                         <table>
                         <tbody>
                           <tr>
                             <th>Value </th>
                             <th>Description </th>
                           </tr>
                           <tr>
                             <td>00000</td>
                             <td>No additional wait-states are added</td>
                           </tr>
                           <tr>
                             <td>00001</td>
                             <td>1 additional wait-state is added</td>
                           </tr>
                           <tr>
                             <td>00010</td>
                             <td>2 additional wait-state is added</td>
                           </tr>
                           <tr>
                             <td>....</td>
                             <td>.....</td>
                           </tr>
                           <tr>
                             <td>11111</td>
                             <td>31 additional wait-state is added</td>                           
                           </tr>
                         </tbody>
                        </table>
                                  </p>
                                  <p>
                                    Higher operating frequencies require non-zero settings for this field for proper flash operation. This field must be set to a value appropriate to the operating frequency of the PFLASH  and the actual read access time of the PFLASH. Shown below are the maximum operating frequencies for legal RWSC settings based on estimated low-cost flash access times at 150C.
                                    <table>
                                      <tbody>
                                        <tr>
                                          <th>Operating Frequency</th>
                                          <th>RWSC value</th>
                                        </tr>
                                        <tr>
                                          <td>Greater than 0 MHz and Less than 20 MHz</td>
                                          <td>0</td>
                                        </tr>
                                        <tr>
                                          <td>Greater than or equal to 20 MHz and Less than 40 MHz</td>
                                          <td>1</td>
                                        </tr>
                                        <tr>
                                          <td>Greater than or equal to 40 MHz and Less than 60 MHz</td>
                                          <td>2</td>
                                        </tr>
                                        <tr>
                                          <td>Greater than or equal to 60 MHz and Less than 80 MHz</td>
                                          <td>3</td>
                                        </tr>
                                        <tr>
                                          <td>Greater than or equal to 80 MHz and Less than 100 MHz</td>
                                          <td>4</td>
                                        </tr>
                                        <tr>
                                          <td>Greater than or equal to 100 MHz and Less than 120 MHz</td>
                                          <td>5</td>
                                        </tr>
                                      </tbody>
                                    </table>
                                  </p>
                        <p>Warning: APC must be equal to RWSC, else ECC error reporting is disabled.</p>
                        <p>Note: implementation specific parameter.</p>
                      </html> ]]></a:v>
                    </a:a>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd">
                      <icc:v class="PreCompile" xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd">VariantPreCompile</icc:v>
                      <icc:v class="PostBuild" xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd">VariantPostBuild</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="Freescale" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                    <a:a name="SYMBOLICNAMEVALUE" value="false" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                    <a:a name="UUID" value="ECUC:70cc3cac-206f-4fa7-bc48-7ce8de7ec8b0" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                    <a:da name="DEFAULT" type="XPath">
                      <a:tst expr="(node:fallback(../../McuSystemClockFrequency, 64000000) &gt; 0) and 
                      (node:fallback(../../McuSystemClockFrequency, 64000000) &lt;= 20000000)" true="0" />
                      <a:tst expr="(node:fallback(../../McuSystemClockFrequency, 64000000) &gt; 20000000) and (node:fallback(../../McuSystemClockFrequency, 64000000) &lt;= 40000000)" true="1" />
                      <a:tst expr="(node:fallback(../../McuSystemClockFrequency, 64000000) &gt; 40000000) and (node:fallback(../../McuSystemClockFrequency, 64000000) &lt;= ecu:get('Mcu.McuClockReferencePointFrequency.MaxClockFrequency'))" true="2" />
                    </a:da>
                    <a:a name="INVALID" type="Range">
                      <a:tst expr="&lt;=32" />
                      <a:tst expr="&gt;=0" />
                    </a:a>
                  </v:var>
                </v:ctr>


                <v:ctr name="McuFlashPFCR1" type="IDENTIFIABLE">
                  <a:a name="LABEL" value="Mcu flash PFCR1" />
                  <a:a name="TAB" value="McuFlash" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                  <a:a name="LABEL" value="Mcu Flash PFCR1" />
                  <a:a name="DESC">
                    <a:v>
                      <![CDATA[EN:  <html> <p> This container contains the SPECIFIC configuration (parameters) of the Mcu Flash PFCR0 register. </p>
                      <p>Note: implementation specific parameter.</p>
                    </html> ]]></a:v>
                  </a:a>
                  <a:a name="UUID" value="ECUC:1b152ad2-5629-401b-91a6-09b4112f549e0" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                  <v:var name="AddressPipeliningControl" type="INTEGER">
                  <a:a name="LABEL" value="Address Pipelining Control" />
                    <a:a name="DESC">
                      <a:v>
                                <![CDATA[ 
                                <html> 
                                  <p> 
                                    Bank0+2 Address Pipelining Control field is used to control the number of cycles between flash array access requests as mentioned below. This field is set to 0b00101 by hardware reset. 
                                    The platform flash controller does not support access pipelining since this capability is not supported by the flash array. 
                                    As a result, the APC (Address Pipelining Control) field is typically set to the same value as the RWSC (Read Wait State Control) field for best performance, that is, Bn_APC = Bn_RWSC. 
                                    It cannot be less than the RWSC.
                                   </p>
                         <table>
                         <tbody>
                           <tr>
                             <th>Value </th>
                             <th>Description </th>
                           </tr>
                           <tr>
                             <td>00000</td>
                             <td>Accesses may be initiated on consecutive (back-to-back) cycles</td>
                           </tr>
                           <tr>
                             <td>00001</td>
                             <td>Access requests require one additional hold cycle</td>
                           </tr>
                           <tr>
                             <td>00010</td>
                             <td>Access requests require two additional hold cycles</td>
                           </tr>
                           <tr>
                             <td>....</td>
                             <td>.....</td>
                           </tr>
                           <tr>
                             <td>11110</td>
                             <td>Access requests require 30 additional hold cycles</td>                           
                           </tr>
                           <tr>
                             <td>11111</td>
                             <td>Access requests require 31 additional hold cycles</td>                           
                           </tr>
                         </tbody>
                        </table>                       
                        <p>Note: implementation specific parameter.</p>
                      </html> ]]></a:v>
                    </a:a>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd">
                      <icc:v class="PreCompile" xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd">VariantPreCompile</icc:v>
                      <icc:v class="PostBuild" xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd">VariantPostBuild</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="Freescale" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                    <a:a name="SYMBOLICNAMEVALUE" value="false" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                    <a:a name="UUID" value="ECUC:09a7dd73-b834-432e-89d2-1425881c4e49" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                    <a:da name="DEFAULT" type="XPath">
                      <a:tst expr="(node:fallback(../../McuSystemClockFrequency, 64000000) &gt; 0) and 
                      (node:fallback(../../McuSystemClockFrequency, 64000000) &lt;= 20000000)" true="0" />
                      <a:tst expr="(node:fallback(../../McuSystemClockFrequency, 64000000) &gt; 20000000) and (node:fallback(../../McuSystemClockFrequency, 64000000) &lt;= 40000000)" true="1" />
                      <a:tst expr="(node:fallback(../../McuSystemClockFrequency, 64000000) &gt; 40000000) and (node:fallback(../../McuSystemClockFrequency, 64000000) &lt;= ecu:get('Mcu.McuClockReferencePointFrequency.MaxClockFrequency'))" true="2" />
                    </a:da>
                    <a:a name="INVALID" type="Range">
                      <a:tst expr="&lt;=32" />
                      <a:tst expr="&gt;=0" />
                    </a:a>
                  </v:var>
                  <v:var name="WriteWaitStateControl" type="INTEGER">
                  <a:a name="LABEL" value="Write Wait State Control" />
                    <a:a name="DESC">
                      <a:v>
                        <![CDATA[EN:  <html> <p>Bank0+2 Write Wait State Control. This field is used to control the number of wait-states to be added to the flash array access time for writes. This field must be set to a value appropriate to the operating frequency of the PFLASH. The required settings are documented in the SoC specification. Higher operating frequencies require non-zero settings for this field for proper flash operation. This field is set to an appropriate value by hardware reset. This field is set to 0b00010 by hardware reset. </p>
                         <table>
                         <tbody>
                           <tr>
                             <th>Value </th>
                             <th>Description </th>
                           </tr>
                           <tr>
                             <td>00000</td>
                             <td>No additional wait-states are added</td>
                           </tr>
                           <tr>
                             <td>00001</td>
                             <td>1 additional wait-state is added</td>
                           </tr>
                           <tr>
                             <td>00010</td>
                             <td>2 additional wait-state is added</td>
                           </tr>
                           <tr>
                             <td>....</td>
                             <td>.....</td>
                           </tr>
                           <tr>
                             <td>11111</td>
                             <td>31 additional wait-state is added</td>                           
                           </tr>
                         </tbody>
                        </table>
                        <p>Note: implementation specific parameter.</p>
                      </html> ]]></a:v>
                    </a:a>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd">
                      <icc:v class="PreCompile" xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd">VariantPreCompile</icc:v>
                      <icc:v class="PostBuild" xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd">VariantPostBuild</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="Freescale" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                    <a:a name="SYMBOLICNAMEVALUE" value="false" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                    <a:a name="UUID" value="ECUC:f83429c6-559d-4640-a33c-81c649897c14" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                    <a:da name="DEFAULT" type="XPath">
                      <a:tst expr="(node:fallback(../../McuSystemClockFrequency, 64000000) &gt; 0) and 
                      (node:fallback(../../McuSystemClockFrequency, 64000000) &lt;= 20000000)" true="0" />
                      <a:tst expr="(node:fallback(../../McuSystemClockFrequency, 64000000) &gt; 20000000) and (node:fallback(../../McuSystemClockFrequency, 64000000) &lt;= 40000000)" true="1" />
                      <a:tst expr="(node:fallback(../../McuSystemClockFrequency, 64000000) &gt; 40000000) and (node:fallback(../../McuSystemClockFrequency, 64000000) &lt;= ecu:get('Mcu.McuClockReferencePointFrequency.MaxClockFrequency'))" true="2" />
                    </a:da>
                    <a:a name="INVALID" type="Range">
                      <a:tst expr="&lt;=32" />
                      <a:tst expr="&gt;=0" />
                    </a:a>
                  </v:var>
                  <v:var name="ReadWaitStateControl" type="INTEGER">
                  <a:a name="LABEL" value="Read Wait State Control" />
                    <a:a name="DESC">
                      <a:v>
                        <![CDATA[EN:  <html> 
                         <p> Bank0+2 Read Wait State Control. This field is used to control the number of wait-states to be added to the flash array access time for reads. This field must be set to a value corresponding to the operating frequency of the PFLASH and the actual read access time of the PFLASH. The required settings are documented in the SoC specification. Higher operating frequencies require non-zero settings for this field for proper flash operation.
                          Shown below are the maximum operating frequencies for legal APC and RWSC settings based on estimated low-cost flash access times at 150C. The integrator is bly encouraged to verify these settings based on actual silicon results.
                         <table>
                         <tbody>
                           <tr>
                             <th>Value </th>
                             <th>Description </th>
                           </tr>
                           <tr>
                             <td>00000</td>
                             <td>No additional wait-states are added</td>
                           </tr>
                           <tr>
                             <td>00001</td>
                             <td>1 additional wait-state is added</td>
                           </tr>
                           <tr>
                             <td>00010</td>
                             <td>2 additional wait-state is added</td>
                           </tr>
                           <tr>
                             <td>....</td>
                             <td>.....</td>
                           </tr>
                           <tr>
                             <td>11111</td>
                             <td>31 additional wait-state is added</td>                           
                           </tr>
                         </tbody>
                        </table>
                         </p>
                         <p> 
                                    Higher operating frequencies require non-zero settings for this field for proper flash operation. This field must be set to a value appropriate to the operating frequency of the PFLASH. Shown below are the maximum operating frequencies for legal APC settings based on estimated low-cost flash access times at 150C. 
                                    <table> 
                                      <tbody> 
                                        <tr> 
                                          <th>Operating Frequency</th> 
                                          <th>APC value</th> 
                                        </tr> 
                                        <tr> 
                                          <td>Greater than 0 MHz and Less than 20 MHz</td> 
                                          <td>0</td> 
                                        </tr> 
                                        <tr> 
                                          <td>Greater than or equal to 20 MHz and Less than 40 MHz</td> 
                                          <td>1</td> 
                                        </tr> 
                                        <tr> 
                                          <td>Greater than or equal to 40 MHz and Less than 60 MHz</td> 
                                          <td>2</td> 
                                        </tr> 
                                        <tr> 
                                          <td>Greater than or equal to 60 MHz and Less than 80 MHz</td> 
                                          <td>3</td> 
                                        </tr> 
                                        <tr> 
                                          <td>Greater than or equal to 80 MHz and Less than 100 MHz</td> 
                                          <td>4</td> 
                                        </tr> 
                                        <tr> 
                                          <td>Greater than or equal to 100 MHz and Less than 120 MHz</td> 
                                          <td>5</td> 
                                        </tr> 
                                      </tbody> 
                                    </table> 
                                  </p> 
                        <p>Note: implementation specific parameter.</p>
                      </html> ]]></a:v>
                    </a:a>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd">
                      <icc:v class="PreCompile" xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd">VariantPreCompile</icc:v>
                      <icc:v class="PostBuild" xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd">VariantPostBuild</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="Freescale" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                    <a:a name="SYMBOLICNAMEVALUE" value="false" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                    <a:a name="UUID" value="ECUC:70cccbac-206f-4fa7-bc48-7ce8de7ec8b0" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                    <a:da name="DEFAULT" type="XPath">
                      <a:tst expr="(node:fallback(../../McuSystemClockFrequency, 64000000) &gt; 0) and 
                      (node:fallback(../../McuSystemClockFrequency, 64000000) &lt;= 20000000)" true="0" />
                      <a:tst expr="(node:fallback(../../McuSystemClockFrequency, 64000000) &gt; 20000000) and (node:fallback(../../McuSystemClockFrequency, 64000000) &lt;= 40000000)" true="1" />
                      <a:tst expr="(node:fallback(../../McuSystemClockFrequency, 64000000) &gt; 40000000) and (node:fallback(../../McuSystemClockFrequency, 64000000) &lt;= ecu:get('Mcu.McuClockReferencePointFrequency.MaxClockFrequency'))" true="2" />
                    </a:da>
                    <a:a name="INVALID" type="Range">
                      <a:tst expr="&lt;=32" />
                      <a:tst expr="&gt;=0" />
                    </a:a>
                  </v:var>
                </v:ctr>
                </v:ctr>
                  </v:lst>
                      <!-- /** @requirements MCU187_Conf */ -->
                      <!-- @implements DMCU01016  -->
                    <v:ctr name="McuDemEventParameterRefs" type="IDENTIFIABLE">
                    <a:a name="LABEL" value="Mcu Dem Event Parameter Refs" />
                    <a:a name="DESC">
                      <a:v>
                        <![CDATA[EN:
                        <html>
                          <p>
                             Container for the references to DemEventParameter elements which shall be invoked using the API Dem_ReportErrorStatus API in case the corresponding error occurs. The EventId is taken from the referenced DemEventParameter&apos;s DemEventId value. The standardized errors are provided in the container and can be extended by vendor specific error references.
                          </p>
                        </html>
                        ]]>
                      </a:v>
                    </a:a>
                      <a:a name="OPTIONAL" value="false"/>
                      <a:da name="ENABLE" value="true"/>
                      <a:a name="UUID"
                           value="ECUC:d10b9ced-78c1-4b42-a675-ea6d477ef52f"/>
                        <!-- /** @requirements MCU188_Conf */ -->
                        <!-- @implements DMCU01017  -->
                        <v:ref name="MCU_E_CLOCK_FAILURE"
                               type="SYMBOLIC-NAME-REFERENCE">
                          <a:a name="LABEL" value="MCU E_CLOCK FAILURE" />
                            <a:a name="DESC">
                              <a:v>
                                <![CDATA[EN:
                                <html>
                                  <p>
                                     Reference to configured DEM event to report &quot;Clock source failure&quot;.
                                  </p>
                                </html>
                                ]]>
                              </a:v>
                               </a:a>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS"
                               type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v class="PreCompile">VariantPostBuild</icc:v>
                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                          </a:a>
                          <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                          <a:a name="UUID"
                               value="ECUC:8ce16873-adbc-437a-a3cb-1f3fcc49eb63"/>
                          <a:a name="OPTIONAL" value="false"/>
                          <a:da name="ENABLE" value="true"/>
                          <a:da name="REF" value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Dem/DemConfigSet/DemEventParameter"/>
                        </v:ref>
                        <v:ref name="MCU_E_TIMEOUT_TRANSITION"
                               type="SYMBOLIC-NAME-REFERENCE">
                          <a:a name="LABEL" value="MCU E_TIMEOUT TRANSITION" />
                            <a:a name="DESC">
                              <a:v>
                                <![CDATA[EN:
                                <html>
                                  <p>
                                     Reference to configured DEM event to report &quot;Timeout expired&quot;.
                                  </p>
                                </html>
                                ]]>
                              </a:v>
                               </a:a>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS"
                               type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v class="PreCompile">VariantPostBuild</icc:v>
                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                          </a:a>
                          <a:a name="ORIGIN" value="Freescale"/>
                          <a:a name="UUID"
                               value="ECUC:8ce16873-adbc-43aa-a3cb-1f3fcc49eb63"/>
                          <a:a name="OPTIONAL" value="false"/>
                          <a:da name="ENABLE" value="true"/>
                          <a:da name="REF" value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Dem/DemConfigSet/DemEventParameter"/>
                        </v:ref>
                        <v:ref name="MCU_E_QUARTZ_FAILURE"
                               type="SYMBOLIC-NAME-REFERENCE">
                          <a:a name="LABEL" value="MCU E_QUARTZ FAILURE" />
                            <a:a name="DESC">
                              <a:v>
                                <![CDATA[EN:
                                <html>
                                  <p>
                                     Reference to configured DEM event to report &quot;Oscillator frequency lower than RC
frequency event.&quot;.
                                  </p>
                                </html>
                                ]]>
                              </a:v>
                               </a:a>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS"
                               type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v class="PreCompile">VariantPostBuild</icc:v>
                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                          </a:a>
                          <a:a name="ORIGIN" value="Freescale"/>
                          <a:a name="UUID"
                               value="ECUC:8ce16873-bdbc-43aa-a3cb-1f3fcc49eb63"/>
                          <a:a name="OPTIONAL" value="false"/>
                          <a:da name="ENABLE" value="true"/>
                          <a:da name="REF" value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Dem/DemConfigSet/DemEventParameter"/>
                        </v:ref>
                        <v:ref name="MCU_E_LOCK_FAILURE"
                               type="SYMBOLIC-NAME-REFERENCE">
                          <a:a name="LABEL" value="MCU E_LOCK_FAILURE" />
                            <a:a name="DESC">
                              <a:v>
                                <![CDATA[EN:
                                <html>
                                  <p>
                                     Reference to configured DEM event to report &quot;PLL loss the lock.&quot;.
                                  </p>
                                </html>
                                ]]>
                              </a:v>
                               </a:a>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS"
                               type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v class="PreCompile">VariantPostBuild</icc:v>
                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                          </a:a>
                          <a:a name="ORIGIN" value="Freescale"/>
                          <a:a name="UUID"
                               value="ECUC:8ce16873-adbc-43aa-a3cc-1f3fcc49eb63"/>
                          <a:a name="OPTIONAL" value="false"/>
                          <a:da name="ENABLE" value="true"/>
                          <a:da name="REF" value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Dem/DemConfigSet/DemEventParameter"/>
                        </v:ref>
                    </v:ctr>
                  <v:lst name="McuModeSettingConf" type="MAP">
                    <a:da name="MIN" value="1"/>
                    <!-- /** @requirements MCU123_Conf */ -->
                    <!-- @implements DMCU01018  -->
                    <v:ctr name="McuModeSettingConf" type="IDENTIFIABLE">
                    <a:a name="LABEL" value="Mcu Mode Setting Configuration" />
                    <a:a name="DESC">
                       <a:v><![CDATA[EN:
                         <html> <p>
                         This container contains the configuration (parameters) for the Mode setting of the MCU.
                         Please see MCU035 for more information on the MCU mode settings.</p>
                         </html>
                        ]]></a:v>
                       </a:a>
                      <a:a name="UUID"  value="ECUC:72412a9f-448a-441f-955c-7d8f51a3ebc2"/>
                      <!-- /** @requirements MCU176_Conf */ -->
                      <!-- @implements DMCU01019  -->
                      <v:var name="McuMode" type="INTEGER">
                      <a:a name="LABEL" value="Mcu Mode" />
                      <a:a name="DESC">
                        <a:v><![CDATA[EN:
                        <html> <p>
                          This parameter shall represent the number of MCU modes available for the MCU.</p>
                          </html>
                          ]]></a:v>
                        </a:a>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v class="PostBuild">VariantPostBuild</icc:v>
                          <icc:v class="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="true"/>
                        <a:a name="UUID" value="ECUC:e989e68f-cef3-469d-bd08-a81936898d46"/>
                        <a:da name="DEFAULT" type="XPath" expr="num:i((node:fallback((node:current()/../@index),1))+1)"/>
                        <a:da name="INVALID" type="Range">
                          <a:tst expr="&lt;=255"/>
                          <a:tst expr="&gt;=1"/>
                        </a:da>
                        <a:da name="RANGE" type="XPath">
                          <a:tst expr="text:uniq(node:fallback(../../*/McuMode, text:split('1 2 3')), node:fallback(., 1))" false="Duplicated value, McuMode must be unique across McuModeSettingConf. Use the Calc button to calculate correct default value."/>
                          <a:tst expr="node:fallback(., 1) &lt; num:i(count(node:fallback(../../*, 1))+1)" false="Value out of range: must be in range 1 to 255. Use the Calc button to calculate correct default value."/>
                        </a:da>
                      </v:var>
                        <v:var name="McuOperatingMode" type="ENUMERATION">
                          <a:a name="DESC">
                            <a:v>
                              <![CDATA[EN:
                              <html>
                                <p>
                                This parameter selects the Low Power Mode used for the current configuration channel.</p>
                                <p>Note: This parameter is not used by the current Implementation</p>
                              </html>
                              ]]>
                            </a:v>
                          </a:a>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                            <icc:v class="PostBuild">VariantPostBuild</icc:v>
                          </a:a>
                          <a:a name="ORIGIN" value="Freescale" />
                          <a:a name="SYMBOLICNAMEVALUE" value="false" />
                          <a:a name="UUID" value="ECUC:13048299-7703-4a01-9e35-843ffa467772" />
                          <a:da name="DEFAULT" value="HALT" />
                          <a:da name="RANGE">
                            <a:v>RUN3</a:v>
                            <a:v>RUN2</a:v>
                            <a:v>RUN1</a:v>
                            <a:v>RUN0</a:v>
                            <a:v>DRUN</a:v>
                            <a:v>SAFE</a:v>
                            <a:v>HALT</a:v>
                            <a:v>STOP</a:v>
                            <a:v>STANDBY</a:v>
                          </a:da>
                          <a:da name="INVALID" type="XPath">
                            <a:tst expr="((node:value(../../../McuEnableMode/McuModeHalt) = 'false') and (. = 'HALT')) or ((node:value(../../../McuEnableMode/McuModeStop) = 'false') and (. = 'STOP'))" true="The selected mode has not been enabled." />
                          </a:da>
                          <a:a name="LABEL" value="Operating Mode"/>
                        </v:var>
                        <v:ref name="LowPowerClockSettingConfig" type="REFERENCE">
                          <a:a name="LABEL" value="Low Power Clock Setting Configuration" />
                          <a:a name="DESC">
                            <a:v>
                              <![CDATA[EN:
                              <html>
                                <p>
                                  This parameter is used to select the Clock setting for Low power mode of the MCU.
                                  When a clock setting is configured, the parameters in the specified McuClockSettingConfig container
                                  will  be used to configure the system clock before entering the low power mode.
                                  The parameters  that will not be used from the McuClockSettingConfig contianer are GeneralClockSettings/McuStartRunMode.
                                The parameters  in the container McuPLL will be used only when the McuOperatingMode parameter is configured as'HALT'.</p>
                                <p>Note: Implementation specific Parameter.</p>
                              </html>
                              ]]>
                            </a:v>
                          </a:a>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                            <icc:v class="PostBuild">VariantPostBuild</icc:v>
                          </a:a>
                          <a:a name="ORIGIN" value="Freescale" />
                          <a:a name="UUID" value="ECUC:29255a9f-4bc6-41e6-80ea-9ff9ea88125e" />
                          <a:da name="REF" value="ASPathDataOfSchema:/AUTOSAR/EcucDefs/Mcu/McuModuleConfiguration/McuClockSettingConfig" />
                        </v:ref>

                        <v:var name="McuVoltageRegulator" type="BOOLEAN">
                          <a:a name="LABEL" value="Mcu Voltage Regulator" />
                          <a:a name="DESC">
                            <a:v>
                              <![CDATA[EN:  <html>
                              <p> Main Voltage Regulator in ON or OFF state.</p>
                              <p>Note: implementation specific parameter.</p>
                            </html> ]]></a:v>
                          </a:a>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                            <icc:v class="PreCompile">VariantPostBuild</icc:v>
                          </a:a>
                          <a:a name="ORIGIN" value="Freescale"/>
                          <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                          <a:a name="UUID" value="ECUC:2979eaaa-265f-4800-b109-8f763a02ee9d"/>
                      <a:a name="ENABLE" value="true" />
                      <a:da name="INVALID" type="XPath">
                          <a:tst expr="((node:fallback(../McuOperatingMode,'DRUN') !='STOP') and (node:fallback(../McuOperatingMode,'DRUN') != 'STANDBY') and (node:fallback(../McuOperatingMode,'DRUN') != 'HALT')) and (.='false')" true="The voltage regulator can be turned off only in STOP and HALT mode." />
                          <a:tst expr="(node:fallback(../McuOperatingMode,'DRUN') ='STANDBY') and (.='true')" true="The voltage regulator is always turned off in STANDBY mode." />
                       </a:da>
                          <a:da name="DEFAULT" value="true"/>
                        </v:var>

                        <v:var name="McuBootMode" type="BOOLEAN">
                          <a:a name="LABEL" value="Mcu Boot Mode" />
                          <a:a name="DESC">
                            <a:v>
                              <![CDATA[EN:  <html>
                              <p> Specifies if the system will boot from backup RAM or flash out of STANDBY exit.</p>
                         <table>
                         <tbody>
                           <tr>
                             <th>Value </th>
                             <th>Description </th>
                           </tr>
                           <tr>
                             <td>0</td>
                             <td>Boot from flash on STANDBY exit</td>
                           </tr>
                           <tr>
                             <td>1</td>
                             <td>Boot from backup RAM on STANDBY exit</td>
                           </tr>
                         </tbody>
                        </table>
                              <p>Note: implementation specific parameter.</p>
                            </html> ]]></a:v>
                          </a:a>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                            <icc:v class="PreCompile">VariantPostBuild</icc:v>
                          </a:a>
                          <a:a name="ORIGIN" value="Freescale"/>
                          <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                          <a:a name="UUID" value="ECUC:2979ecda-265f-4800-b109-8f763a02ee9d"/>
                      <a:a name="ENABLE" value="true" />
                      <a:da name="INVALID" type="XPath">
                          <a:tst expr="(node:fallback(../McuOperatingMode,'DRUN') !='STANDBY') and (.='true')" true="The option specifies the behaviour of the system only on the exit from the StandBy mode otherwise it should be disabled." />
                       </a:da>
                          <a:da name="DEFAULT" value="false"/>
                        </v:var>
                      <v:var name="McuOutputPowerDownControl" type="BOOLEAN">
                          <a:a name="DESC">
                          <a:v><![CDATA[EN:
                            <html>
                            <p>Output power-down status:This bit controls the output power-down of I/Os. </p>
                            <p>This parameter is configurable only when McuStartRunMode is configured as SAFE/TEST/ STOP0 mode.</p>
                            <p>Disabled - No automatic safe gating of I/Os used and pads power sequence driver is enabled.</p>
                            <p>Enabled - In SAFE/TEST modes, outputs of pads are forced to high impedance state and pads power sequence driver is disabled. The inputs are level unchanged.
                            In STOP0 mode, only the pad power sequence driver is disabled, but the state of the output remains functional.
                            </p>
                            <p> Note: Implementation specific Parameter .</p>
                            </html>
                          ]]></a:v>
                          </a:a>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                  <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                  <icc:v class="PostBuild">VariantPostBuild</icc:v>
                          </a:a>
                          <a:a name="ORIGIN" value="Freescale" />
                          <a:a name="SYMBOLICNAMEVALUE" value="false" />
                          <a:a name="LABEL" value="Output Power Down Control" />
                          <a:a name="UUID" value="ECUC:d0b4e47d-ce4e-4dac-aeda-c71c9ccd7b7c" />
                          <a:da name="DEFAULT" value="false" />
                          <a:da name="INVALID" type="XPath">
                            <a:tst expr="(.='true') and ((../McuOperatingMode!='SAFE') and (../McuOperatingMode!='STOP'))" true="This parameter can be enabled only when the McuOperatingMode is configured as STOP' mode or SAFE." />
                          </a:da>
                       </v:var>
                        <v:var name="McuFastTransition" type="BOOLEAN">
                          <a:a name="LABEL" value="Mcu Fast Transition" />
                          <a:a name="DESC">
                            <a:v>
                              <![CDATA[EN:  <html>
                              <p> TRUE:Perform transition to low power mode without modifying clock settings in the target low power mode (in this case LowPowerClockSettingConfig is ignored).</p>
                              <p>Note: implementation specific parameter.</p>
                            </html> ]]></a:v>
                          </a:a>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                            <icc:v class="PreCompile">VariantPostBuild</icc:v>
                          </a:a>
                          <a:a name="ORIGIN" value="Freescale"/>
                          <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                          <a:a name="UUID" value="ECUC:2979eaaa-265f-4434-b109-8f763a02ee9d"/>
                      <a:a name="ENABLE" value="true" />
                      <a:da name="INVALID" type="XPath">
                          <a:tst expr="((node:fallback(../McuOperatingMode,'DRUN') !='HALT') and (node:fallback(../McuOperatingMode,'DRUN') !='STOP')) and ((node:fallback(../McuOperatingMode,'DRUN') !='STANDBY') and (.='false'))" true="The option should be enabled in any RUN mode." />
                       </a:da>
                          <a:da name="DEFAULT" value="false"/>
                        </v:var>
                        <v:var name="McuAuxiliaryClockSettings" type="BOOLEAN">
                          <a:a name="LABEL" value="Mcu Auxiliary Clock Settings" />
                          <a:a name="DESC">
                            <a:v>
                              <![CDATA[EN:  <html>
                              <p> TRUE: Clock settings applied after an exit from this low power mode are configured by the driver.</p>
                              <p>FALSE: Global Flash Settings including latency timings are not configured by the driver.</p>
                              <p>Note: implementation specific parameter.</p>
                            </html> ]]></a:v>
                          </a:a>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                            <icc:v class="PreCompile">VariantPostBuild</icc:v>
                          </a:a>
                          <a:a name="ORIGIN" value="Freescale"/>
                          <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                          <a:a name="UUID" value="ECUC:2979eaaa-265f-4800-b829-8f763a02ee9d"/>
                          <a:da name="DEFAULT" value="true"/>
                      <a:a name="ENABLE" value="true" />
                      <a:da name="INVALID" type="XPath">
                          <a:tst expr="((node:fallback(../McuOperatingMode,'DRUN') !='HALT') and (node:fallback(../McuOperatingMode,'DRUN') !='STOP')) and (.='true')" true="The option can be enabled only into the low power modes otherwise it should be set to false." />
                       </a:da>
                        </v:var>
                        <v:ctr name="GeneralClockSettings" type="IDENTIFIABLE">
                          <a:a name="LABEL" value="General Clock Settings" />
                          <a:a name="DESC">
                            <a:v>
                              <![CDATA[EN:  <html>  <p> This container contains the clock settings used after an exit from a low power mode.
                              </p>
                              <p>Note: Implementation specific Container.
                              </p>
                            </html> ]]></a:v>
                          </a:a>
                          <a:a name="UUID" value="ECUC:1af21ea9-d5a7-47b7-af00-e735dcfb0022"/>
                          <a:da name="ENABLE" type="XPath">
                            <a:tst expr="((../McuOperatingMode ='HALT' or ../McuOperatingMode ='STOP') and ../McuAuxiliaryClockSettings = 'true')"/>
                          </a:da>
                          <v:var name="McuOSC" type="BOOLEAN">
                            <a:a name="LABEL" value="Mcu OSC" />
                            <a:a name="DESC">
                              <a:v>
                              <![CDATA[EN:  
                              <html>  
                              <p>External Oscillator in ON or OFF state. </p>
                              <p>Note: Implementation specific Parameter.</p> 
                              </html> ]]>
                            </a:v>
                          </a:a>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                            <icc:v class="PostBuild">VariantPostBuild</icc:v>
                          </a:a>
                          <a:a name="ORIGIN" value="Freescale"/>
                          <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                          <a:a name="UUID" value="ECUC:5b8fb111-4e9f-49e9-acf7-1132fb827cfd"/>
                          <a:a name="DEFAULT" value="true"/>
                          <a:da name="INVALID" type="XPath">
                            <a:tst expr="((../../../../../McuClockSettingConfig/McuRCCalibration='true' and .='false'))" true="XOSC has to be selected" />
                          </a:da>
                        </v:var>
                        <v:var name="McuPLLStatus" type="BOOLEAN">
                          <a:a name="LABEL" value="Mcu PLL Status" />
                          <a:a name="DESC">
                            <a:v>
                            <![CDATA[EN:  <html>  <p>Put the PLL0 in ON or OFF state. </p><p>Note: Implementation specific Parameter.</p> </html> ]]>
                          </a:v>
                        </a:a>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v class="PreCompile">VariantPreCompile</icc:v>
                          <icc:v class="PostBuild">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="Freescale"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" value="ECUC:9f0dcacc-dc82-42d2-8d12-71d7e73caaa9"/>
                        <a:da name="DEFAULT" value="true"/>
                        <a:da name="ENABLE" value="true"/>
                        <a:da name="INVALID" type="XPath">
                            <a:tst expr="(((../SystemClockSelect = 'McuPLL') and (.='false')) or ((../McuFXOSC = 'false') and (. = 'true')))" true="McuFXOSC has to be selected. Also McuPLLStatus has to be selected when the SystemClockSelect is configured as McuPLL."/>
                        </a:da>
                        </v:var>
                        <v:var name="McuCodeFlashStatus" type="ENUMERATION">
                          <a:a name="LABEL" value="Mcu Code Flash Status" />
                          <a:a name="DESC">
                            <a:v>
                              <![CDATA[EN:
                              <html>
                                <p> Select  the Code Flash Status in new operative Mode. </p>
                                <p>Note:  Implementation specific Parameter.</p>
                              </html> ]]></a:v>
                            </a:a>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v class="PreCompile">VariantPreCompile</icc:v>
                              <icc:v class="PostBuild">VariantPostBuild</icc:v>
                            </a:a>
                            <a:a name="ORIGIN" value="Freescale"/>
                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                            <a:a name="UUID" value="ECUC:1649c6c4-e73e-4f34-9210-5000cf975077"/>
                            <a:da name="DEFAULT" value="NormalMode"/>
                            <a:da name="RANGE">
                              <a:v>PowerDown</a:v>
                              <a:v>LowPower</a:v>
                              <a:v>NormalMode</a:v>
                            </a:da>
                          </v:var>
                          <v:var name="McuDataFlashStatus" type="ENUMERATION">
                            <a:a name="LABEL" value="Mcu Data Flash Status" />
                            <a:a name="DESC">
                              <a:v>
                                <![CDATA[EN:  <html>  <p> Select the Data Flash Status in new operative Mode. </p>
                                <p>Note: Implementation specific Parameter.</p>
                              </html> ]]></a:v>
                            </a:a>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v class="PreCompile">VariantPreCompile</icc:v>
                              <icc:v class="PostBuild">VariantPostBuild</icc:v>
                            </a:a>
                            <a:a name="ORIGIN" value="Freescale"/>
                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                            <a:a name="UUID" value="ECUC:30d000e9-a4b5-4b7c-af10-7df72ed5ecbe"/>
                            <a:da name="DEFAULT" value="NormalMode"/>
                            <a:da name="RANGE">
                              <a:v>PowerDown</a:v>
                              <a:v>LowPower</a:v>
                              <a:v>NormalMode</a:v>
                            </a:da>
                            <a:da name="INVALID" type="XPath">
                                <a:tst expr="((ecu:get('MCU.DFLASH.Has_LowPower') = 'false') and (. = 'LowPower'))" true="DFlash low power mode is not available for this derivative"/>
                            </a:da>
                          </v:var>
                        </v:ctr>
                    </v:ctr>
                  </v:lst>
                  <v:lst name="McuRamSectorSettingConf" type="MAP">
                    <a:da name="MIN" value="1"/>
                    <!-- /** @requirements MCU120_Conf */ -->
                    <!-- @implements DMCU01020  -->
                    <v:ctr name="McuRamSectorSettingConf" type="IDENTIFIABLE">
                      <a:a name="LABEL" value="Mcu Ram Sector Setting Conf" />
                      <a:a name="DESC">
                      <a:v><![CDATA[EN:
                        <html>
                        <p> This container contains the configuration (parameters) for the RAM Sector setting. Please see MCU030 for more information on RAM sec-tor settings.</p>
                        <p> Current AutoSAR specification does not allow any unitialized RAM sector. In case this is needed anyway, please create a dummy RAM section 
                        and make sure Mcu_InitRamSection is not called in the code.</p>
                        <p>Note: Implementation specific Parameter.</p> </html> ]]></a:v>
                      </a:a>
                      <a:a name="UUID"
                           value="ECUC:3e828dd6-8024-4511-b8b4-aa728697290f"/>
                      <!-- /** @requirements MCU177_Conf */ -->
                      <!-- @implements DMCU01021  -->
                      <v:var name="McuRamDefaultValue" type="INTEGER">
                        <a:a name="LABEL" value="Mcu Ram Default Value" />
                        <a:a name="DESC">
                          <a:v><![CDATA[EN:
                            <html> <p>
                              This parameter shall represent the Data pre-setting to be initialized </p>
                            </html>]]></a:v>
                        </a:a>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS"
                             type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v class="PostBuild">VariantPostBuild</icc:v>
                          <icc:v class="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" value="ECUC:bf2724bd-74b1-4b9e-8b9c-6e7828331815"/>
                        <a:da name="DEFAULT" value="186" />
                        <a:da name="INVALID" type="Range">
                          <a:tst expr="&lt;=255"/>
                          <a:tst expr="&gt;=0"/>
                        </a:da>
                      </v:var>
                      <!-- /** @requirements MCU178_Conf */ -->
                      <!-- @implements DMCU01022  -->
                      <v:var name="McuRamSectionBaseAddress" type="INTEGER">
                          <a:a name="LABEL" value="Mcu RAM Section Base Address" />
                          <a:a name="DESC">
                                <a:v><![CDATA[EN:
                                <html> <p>
                                  This parameter represents the RAM section base address. The address
                                  must be aligned to 4 bytes.
                                </p> </html>]]></a:v>
                          </a:a>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS"
                             type="IMPLEMENTATIONCONFIGCLASS">
                             <icc:v class="PostBuild">VariantPostBuild</icc:v>
                             <icc:v class="PreCompile">VariantPreCompile</icc:v>
                          </a:a>
                          <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                          <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                          <a:da name="DEFAULT" value="1073741824" />
                          <a:a name="UUID" value="ECUC:cbf8716b-c5eb-4198-a7de-878954edc703"/>
                          <a:da name="INVALID" type="Range">
                             <a:tst expr="&lt;=1342242816" />
                             <a:tst expr="&gt;=1073741824" />
                          </a:da>
                          <a:da name="RANGE" type="XPath">
                             <a:tst expr=". mod 4 !=0" true="The Ram base address must be 4 byte alligned." />
                             <a:tst expr="node:fallback(., 1073741824) &gt; ecu:get('Mcu.McuModuleConfiguration.McuRamSectorSettingConf.McuRamSectionBaseAddress.high') or node:fallback(., 1073741824) &lt; ecu:get('Mcu.McuModuleConfiguration.McuRamSectorSettingConf.McuRamSectionBaseAddress.low')" true="The Ram address is out of range."/>
                          </a:da>
                      </v:var>
                      <!-- /** @requirements MCU179_Conf */ -->
                      <!-- @implements DMCU01023  -->
                      <v:var name="McuRamSectionSize" type="INTEGER">
                        <a:a name="DESC">
                        <a:v><![CDATA[EN:
                              <html> <p>
                               This parameter represents the RAM section size in bytes. The size
                               must be multiple of 4.
                               <b>Table for size of different derivatives</b>
                               </p> </html>]]></a:v>
                        </a:a>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS"
                             type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v class="PostBuild">VariantPostBuild</icc:v>
                          <icc:v class="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="LABEL" value="Mcu RAM Section Size" />
                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                        <a:a name="UUID" value="ECUC:d4b4dd9b-f2cb-4b19-8ec8-e2097d31d83d"/>
                        <a:da name="DEFAULT" value="1024" />
                        <a:da name="INVALID" type="Range">
                             <a:tst expr="&lt;=131072" />
                             <a:tst expr="&gt;=0" />
                        </a:da>
                        <a:da name="RANGE" type="XPath">
                          <a:tst expr="(node:fallback(., 1024) &gt; ecu:get('Mcu.McuModuleConfiguration.McuRamSectorSettingConf.McuRamSectionSize'))" true="The Ram size is out of range."/>
                          <a:tst expr="node:fallback(., 1024) mod 4 != 0" true="The Ram size must be 4 byte alligned."/>
                          <a:tst expr="((node:fallback(../McuRamSectionBaseAddress, 1073741824) + node:fallback(., 1024)) &gt; ecu:get('Mcu.McuModuleConfiguration.McuRamSectorSettingConf.McuRamSectionBaseAddress.high'))" true=" The ram size exceeds the limit. (McuRamSectionBaseAddress + McuRamSectionSize less than or equal to the maximum size possible)"/>
                        </a:da>
                     </v:var>
                     <!-- @implements DMCU16273 -->
                     <v:var name="McuRamSectionBaseAddrLinkerSym" type="STRING">
                        <a:a name="DESC">
                          <a:v><![CDATA[EN:
                                <html> <p>
                                This parameter represents the RAM section base address. The address
                                must be aligned to 4 bytes.
                                If this parameter is empty, then the integer values from McuRamSectionBaseAddress will be used.</p>
                                <p> Note: Implementation specific Parameter.</p> </html>
                                ]]></a:v>
                          </a:a>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                  <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                  <icc:v class="PostBuild">VariantPostBuild</icc:v>
                          </a:a>
                          <a:a name="ORIGIN" value="Freescale" />
                          <a:a name="SYMBOLICNAMEVALUE" value="false" />
                          <a:a name="LABEL" value="Mcu RAM Section Base Address Linker Symbol" />
                          <a:a name="UUID" value="ECUC:f93d05e8-66e3-4a0a-bfd0-f4e4c68efe73" />
                          <a:da name="DEFAULT" value=""/>
                          <a:da name="INVALID" type="XPath">
                              <a:tst expr="((.='NULL') or (.='Null') or (.='false') or (.='FALSE') or (.='null') or (.='null_ptr') or (.='Null_Ptr') or (.='NULL_PTR'))" true="Invalid name of the, it must be a valid C variable name."/>
                              <a:tst expr="normalize-space(.)='' or normalize-space(.) = '&quot;NULL_PTR&quot;' or normalize-space(.) = 'NULL_PTR' or normalize-space(.) = '&quot;NULL&quot;' or normalize-space(.) = 'NULL' or text:match(normalize-space(.),'^[_a-zA-Z]+[_0-9a-zA-Z]*$')" false="Invalid name, it must be a valid C variable name"/>
                          </a:da>
                       </v:var>
                       <v:var name="McuRamSectionSizeLinkerSym" type="STRING">
                           <a:a name="DESC">
                               <a:v><![CDATA[EN:
                               <html> <p>
                               This parameter represents the RAM section size in bytes. The size must be multiple of 4.
                               If this parameter is empty, then the integer values from McuRamSectionSize will be used.</p><p>Note: Implementation specific Parameter.</p> </html>
                               ]]></a:v>
                           </a:a>
                           <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                   <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                   <icc:v class="PostBuild">VariantPostBuild</icc:v>
                           </a:a>
                           <a:a name="ORIGIN" value="Freescale" />
                           <a:a name="SYMBOLICNAMEVALUE" value="false" />
                           <a:a name="LABEL" value="Mcu RAM Section Size Linker Symbol" />
                           <a:a name="UUID" value="ECUC:20fab563-0bb3-4db2-b28c-5cb5edd2cbf7" />
                           <a:da name="DEFAULT" value=""/>
                           <a:da name="INVALID" type="XPath">
                               <a:tst expr="((.='NULL') or (.='Null') or (.='false') or (.='FALSE') or (.='null') or (.='null_ptr') or (.='Null_Ptr') or (.='NULL_PTR'))" true="Invalid name of the, it must be a valid C variable name."/>
                               <a:tst expr="normalize-space(.)='' or normalize-space(.) = '&quot;NULL_PTR&quot;' or normalize-space(.) = 'NULL_PTR' or normalize-space(.) = '&quot;NULL&quot;' or normalize-space(.) = 'NULL' or text:match(normalize-space(.),'^[_a-zA-Z]+[_0-9a-zA-Z]*$')" false="Invalid name, it must be a valid C variable name"/>
                           </a:da>
                        </v:var>
                    </v:ctr>
                  </v:lst>
                                    <v:ctr name="McuDMA" type="IDENTIFIABLE">
                                        <a:a name="LABEL" value="Mcu DMA" />
                                        <a:a name="DESC">
                                            <a:v>
                                            <![CDATA[
                                                <html>
                                                    <p>
                                                        This container contains the configuration parameters of eDMA channel multiplexer (DMA_MUX) that allows to route DMA sources (slots) to eDMA channels.  </p><p>Note: Implementation specific Parameter.
                                                    </p>
                                                </html>
                                                ]]>
                                            </a:v>
                                        </a:a>
                                        <a:a name="TAB" value="McuDMA"/>
                                        <a:a name="LABEL" value="Mcu DMA" />
                                        <a:a name="UUID" value="ECUC:d6be5dfe-690c-4c4a-907d-yu85dc50d724"/>
                                        <a:a name="ENABLE" type="XPath">
                                          <a:tst expr="(ecu:get('Mcu.McuModuleConfiguration.McuDMAMUXandEDMAConfig.DmaActive')='true') and (../../../McuGeneralConfiguration/McuDmaInit = 'true')"/>
                                        </a:a>
                                        <v:ctr name="DSPI0_TX" type="IDENTIFIABLE">
                                        <a:a name="LABEL" value="DSPI0 TX" />
                                        <a:a name="DESC">
                                                <a:v><![CDATA[EN:
                                                  <html> <p>
                                                  This register contains the combination for DMAChannelId, McuDMASource, DMAChannelEnable, and DMAChannelTriggerEnable;
                                                  Note that the column 'Name' is automatically generated, so the user must not edit this.
                                                  </p> </html>]]></a:v>
                                            </a:a>
                                            <a:a name="UUID" value="ECUC:bbba3701-1635-406b-acbb-c823c7c6d4a5"/>
                                            <v:var name="DMAChannelId" type="INTEGER">
                                                <a:a name="LABEL" value="DMA Channel Id" />
                                                <a:a name="DESC">
                                                    <a:v><![CDATA[EN:
                                                  <html> <p> Channel Id of the DMAchannel.
                                                  </p><p>Note: Implementation specific Parameter.</p> </html>]]></a:v>
                                                </a:a>
                                                <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                     type="IMPLEMENTATIONCONFIGCLASS">
                                                    <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                                    <icc:v class="PostBuild">VariantPostBuild</icc:v>
                                                </a:a>
                                                <a:a name="ORIGIN" value="Freescale"/>
                                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                <a:a name="UUID" value="ECUC:6b7b654d-0fd5-4b30-a376-dc645f4c86f8"/>
                                                <a:da name="DEFAULT" value="0"/>
                                                <a:da name="INVALID" type="Range">
                                                    <a:tst expr="&lt;=35"/>
                                                    <a:tst expr="&gt;=0"/>
                                                </a:da>
                                                <a:da name="RANGE" type="XPath">
                                                    <a:tst expr="(. &gt;=0) and (. &lt;=35)"
                                                           false="Value out of range: must be in range 0 to 35."/>
                                                </a:da>

                                                <a:da name="RANGE" type="XPath">
                                                    <a:tst expr="((../../DSPI0_RX/DMAChannelId  = .) or
                                                           (../../DSPI1_TX/DMAChannelId  = .) or
                                                           (../../DSPI1_RX/DMAChannelId  = .) or
                                                           (../../DSPI2_TX/DMAChannelId  = .) or
                                                           (../../DSPI2_RX/DMAChannelId  = .) or
                                                           (../../DSPI3_TX/DMAChannelId  = .) or
                                                           (../../DSPI3_RX/DMAChannelId  = .) or
                                                           (../../DSPI4_TX/DMAChannelId  = .) or
                                                           (../../DSPI4_RX/DMAChannelId  = .) or
                                                           (../../DSPI5_TX/DMAChannelId  = .) or
                                                           (../../DSPI5_RX/DMAChannelId  = .) or
                                                           (../../EMIOS0_CH0/DMAChannelId  = .) or
                                                           (../../EMIOS0_CH1/DMAChannelId  = .) or
                                                           (../../EMIOS0_CH9/DMAChannelId  = .) or
                                                           (../../EMIOS0_CH18/DMAChannelId  = .) or
                                                           (../../EMIOS0_CH25/DMAChannelId  = .) or
                                                           (../../EMIOS0_CH26/DMAChannelId  = .) or
                                                           (../../EMIOS1_CH0/DMAChannelId  = .) or
                                                           (../../EMIOS1_CH9/DMAChannelId  = .) or
                                                           (../../EMIOS1_CH17/DMAChannelId  = .) or
                                                           (../../EMIOS1_CH18/DMAChannelId  = .) or
                                                           (../../EMIOS1_CH25/DMAChannelId  = .) or
                                                           (../../EMIOS1_CH26/DMAChannelId  = .) or
                                                           (../../ADC0_EOC/DMAChannelId  = .) or
                                                           (../../ADC1_EOC/DMAChannelId  = .) or
                                                           (../../IIC_RX/DMAChannelId  = .) or
                                                           (../../IIC_TX/DMAChannelId  = .) or
                                                           (../../LINFLEXD0_RX/DMAChannelId  = .) or
                                                           (../../LINFLEXD0_TX/DMAChannelId  = .) or
                                                           (../../LINFLEXD1_RX/DMAChannelId  = .) or
                                                           (../../LINFLEXD1_TX/DMAChannelId  = .) or
                                                           (../../ALWAYS_ENABLED_0/DMAChannelId  = .) or
                                                           (../../ALWAYS_ENABLED_1/DMAChannelId  = .) or
                                                           (../../ALWAYS_ENABLED_2/DMAChannelId  = .) or
                                                           (../../ALWAYS_ENABLED_3/DMAChannelId  = .))"
                                                           true=" This DMA channel is already used."/>
                                                </a:da>

                                                <a:da name="TOOLTIP" value="Min Value=0, Max value=15"/>
                                            </v:var>
                                                <v:var name="McuDMASource" type="STRING">
                                                <a:a name="LABEL" value="Mcu DMA Source" />
                                                <a:a name="DESC">
                                                    <a:v><![CDATA[EN:
                                                  <html>
                                                  <p> This parameter specifies the DMA Source for the DMA channel </p>
                                                  <p> bit SRC in DMAMUX_CHCONFIGx register</p>
                                                  </html>]]></a:v>
                                                </a:a>
                                                <a:a name="IMPLEMENTATIONCONFIGCLASS"
                                                     type="IMPLEMENTATIONCONFIGCLASS">
                                                    <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                                    <icc:v class="PostBuild">VariantPostBuild</icc:v>
                                                </a:a>
                                                <a:a name="ORIGIN" value="Freescale"/>
                                                <a:a name="COLUMN_TITLE" value="Source"/>
                                                <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                                <a:a name="UUID" value="ECUC:8f5b39ff-54e2-4934-9d92-580770cda102"/>
                                                <a:a name="EDITABLE" value="false"/>
                                                <a:da name="DEFAULT" value="DSPI0_TX"/>
                                                <a:da name="RANGE">
                                                    <a:v>DSPI0_TX</a:v>
                                                </a:da>
                                                <a:da name="INVALID" type="XPath">
                          <a:tst expr="(../../DSPI0_RX/McuDMASource  = .)" true=" DSPI0_RX is already selected."/>
