      <v:ctr name="McuDMAMUXandEDMAConfig" type="IDENTIFIABLE">
      <a:a name="LABEL" value="Mcu DMAMUX and EDMA Config" />
        <a:a name="DESC">
          <a:v>
            <![CDATA[EN:
            <html>
              <p>This container contains the SPECIFIC configuration (parameters) of the DMAMUXandEDMA Configuration.
              Click on RED button,to enable the container.</p>
              <p> Note: implementation specific Container.</p>
            </html>]]></a:v>
          </a:a>
          <a:a name="UUID" value="ECUC:51eeb516-a493-4a4f-82f7-c04e59314c8a" />
          <a:a name="ENABLE" type="XPath">
            <a:tst expr="(ecu:get('Mcu.McuModuleConfiguration.McuDMAMUXandEDMAConfig.DmaActive')='true') and (../../../McuGeneralConfiguration/McuDmaInit = 'true')"/>
          </a:a>
          <v:var name="eDMAChannelPriority0" type="INTEGER">
           <a:a name="LABEL" value="eDMA Channel Priority 0" />
            <a:a name="DESC">
              <a:v>
                <![CDATA[EN:
                <html>
                  <p> eDMA Channel Priority 0,1,2 and 3 register value (DCHPRI0 up to
                    DCHPRI3). First byte corresponds to DCHPRI0 register.
                    Example:
                    0x80010203UL corresponds to
                    <table>
                      <tbody>
                        <tr>
                          <th>Description</th>
                          <th>Value</th>
                        </tr>
                        <tr>
                          <td>DCHPRI0</td>
                          <td>0x80</td>
                        </tr>
                        <tr>
                          <td>DCHPRI1</td>
                          <td>0x01</td>
                        </tr>
                        <tr>
                          <td>DCHPRI2</td>
                          <td>0x02</td>
                        </tr>
                        <tr>
                          <td>DCHPRI3</td>
                          <td>0x03</td>
                        </tr>
                      </tbody>
                    </table>
                  </p>
                  <p>Note: each eDMA channel must have different priority.</p>
                  <p>DCHPRIn[0] represents ECP  bit of  (DCHPRIn) register  corresponds to Enable Channel Preemption.
                    <table>
                      <tbody>
                        <tr>
                          <th>Value</th>
                          <th>Description</th>
                        </tr>
                        <tr>
                          <td>0</td>
                          <td>Channel n cannot be suspended by a higher priority channels service request.</td>
                        </tr>
                        <tr>
                          <td>1</td>
                          <td>Channel n can be temporarily suspended by the service request of a higher priority channel.</td>
                        </tr>
                      </tbody>
                    </table>
                    DCHPRIn[1] represents DPA  bit of  (DCHPRIn) register  corresponds to Disable Preempt Ability.
                    <table>
                      <tbody>
                        <tr>
                          <th>Value</th>
                          <th>Description</th>
                        </tr>
                        <tr>
                          <td>0</td>
                          <td>Channel n can suspend a lower priority channel.</td>
                        </tr>
                        <tr>
                          <td>1</td>
                          <td>Channel n cannot suspend any channel, regardless of channel priority.</td>
                        </tr>
                      </tbody>
                    </table>
                    DCHPRIn[4_7] represents CHPRI  bit of  (DCHPRIn) register  corresponds to channel priority.
                  Value ranges from 0 to 15.</p>
                  <p>Note: Implementation specific Parameter.</p>
                </html>]]></a:v>
              </a:a>
              <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                <icc:v class="PreCompile">VariantPreCompile</icc:v>
                <icc:v class="PostBuild">VariantPostBuild</icc:v>
              </a:a>
              <a:a name="ORIGIN" value="Freescale" />
              <a:a name="SYMBOLICNAMEVALUE" value="false" />
              <a:a name="UUID" value="ECUC:918e9d18-ff76-4689-911c-e24618ce3d98" />
              <a:da name="DEFAULT" value="66051" />
              <a:da name="INVALID" type="Range">
                <a:tst expr="&lt;=4294967295" />
                <a:tst expr="&gt;=0" />
              </a:da>
            </v:var>
            <v:var name="eDMAChannelPriority4" type="INTEGER">
           <a:a name="LABEL" value="eDMA Channel Priority 4" />
              <a:a name="DESC">
                <a:v>
                  <![CDATA[EN:
                  <html>
                    <p> eDMA Channel Priority 4,5,6 and 7 register value (DCHPRI4 up to
                      DCHPRI7). First byte corresponds to DCHPRI4 register.
                      Example:
                      0x80010203UL corresponds to
                      <table>
                        <tbody>
                          <tr>
                            <th>Description</th>
                            <th>Value</th>
                          </tr>
                          <tr>
                            <td>DCHPRI4</td>
                            <td>0x80</td>
                          </tr>
                          <tr>
                            <td>DCHPRI5</td>
                            <td>0x01</td>
                          </tr>
                          <tr>
                            <td>DCHPRI6</td>
                            <td>0x02</td>
                          </tr>
                          <tr>
                            <td>DCHPRI7</td>
                            <td>0x03</td>
                          </tr>
                        </tbody>
                      </table>
                    </p>
                    <p>Note: each eDMA channel must have different priority.</p>
                    <p>DCHPRIn[0] represents ECP  bit of  (DCHPRIn) register  corresponds to Enable Channel Preemption.
                      <table>
                        <tbody>
                          <tr>
                            <th>Value</th>
                            <th>Description</th>
                          </tr>
                          <tr>
                            <td>0</td>
                            <td>Channel n cannot be suspended by a higher priority channels service request.</td>
                          </tr>
                          <tr>
                            <td>1</td>
                            <td>Channel n can be temporarily suspended by the service request of a higher priority channel.</td>
                          </tr>
                        </tbody>
                      </table>
                      DCHPRIn[1] represents DPA  bit of  (DCHPRIn) register  corresponds to Disable Preempt Ability.
                      <table>
                        <tbody>
                          <tr>
                            <th>Value</th>
                            <th>Description</th>
                          </tr>
                          <tr>
                            <td>0</td>
                            <td>Channel n can suspend a lower priority channel.</td>
                          </tr>
                          <tr>
                            <td>1</td>
                            <td>Channel n cannot suspend any channel, regardless of channel priority.</td>
                          </tr>
                        </tbody>
                      </table>
                      DCHPRIn[4_7] represents CHPRI  bit of  (DCHPRIn) register  corresponds to channel priority.
                    Value ranges from 0 to 15.</p>
                    <p> Note: Implementation specific Parameter.</p>
                  </html>]]></a:v>
                </a:a>
                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                  <icc:v class="PreCompile">VariantPreCompile</icc:v>
                  <icc:v class="PostBuild">VariantPostBuild</icc:v>
                </a:a>
                <a:a name="ORIGIN" value="Freescale" />
                <a:a name="SYMBOLICNAMEVALUE" value="false" />
                <a:a name="UUID" value="ECUC:a1a35f49-b908-48fd-9728-0273cf67f0a6" />
                <a:da name="DEFAULT" value="67438087" />
                <a:da name="INVALID" type="Range">
                  <a:tst expr="&lt;=4294967295" />
                  <a:tst expr="&gt;=0" />
                </a:da>
              </v:var>
              <v:var name="eDMAChannelPriority8" type="INTEGER">
              <a:a name="LABEL" value="eDMA Channel Priority 8" />
                <a:a name="DESC">
                  <a:v>
                    <![CDATA[EN:
                    <html>
                      <p> eDMA Channel Priority 8,9,10 and 11 register value (DCHPRI8 up to
                        DCHPRI11). First byte corresponds to DCHPRI8 register.
                        Example:
                        0x80010203UL corresponds to
                        <table>
                          <tbody>
                            <tr>
                              <th>Description</th>
                              <th>Value</th>
                            </tr>
                            <tr>
                              <td>DCHPRI8</td>
                              <td>0x80</td>
                            </tr>
                            <tr>
                              <td>DCHPRI9</td>
                              <td>0x01</td>
                            </tr>
                            <tr>
                              <td>DCHPRI10</td>
                              <td>0x02</td>
                            </tr>
                            <tr>
                              <td>DCHPRI11</td>
                              <td>0x03</td>
                            </tr>
                          </tbody>
                        </table>
                      </p>
                      <p>Note: each eDMA channel must have different priority.</p>
                      <p>DCHPRIn[0] represents ECP  bit of  (DCHPRIn) register  corresponds to Enable Channel Preemption.
                        <table>
                          <tbody>
                            <tr>
                              <th>Value</th>
                              <th>Description</th>
                            </tr>
                            <tr>
                              <td>0</td>
                              <td>Channel n cannot be suspended by a higher priority channels service request.</td>
                            </tr>
                            <tr>
                              <td>1</td>
                              <td>Channel n can be temporarily suspended by the service request of a higher priority channel.</td>
                            </tr>
                          </tbody>
                        </table>
                        DCHPRIn[1] represents DPA  bit of  (DCHPRIn) register  corresponds to Disable Preempt Ability.
                        <table>
                          <tbody>
                            <tr>
                              <th>Value</th>
                              <th>Description</th>
                            </tr>
                            <tr>
                              <td>0</td>
                              <td>Channel n can suspend a lower priority channel.</td>
                            </tr>
                            <tr>
                              <td>1</td>
                              <td>Channel n cannot suspend any channel, regardless of channel priority.</td>
                            </tr>
                          </tbody>
                        </table>
                        DCHPRIn[4_7] represents CHPRI  bit of  (DCHPRIn) register  corresponds to channel priority.
                      Value ranges from 0 to 15.</p>
                      <p> Note: Implementation specific Parameter.</p>
                    </html>]]></a:v>
                  </a:a>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v class="PreCompile">VariantPreCompile</icc:v>
                    <icc:v class="PostBuild">VariantPostBuild</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="Freescale" />
                  <a:a name="SYMBOLICNAMEVALUE" value="false" />
                  <a:a name="UUID" value="ECUC:9740dd09-b488-47ea-9d79-58667847dd93" />
                  <a:da name="DEFAULT" value="134810123" />
                  <a:da name="INVALID" type="Range">
                    <a:tst expr="&lt;=4294967295" />
                    <a:tst expr="&gt;=0" />
                  </a:da>
                </v:var>
                <v:var name="eDMAChannelPriority12" type="INTEGER">
                  <a:a name="LABEL" value="eDMA Channel Priority 12" />
                  <a:a name="DESC">
                    <a:v>
                      <![CDATA[EN:
                      <html>
                        <p>eDMA Channel Priority 12,13,14 and 15 register value (DCHPRI12 up to
                          DCHPRI15). First byte corresponds to DCHPRI12 register.
                          Example:
                          0x00010203UL corresponds to
                          <table>
                            <tbody>
                              <tr>
                                <th>Description</th>
                                <th>Value</th>
                              </tr>
                              <tr>
                                <td>DCHPRI12</td>
                                <td>0x80</td>
                              </tr>
                              <tr>
                                <td>DCHPRI13</td>
                                <td>0x01</td>
                              </tr>
                              <tr>
                                <td>DCHPRI14</td>
                                <td>0x02</td>
                              </tr>
                              <tr>
                                <td>DCHPRI15</td>
                                <td>0x03</td>
                              </tr>
                            </tbody>
                          </table>
                        </p>
                        <p>Note: each eDMA channel must have different priority.</p>
                        <p>DCHPRIn[0] represents ECP  bit of  (DCHPRIn) register  corresponds to Enable Channel Preemption.
                          <table>
                            <tbody>
                              <tr>
                                <th>Value</th>
                                <th>Description</th>
                              </tr>
                              <tr>
                                <td>0</td>
                                <td>Channel n cannot be suspended by a higher priority channels service request.</td>
                              </tr>
                              <tr>
                                <td>1</td>
                                <td>Channel n can be temporarily suspended by the service request of a higher priority channel.</td>
                              </tr>
                            </tbody>
                          </table>
                          DCHPRIn[1] represents DPA  bit of  (DCHPRIn) register  corresponds to Disable Preempt Ability.
                          <table>
                            <tbody>
                              <tr>
                                <th>Value</th>
                                <th>Description</th>
                              </tr>
                              <tr>
                                <td>0</td>
                                <td>Channel n can suspend a lower priority channel.</td>
                              </tr>
                              <tr>
                                <td>1</td>
                                <td>Channel n cannot suspend any channel, regardless of channel priority.</td>
                              </tr>
                            </tbody>
                          </table>
                          DCHPRIn[4_7] represents CHPRI  bit of  (DCHPRIn) register  corresponds to channel priority.
                        Value ranges from 0 to 15.</p>
                        <p>Note: Implementation specific Parameter.</p>
                      </html>]]></a:v>
                    </a:a>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v class="PreCompile">VariantPreCompile</icc:v>
                      <icc:v class="PostBuild">VariantPostBuild</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="Freescale" />
                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                    <a:a name="UUID" value="ECUC:92f40440-2b22-41a3-8604-2273c138250c" />
                    <a:da name="DEFAULT" value="202182159" />
                    <a:da name="INVALID" type="Range">
                      <a:tst expr="&lt;=4294967295" />
                      <a:tst expr="&gt;=0" />
                    </a:da>
                  </v:var>
                  <v:var name="EMLM" type="BOOLEAN">
                    <a:a name="LABEL" value="EMLM Enable minor loop mapping"/>
                    <a:a name="DESC">
                      <a:v>
                        <![CDATA[
                        <html>
                          <p> Enable minor loop mapping
                            <table>
                              <tbody>
                                <tr>
                                  <th>Value</th>
                                  <th>Description</th>
                                </tr>
                                <tr>
                                  <td>0</td>
                                  <td>Minor loop mapping disabled. TCD Word 2 is defined as a 32-bit nbytes field.</td>
                                </tr>
                                <tr>
                                  <td>1</td>
                                  <td>Minor loop mapping enabled. When set, TCDn Word 2 is redefined to include individual enable fields, an offset field and the NBYTES field. The individual enable fields allow the minor loop offset to be applied to the source address, the destination address, or both. The NBYTES field is reduced when either offset is enabled</td>
                                </tr>
                              </tbody>
                            </table>
                          Note: Implementation specific Parameter.</p>
                        </html>]]></a:v>
                      </a:a>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v class="PreCompile">VariantPreCompile</icc:v>
                        <icc:v class="PostBuild">VariantPostBuild</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="Freescale" />
                      <a:a name="SYMBOLICNAMEVALUE" value="false" />
                      <a:a name="UUID" value="ECUC:4fd108cb-a140-47df-97fb-e11908b80760" />
                      <a:da name="DEFAULT" value="false" />
                    </v:var>
                  <v:var name="CLM" type="BOOLEAN">
                    <a:a name="LABEL" value="CLM Continuous link mode"/>
                    <a:a name="DESC">
                      <a:v>
                        <![CDATA[
                        <html>
                          <p> Continuous link mode
                            <table>
                              <tbody>
                                <tr>
                                  <th>Value</th>
                                  <th>Description</th>
                                </tr>
                                <tr>
                                  <td>0</td>
                                  <td>A minor loop channel link made to itself goes through channel arbitration before being activatedagain.</td>
                                </tr>
                                <tr>
                                  <td>1</td>
                                  <td>A minor loop channel link made to itself does not go through channel arbitration before being activated again. Upon minor loop completion, the channel is active again if that channel has a minor loop channel link enabled and the link channel is itself. This effectively applies the minor loop offsets and restarts the next minor loop.</td>
                                </tr>
                              </tbody>
                            </table>
                          Note: Implementation specific Parameter.</p>
                        </html>]]></a:v>
                      </a:a>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v class="PreCompile">VariantPreCompile</icc:v>
                        <icc:v class="PostBuild">VariantPostBuild</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="Freescale" />
                      <a:a name="SYMBOLICNAMEVALUE" value="false" />
                      <a:a name="UUID" value="ECUC:e611d296-5c2a-4c66-a1a6-fa8cc110bcd4" />
                      <a:da name="DEFAULT" value="false" />
                    </v:var>
                  <v:var name="HALT" type="BOOLEAN">
                    <a:a name="LABEL" value="HALT DMA operations"/>
                    <a:a name="DESC">
                      <a:v>
                        <![CDATA[
                        <html>
                          <p> HALT DMA operations
                            <table>
                              <tbody>
                                <tr>
                                  <th>Value</th>
                                  <th>Description</th>
                                </tr>
                                <tr>
                                  <td>0</td>
                                  <td>Normal operation.</td>
                                </tr>
                                <tr>
                                  <td>1</td>
                                  <td>Stall the start of any new channels. Executing channels are allowed to complete. Channel execution resumes when the HALT bit is cleared.</td>
                                </tr>
                              </tbody>
                            </table>
                          Note: Implementation specific Parameter.</p>
                        </html>]]></a:v>
                      </a:a>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v class="PreCompile">VariantPreCompile</icc:v>
                        <icc:v class="PostBuild">VariantPostBuild</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="Freescale" />
                      <a:a name="SYMBOLICNAMEVALUE" value="false" />
                      <a:a name="UUID" value="ECUC:38ec1f16-74c7-4739-8d93-b82b352f1433" />
                      <a:da name="DEFAULT" value="false" />
                    </v:var>
                  <v:var name="HOE" type="BOOLEAN">
                    <a:a name="LABEL" value="HOE Halt on error"/>
                    <a:a name="DESC">
                      <a:v>
                        <![CDATA[
                        <html>
                          <p> Halt on error
                            <table>
                              <tbody>
                                <tr>
                                  <th>Value</th>
                                  <th>Description</th>
                                </tr>
                                <tr>
                                  <td>0</td>
                                  <td>Normal operation.</td>
                                </tr>
                                <tr>
                                  <td>1</td>
                                  <td>Any error causes the HALT bit to be set. Subsequently, all service requests are ignored until the HALT bit is cleared</td>
                                </tr>
                              </tbody>
                            </table>
                          Note: Implementation specific Parameter.</p>
                        </html>]]></a:v>
                      </a:a>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v class="PreCompile">VariantPreCompile</icc:v>
                        <icc:v class="PostBuild">VariantPostBuild</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="Freescale" />
                      <a:a name="SYMBOLICNAMEVALUE" value="false" />
                      <a:a name="UUID" value="ECUC:d5927fb9-b8c6-4829-ad85-602601e08847" />
                      <a:da name="DEFAULT" value="false" />
                    </v:var>
                  <v:var name="ERGA" type="BOOLEAN">
                    <a:a name="LABEL" value="ERGA Enable Round-Robin Group Arbitration"/>
                    <a:a name="DESC">
                      <a:v>
                        <![CDATA[
                        <html>
                          <p> Enable Round-Robin Group Arbitration.
                            <table>
                              <tbody>
                                <tr>
                                  <th>Value</th>
                                  <th>Description</th>
                                </tr>
                                <tr>
                                  <td>0</td>
                                  <td>Fixed-priority arbitration is used for selection among the groups.</td>
                                </tr>
                                <tr>
                                  <td>1</td>
                                  <td>Round-robin arbitration is used for selection among the groups.</td>
                                </tr>
                              </tbody>
                            </table>
                          Note: Implementation specific Parameter.</p>
                        </html>]]></a:v>
                      </a:a>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v class="PreCompile">VariantPreCompile</icc:v>
                        <icc:v class="PostBuild">VariantPostBuild</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="Freescale" />
                      <a:a name="SYMBOLICNAMEVALUE" value="false" />
                      <a:a name="UUID" value="ECUC:64c641ca-db80-4794-bb98-02c4403ebd7e" />
                      <a:da name="DEFAULT" value="false" />
                  </v:var>
                  <v:var name="ERCA" type="BOOLEAN">
                  <a:a name="LABEL" value="ERCA" />
                    <a:a name="DESC">
                      <a:v>
                        <![CDATA[EN:
                        <html>
                          <p> Enable Round-Robin Channel Arbitration.
                            <table>
                              <tbody>
                                <tr>
                                  <th>Value</th>
                                  <th>Description</th>
                                </tr>
                                <tr>
                                  <td>0</td>
                                  <td>Fixed-priority arbitration is used for channel selection.</td>
                                </tr>
                                <tr>
                                  <td>1</td>
                                  <td>Round-robin arbitration is used for channel selection.</td>
                                </tr>
                              </tbody>
                            </table>
                          </p>
                          <p>Note: Implementation specific Parameter.</p>
                        </html>]]></a:v>
                      </a:a>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v class="PreCompile">VariantPreCompile</icc:v>
                        <icc:v class="PostBuild">VariantPostBuild</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="Freescale" />
                      <a:a name="SYMBOLICNAMEVALUE" value="false" />
                      <a:a name="UUID" value="ECUC:268bb276-6e65-4a1a-b6c7-9ff3f28ae802" />
                      <a:da name="DEFAULT" value="false" />
                    </v:var>
                    <v:var name="EDBG" type="BOOLEAN">
                      <a:a name="LABEL" value="EDBG" />
                      <a:a name="DESC">
                        <a:v>
                          <![CDATA[EN:
                          <html>
                            <p> Enable Debug.
                              <table>
                                <tbody>
                                  <tr>
                                    <th>Value</th>
                                    <th>Description</th>
                                  </tr>
                                  <tr>
                                    <td>0</td>
                                    <td>The assertion of the system debug control input is ignored.</td>
                                  </tr>
                                  <tr>
                                    <td>1</td>
                                    <td>The assertion of the system debug control input causes the eDMA
                                      to stall the start of a new channel. Executing channels are allowed
                                      to complete. Channel execution will resume when either the system
                                    debug control input is negated or the EDBG bit is cleared.</td>
                                  </tr>
                                </tbody>
                              </table>
                            </p>
                            <p>Note: Implementation specific Parameter.</p>
                          </html>]]></a:v>
                        </a:a>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v class="PreCompile">VariantPreCompile</icc:v>
                          <icc:v class="PostBuild">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="Freescale" />
                        <a:a name="SYMBOLICNAMEVALUE" value="false" />
                        <a:a name="UUID" value="ECUC:a0a3b449-3628-4d4a-8e18-444f44501d0d" />
                        <a:da name="DEFAULT" value="false" />
                      </v:var>
                      <v:var name="EBW" type="BOOLEAN">
                       <a:a name="LABEL" value="EBW" />
                        <a:a name="DESC">
                          <a:v>
                            <![CDATA[EN:
                            <html>
                              <p> Enable Buffered Writes.
                                <table>
                                  <tbody>
                                    <tr>
                                      <th>Value</th>
                                      <th>Description</th>
                                    </tr>
                                    <tr>
                                      <td>0</td>
                                      <td>The bufferable write signal (hprot[2]) is not
                                      asserted during AMBA AHB writes.</td>
                                    </tr>
                                    <tr>
                                      <td>1</td>
                                      <td>The bufferable write signal (hprot[2]) is asserted
                                        on all AMBA AHB writes except for the last
                                      write sequence.</td>
                                    </tr>
                                  </tbody>
                                </table>
                              </p>
                              <p>Note: Implementation specific Parameter.</p>
                            </html>]]></a:v>
                          </a:a>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                            <icc:v class="PostBuild">VariantPostBuild</icc:v>
                          </a:a>
                          <a:a name="ORIGIN" value="Freescale" />
                          <a:a name="SYMBOLICNAMEVALUE" value="false" />
                          <a:a name="UUID" value="ECUC:7d706e99-335a-46b9-aef8-4324ab2633ed" />
                          <a:da name="DEFAULT" value="false" />
                        </v:var>
                        <v:var name="GRP0PRI" type="INTEGER">
                          <a:a name="LABEL" value="GRP0PRI" />
                          <a:a name="DESC">
                            <a:v><![CDATA[
                              <html> Group 0 priority level when fixed priority group arbitration is enabled.
                              <h1>Note</h1> Implementation specific Parameter.</html>]]></a:v>
                          </a:a>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                            <icc:v class="PostBuild">VariantPostBuild</icc:v>
                          </a:a>
                          <a:a name="ORIGIN" value="Freescale" />
                          <a:a name="SYMBOLICNAMEVALUE" value="false" />
                          <a:a name="UUID" value="ECUC:9043722f-8506-4982-a096-e79214bf7506" />
                          <a:da name="DEFAULT" value="0" />
                          <a:da name="INVALID" type="Range">
                            <a:tst expr="&lt;=1" />
                            <a:tst expr="&gt;=0" />
                          </a:da>
                        </v:var>
                        </v:ctr>
                        <v:ctr name="McuFlashPFCR0" type="IDENTIFIABLE">
                         <a:a name="LABEL" value="Mcu Flash PFCR0" />
                          <a:a name="DESC">
                            <a:v>
                              <![CDATA[EN:  <html> <p> This container contains the SPECIFIC configuration (parameters) of the flash memory array.
                              </p>
                              <p>Note: Implementation specific Container.</p>
                            </html> ]]></a:v>
                          </a:a>
                          <a:a name="UUID" value="ECUC:014aba6d-323c-480a-b3ed-3681f6edc5dc" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                          <v:var name="ReadWhileWriteControl" type="INTEGER">
                            <a:a name="LABEL" value="Read While Write Control" />
                            <a:a name="DESC">
                              <a:v>
                                <![CDATA[EN:  <html> <p>Bank0 Read-While-Write Control. This 3-bit field defines the controller response to flash reads while the array is busy with a program (write) or erase operation. This field is set to 7 by hardware reset enabling the stall-while-write/erase and disabling the abort and notification interrupts.
                                  <table>
                                    <tbody>
                                      <tr>
                                        <th>Value</th>
                                        <th>Description</th>
                                      </tr>
                                      <tr>
                                        <td>0..3</td>
                                        <td>Terminate any attempted read while write/erase with an error response</td>
                                      </tr>
                                      <tr>
                                        <td>7</td>
                                        <td>Generate a bus stall for a read while write/erase, disable the stall notification interrupt, disable the abort + abort notification interrupt.</td>
                                      </tr>
                                      <tr>
                                        <td>6</td>
                                        <td>Generate a bus stall for a read while write/erase, enable the stall notification interrupt, disable the abort + abort notification interrupt</td>
                                      </tr>
                                      <tr>
                                        <td>5</td>
                                        <td>Generate a bus stall for a read while write/erase, enable the operation abort, disable the abort notification interrupt.</td>
                                      </tr>
                                      <tr>
                                        <td>4</td>
                                        <td>Generate a bus stall for a read while write/erase, enable the operation abort and the abort notification interrupt</td>
                                      </tr>
                                    </tbody>
                                  </table>
                                  This field is set to 7 by hardware reset enabling the stall-while-write/erase and disabling the abort and notification interrupts.
                                </p>
                                <p>Note:: implementation specific parameter.</p>
                              </html> ]]></a:v>
                            </a:a>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd">
                              <icc:v class="PreCompile" xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd">VariantPreCompile</icc:v>
                              <icc:v class="PostBuild" xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd">VariantPostBuild</icc:v>
                            </a:a>
                            <a:a name="ORIGIN" value="Freescale" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                            <a:a name="SYMBOLICNAMEVALUE" value="false" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                            <a:a name="UUID" value="ECUC:c701858d-6df7-49cc-9906-72fb2b211d19" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                            <a:da name="DEFAULT" value="7" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                            <a:a name="INVALID" type="Range">
                              <a:tst expr="&lt;=7" />
                              <a:tst expr="&gt;=0" />
                            </a:a>
                          </v:var>
                          <v:var name="Port0PageBufferConfiguration" type="INTEGER">
                            <a:a name="LABEL" value="Port 0 Page Buffer Configuration" />
                            <a:a name="DESC">
                              <a:v>
                                <![CDATA[EN:  <html> <p>
                                  Bank0, Port 0 Page Buffer Configuration. This field controls the configuration of the four page buffers in the PFLASH controller. The buffers can be organized as a "pool" of available resources, or with a fixed partition between instruction and data buffers.
                                  If enabled, when a buffer miss occurs, it is allocated to the least-recently-used buffer within the group and the just-fetched entry then marked as most-recently-used. If the flash access is for the next-sequential line, the buffer is not marked as most-recently-used until the given address produces
                                  a buffer hit.
                                  <table>
                                    <tbody>
                                      <tr>
                                        <th>Value</th>
                                        <th>Description</th>
                                      </tr>
                                      <tr>
                                        <td>0</td>
                                        <td>All four buffers are available for any flash access, that is, there is no partitioning of the buffers based on the access type.</td>
                                      </tr>
                                      <tr>
                                        <td>1</td>
                                        <td>Reserved.</td>
                                      </tr>
                                      <tr>
                                        <td>2</td>
                                        <td>The buffers are partitioned into two groups with buffers 0 and 1 allocated for instruction fetches and buffers 2 and 3 for data accesses.</td>
                                      </tr>
                                      <tr>
                                        <td>3</td>
                                        <td>The buffers are partitioned into two groups with buffers 0,1,2 allocated for instruction fetches and buffer 3 for data accesses.</td>
                                      </tr>
                                    </tbody>
                                  </table>
                                  This field is set to 3 by hardware reset.
                                </p>
                                <p>Note:: implementation specific parameter.
                                </p>
                              </html> ]]></a:v>
                            </a:a>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd">
                              <icc:v class="PreCompile" xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd">VariantPreCompile</icc:v>
                              <icc:v class="PostBuild" xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd">VariantPostBuild</icc:v>
                            </a:a>
                            <a:a name="ORIGIN" value="Freescale" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                            <a:a name="SYMBOLICNAMEVALUE" value="false" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                            <a:a name="UUID" value="ECUC:fd1c7d43-78c1-4d6c-805d-12900372aadb" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                            <a:da name="DEFAULT" value="3" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd">
                            </a:da>
                            <a:a name="INVALID" type="Range">
                              <a:tst expr="&lt;=3" />
                              <a:tst expr="&gt;=0" />
                            </a:a>
                          </v:var>
                          <v:var name="Port0DataPrefetchEnable" type="BOOLEAN">
                            <a:a name="LABEL" value="Port 0 Data Prefetch Enable" />
                            <a:a name="DESC">
                              <a:v>
                                <![CDATA[EN:  <html> <p>Bank0, Port 0 Data Prefetch Enable. This field enables or disables prefetching initiated by a data read access. This field is set by hardware reset.
                                  <table>
                                    <tbody>
                                      <tr>
                                        <th>Value</th>
                                        <th>Description</th>
                                      </tr>
                                      <tr>
                                        <td>0</td>
                                        <td>No prefetching is triggered by a data read access.</td>
                                      </tr>
                                      <tr>
                                        <td>1</td>
                                        <td>If page buffers are enabled (B0_P0_BFE = 1), prefetching is triggered by any data read access.</td>
                                      </tr>
                                    </tbody>
                                  </table>
                                </p>
                                <p>Note:: implementation specific parameter.</p>
                              </html> ]]></a:v>
                            </a:a>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd">
                              <icc:v class="PreCompile" xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd">VariantPreCompile</icc:v>
                              <icc:v class="PostBuild" xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd">VariantPostBuild</icc:v>
                            </a:a>
                            <a:a name="ORIGIN" value="Freescale" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                            <a:a name="SYMBOLICNAMEVALUE" value="false" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                            <a:a name="UUID" value="ECUC:a2a4edfb-ff1e-4a18-b158-e8beab06147a" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                            <a:da name="DEFAULT" value="false" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                          </v:var>
                          <v:var name="Port0InstructionPrefetchEnable" type="BOOLEAN">
                            <a:a name="LABEL" value="Port 0 Instruction Prefetch Enable" />
                            <a:a name="DESC">
                              <a:v>
                                <![CDATA[EN:  <html> <p>Bank0, Port 0 Instruction Prefetch Enable. This field enables or disables prefetching initiated by an instruction fetch read access. This field is cleared by hardware reset.
                                  <table>
                                    <tbody>
                                      <tr>
                                        <th>Value</th>
                                        <th>Description</th>
                                      </tr>
                                      <tr>
                                        <td>0</td>
                                        <td>No prefetching is triggered by an instruction fetch read access</td>
                                      </tr>
                                      <tr>
                                        <td>1</td>
                                        <td>If page buffers are enabled (B0_P0_BFE = 1), prefetching is triggered by any instruction fetch read access.</td>
                                      </tr>
                                    </tbody>
                                  </table>
                                </p>
                                <p>Note:: implementation specific parameter.</p>
                              </html> ]]></a:v>
                            </a:a>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd">
                              <icc:v class="PreCompile" xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd">VariantPreCompile</icc:v>
                              <icc:v class="PostBuild" xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd">VariantPostBuild</icc:v>
                            </a:a>
                            <a:a name="ORIGIN" value="Freescale" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                            <a:a name="SYMBOLICNAMEVALUE" value="false" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                            <a:a name="UUID" value="ECUC:92910949-15e4-4d5c-8cdf-e8c8d9b12245" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                            <a:da name="DEFAULT" value="true" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                          </v:var>
                          <v:var name="Port0PrefetchLimit" type="INTEGER">
                            <a:a name="LABEL" value="Port 0 Prefetch Limit" />
                            <a:a name="DESC">
                              <a:v>
                                <![CDATA[EN:  <html> <p>Bank0, Port 0 Prefetch Limit. This field controls the prefetch algorithm used by the PFLASH controller. This field defines the prefetch behavior. In all situations when enabled, only a single prefetch is initiated on each buffer miss or hit. This field is set to 2 by hardware reset.
                                  <table>
                                    <tbody>
                                      <tr>
                                        <th>Value</th>
                                        <th>Description</th>
                                      </tr>
                                      <tr>
                                        <td>0</td>
                                        <td>No prefetching is performed.</td>
                                      </tr>
                                      <tr>
                                        <td>1</td>
                                        <td>The referenced line is prefetched on a buffer miss, that is, prefetch on miss.</td>
                                      </tr>
                                      <tr>
                                        <td>2 and 3</td>
                                        <td>The referenced line is prefetched on a buffer miss, or the next sequential page is prefetched on a buffer hit (if not already present), that is, prefetch on miss or hit.</td>
                                      </tr>
                                    </tbody>
                                  </table>
                                </p>
                                <p>Note:: implementation specific parameter.</p>
                              </html> ]]></a:v>
                            </a:a>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd">
                              <icc:v class="PreCompile" xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd">VariantPreCompile</icc:v>
                              <icc:v class="PostBuild" xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd">VariantPostBuild</icc:v>
                            </a:a>
                            <a:a name="ORIGIN" value="Freescale" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                            <a:a name="SYMBOLICNAMEVALUE" value="false" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                            <a:a name="UUID" value="ECUC:d1e8c24f-db50-47f8-9841-fd9fe8ce028d" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                            <a:da name="DEFAULT" value="2" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd">
                            </a:da>
                            <a:a name="INVALID" type="Range">
                              <a:tst expr="&lt;=3" />
                              <a:tst expr="&gt;=0" />
                            </a:a>
                          </v:var>
                          <v:var name="Port0BufferEnable" type="BOOLEAN">
                           <a:a name="LABEL" value="Port 0 Buffer Enable" />
                            <a:a name="DESC">
                              <a:v>
                                <![CDATA[EN:  <html> <p>Bank0, Port 0 Buffer Enable. This bit enables or disables page buffer read hits. It is also used toinvalidate the buffers. This bit is set by hardware reset, enabling the page buffers.
                                  <table>
                                    <tbody>
                                      <tr>
                                        <th>Value</th>
                                        <th>Description</th>
                                      </tr>
                                      <tr>
                                        <td>0</td>
                                        <td>The page buffers are disabled from satisfying read requests, and all buffer valid bits are cleared.</td>
                                      </tr>
                                      <tr>
                                        <td>1</td>
                                        <td>The page buffers are enabled to satisfy read requests on hits. Buffer valid bits may be set when the buffers are successfully filled.</td>
                                      </tr>
                                    </tbody>
                                  </table>
                                </p>
                                <p>Note:: implementation specific parameter.</p>
                              </html> ]]></a:v>
                            </a:a>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd">
                              <icc:v class="PreCompile" xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd">VariantPreCompile</icc:v>
                              <icc:v class="PostBuild" xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd">VariantPostBuild</icc:v>
                            </a:a>
                            <a:a name="ORIGIN" value="Freescale" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                            <a:a name="SYMBOLICNAMEVALUE" value="false" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                            <a:a name="UUID" value="ECUC:c690f8aa-0c6b-4664-9a46-a295c2b92263" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                            <a:da name="DEFAULT" value="true" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                          </v:var>
                          </v:ctr>
                        <v:ctr name="McuFlashPFCR1" type="IDENTIFIABLE">
                         <a:a name="LABEL" value="Mcu Flash PFCR1" />
                          <a:a name="DESC">
                            <a:v>
                              <![CDATA[EN:  <html> <p> This container contains the SPECIFIC configuration (parameters) of the flash memory array.
                              </p>
                              <p>Note: Implementation specific Container.</p>
                            </html> ]]></a:v>
                          </a:a>
                          <a:a name="UUID" value="ECUC:014aea6d-323c-480a-b3ed-3681f6edc5dc" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                          <v:var name="ReadWhileWriteControl" type="INTEGER">
                            <a:a name="LABEL" value="Read While Write Control" />
                            <a:a name="DESC">
                              <a:v>
                                <![CDATA[EN:  <html> <p>Bank1 Read-While-Write Control. This 3-bit field defines the controller response to flash reads while the array is busy with a program (write) or erase operation. This field is set to 7 by hardware reset enabling the stall-while-write/erase and disabling the abort and notification interrupts.
                                  <table>
                                    <tbody>
                                      <tr>
                                        <th>Value</th>
                                        <th>Description</th>
                                      </tr>
                                      <tr>
                                        <td>0..3</td>
                                        <td>Terminate any attempted read while write/erase with an error response</td>
                                      </tr>
                                      <tr>
                                        <td>7</td>
                                        <td>Generate a bus stall for a read while write/erase, disable the stall notification interrupt, disable the abort + abort notification interrupt.</td>
                                      </tr>
                                      <tr>
                                        <td>6</td>
                                        <td>Generate a bus stall for a read while write/erase, enable the stall notification interrupt, disable the abort + abort notification interrupt</td>
                                      </tr>
                                      <tr>
                                        <td>5</td>
                                        <td>Generate a bus stall for a read while write/erase, enable the operation abort, disable the abort notification interrupt.</td>
                                      </tr>
                                      <tr>
                                        <td>4</td>
                                        <td>Generate a bus stall for a read while write/erase, enable the operation abort and the abort notification interrupt</td>
                                      </tr>
                                    </tbody>
                                  </table>
                                  This field is set to 7 by hardware reset enabling the stall-while-write/erase and disabling the abort and notification interrupts.
                                </p>
                                <p>Note:: implementation specific parameter.</p>
                              </html> ]]></a:v>
                            </a:a>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd">
                              <icc:v class="PreCompile" xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd">VariantPreCompile</icc:v>
                              <icc:v class="PostBuild" xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd">VariantPostBuild</icc:v>
                            </a:a>
                            <a:a name="ORIGIN" value="Freescale" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                            <a:a name="SYMBOLICNAMEVALUE" value="false" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                            <a:a name="UUID" value="ECUC:a701858d-6df7-49cc-9906-72fb2b211d19" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                            <a:da name="DEFAULT" value="7" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                            <a:a name="INVALID" type="Range">
                              <a:tst expr="&lt;=7" />
                              <a:tst expr="&gt;=0" />
                            </a:a>
                          </v:var>
                          <v:var name="Port0BufferEnable" type="BOOLEAN">
                           <a:a name="LABEL" value="Port 0 Buffer Enable" />
                            <a:a name="DESC">
                              <a:v>
                                <![CDATA[EN:  <html> <p>Bank1, Port 0 Buffer Enable. This bit enables or disables page buffer read hits. It is also used toinvalidate the buffers. This bit is set by hardware reset, enabling the page buffers.
                                  <table>
                                    <tbody>
                                      <tr>
                                        <th>Value</th>
                                        <th>Description</th>
                                      </tr>
                                      <tr>
                                        <td>0</td>
                                        <td>The page buffers are disabled from satisfying read requests, and all buffer valid bits are cleared.</td>
                                      </tr>
                                      <tr>
                                        <td>1</td>
                                        <td>The page buffers are enabled to satisfy read requests on hits. Buffer valid bits may be set when the buffers are successfully filled.</td>
                                      </tr>
                                    </tbody>
                                  </table>
                                </p>
                                <p>Note:: implementation specific parameter.</p>
                              </html> ]]></a:v>
                            </a:a>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd">
                              <icc:v class="PreCompile" xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd">VariantPreCompile</icc:v>
                              <icc:v class="PostBuild" xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd">VariantPostBuild</icc:v>
                            </a:a>
                            <a:a name="ORIGIN" value="Freescale" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                            <a:a name="SYMBOLICNAMEVALUE" value="false" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                            <a:a name="UUID" value="ECUC:e690f8aa-0c6b-4664-9a46-a295c2b92263" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                            <a:da name="DEFAULT" value="true" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                          </v:var>
                          </v:ctr>

                          <v:ctr name="McuFlashPFAPR" type="IDENTIFIABLE">
                            <a:a name="LABEL" value="Mcu Flash PFAPR" />
                            <a:a name="DESC">
                              <a:v>
                                <![CDATA[EN:  <html> <p> This container contains the SPECIFIC configuration (parameters) of the read and write accesses to the flash based on the system master number.
                                </p>
                                <p>Note:: Implementation specific Container.</p>
                              </html> ]]></a:v>
                            </a:a>
                            <a:a name="UUID" value="ECUC:bfa28f20-9cde-4842-b874-fbc7d6b60fd2" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                            <v:var name="Master0PrefetchDisable" type="BOOLEAN">
                             <a:a name="LABEL" value="Master 0 Prefetch Disable" />
                              <a:a name="DESC">
                                <a:v>
                                  <![CDATA[EN:  <html> <p>Master x Prefetch Disable (x = 0,2). Thie bit controls whether prefetching may be triggered based on the master number of the requesting AHB master. This field is further qualified by the PFCRn[B02_Px_DPFE, B02_Px_IPFE, Bx_Py_BFE] bits.
                                    <table>
                                      <tbody>
                                        <tr>
                                          <th>Value</th>
                                          <th>Description</th>
                                        </tr>
                                        <tr>
                                          <td>0</td>
                                          <td>Prefetching may be triggered by this master</td>
                                        </tr>
                                        <tr>
                                          <td>1</td>
                                          <td>No prefetching may be triggered by this master.</td>
                                        </tr>
                                      </tbody>
                                    </table>
                                  </p>
                                  <p>Note:: implementation specific parameter.</p>
                                </html> ]]></a:v>
                              </a:a>
                              <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd">
                                <icc:v class="PreCompile" xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd">VariantPreCompile</icc:v>
                                <icc:v class="PostBuild" xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd">VariantPostBuild</icc:v>
                              </a:a>
                              <a:a name="ORIGIN" value="Freescale" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                              <a:a name="SYMBOLICNAMEVALUE" value="false" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                              <a:a name="UUID" value="ECUC:ed273a96-9541-4ea3-8044-67e962cc0c4e" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                              <a:da name="DEFAULT" value="true" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                            </v:var>
                            <v:var name="Master2PrefetchDisable" type="BOOLEAN">
                             <a:a name="LABEL" value="Master 2 Prefetch Disable" />
                              <a:a name="DESC">
                                <a:v>
                                  <![CDATA[EN:  <html> <p>Master x Prefetch Disable (x = 0,2). Thie bit controls whether prefetching may be triggered based on the master number of the requesting AHB master. This field is further qualified by the PFCRn[B02_Px_DPFE, B02_Px_IPFE, Bx_Py_BFE] bits.
                                    <table>
                                      <tbody>
                                        <tr>
                                          <th>Value</th>
                                          <th>Description</th>
                                        </tr>
                                        <tr>
                                          <td>0</td>
                                          <td>Prefetching may be triggered by this master</td>
                                        </tr>
                                        <tr>
                                          <td>1</td>
                                          <td>No prefetching may be triggered by this master.</td>
                                        </tr>
                                      </tbody>
                                    </table>
                                  </p>
                                  <p>Note:: implementation specific parameter.</p>
                                </html> ]]></a:v>
                              </a:a>
                              <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd">
                                <icc:v class="PreCompile" xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd">VariantPreCompile</icc:v>
                                <icc:v class="PostBuild" xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd">VariantPostBuild</icc:v>
                              </a:a>
                              <a:a name="ORIGIN" value="Freescale" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                              <a:a name="SYMBOLICNAMEVALUE" value="false" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                              <a:a name="UUID" value="ECUC:a18ee0d3-c4b9-44ea-a49c-100d9428e5a0" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                              <a:da name="DEFAULT" value="true" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                              <a:a name="EDITABLE" type="XPath">
                                <a:tst expr="ecu:get('MCU.HAS_M2PFD_M2AP')='true'" />
                              </a:a>
                            </v:var>
                            <v:var name="Master0AccessProtection" type="INTEGER">
                             <a:a name="LABEL" value="Master 0 Access Protection" />
                              <a:a name="DESC">
                                <a:v>
                                  <![CDATA[EN:  <html> <p>Master x Access Protection (x = 0,2). This field controls whether read and write accesses to the flash are allowed based on the master number of the initiating module.
                                    <table>
                                      <tbody>
                                        <tr>
                                          <th>Value</th>
                                          <th>Description</th>
                                        </tr>
                                        <tr>
                                          <td>0</td>
                                          <td>No accesses may be performed by this master</td>
                                        </tr>
                                        <tr>
                                          <td>1</td>
                                          <td>Only read accesses may be performed by this master.</td>
                                        </tr>
                                        <tr>
                                          <td>2</td>
                                          <td>Only write accesses may be performed by this master.</td>
                                        </tr>
                                        <tr>
                                          <td>3</td>
                                          <td>Both read and write accesses may be performed by this master.</td>
                                        </tr>
                                      </tbody>
                                    </table>
                                  </p>
                                  <p>Note:: implementation specific parameter.</p>
                                </html> ]]></a:v>
                              </a:a>
                              <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd">
                                <icc:v class="PreCompile" xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd">VariantPreCompile</icc:v>
                                <icc:v class="PostBuild" xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd">VariantPostBuild</icc:v>
                              </a:a>
                              <a:a name="ORIGIN" value="Freescale" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                              <a:a name="SYMBOLICNAMEVALUE" value="false" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                              <a:a name="UUID" value="ECUC:974280da-078f-4ac3-b9cc-6b4fb4fa7460" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                              <a:da name="DEFAULT" value="3" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd">
                              </a:da>
                              <a:a name="INVALID" type="Range">
                                <a:tst expr="&lt;=3" />
                                <a:tst expr="&gt;=0" />
                              </a:a>
                            </v:var>
                            <v:var name="Master2AccessProtection" type="INTEGER">
                             <a:a name="LABEL" value="Master 2 Access Protection" />
                              <a:a name="DESC">
                                <a:v>
                                  <![CDATA[EN:  <html> <p>Master x Access Protection (x = 0,2). This field controls whether read and write accesses to the flash are allowed based on the master number of the initiating module.
                                    <table>
                                      <tbody>
                                        <tr>
                                          <th>Value</th>
                                          <th>Description</th>
                                        </tr>
                                        <tr>
                                          <td>0</td>
                                          <td>No accesses may be performed by this master</td>
                                        </tr>
                                        <tr>
                                          <td>1</td>
                                          <td>Only read accesses may be performed by this master.</td>
                                        </tr>
                                        <tr>
                                          <td>2</td>
                                          <td>Only write accesses may be performed by this master.</td>
                                        </tr>
                                        <tr>
                                          <td>3</td>
                                          <td>Both read and write accesses may be performed by this master.</td>
                                        </tr>
                                      </tbody>
                                    </table>
                                  </p>
                                  <p>Note:: implementation specific parameter.</p>
                                </html> ]]></a:v>
                              </a:a>
                              <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd">
                                <icc:v class="PreCompile" xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd">VariantPreCompile</icc:v>
                                <icc:v class="PostBuild" xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd">VariantPostBuild</icc:v>
                              </a:a>
                              <a:a name="ORIGIN" value="Freescale" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                              <a:a name="SYMBOLICNAMEVALUE" value="false" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                              <a:a name="UUID" value="ECUC:df15a46f-a0b5-4752-8f7d-07b0b76412c5" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                              <a:da name="DEFAULT" value="3" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd">
                              </a:da>
                              <a:a name="INVALID" type="Range">
                                <a:tst expr="&lt;=3" />
                                <a:tst expr="&gt;=0" />
                              </a:a>
                              <a:a name="EDITABLE" type="XPath">
                                <a:tst expr="ecu:get('MCU.HAS_M2PFD_M2AP')='true'" />
                              </a:a>
                            </v:var>
                          </v:ctr>
                  <v:lst name="McuClockSettingConfig" type="MAP">
                    <a:da name="MIN" value="1"/>
                    <!-- /** @requirements MCU124_Conf */ -->
                    <!-- @implements DMCU01014  -->
                    <v:ctr name="McuClockSettingConfig" type="IDENTIFIABLE">
                      <a:a name="LABEL" value="Mcu Clock Setting Config" />
                      <a:a name="DESC">
                        <a:v><![CDATA[EN:
                        <html>
                        <p>This container contains the configuration (parameters) for the Clock settings of the MCU.
                        </p><p>Note:Please see MCU031 for more information on the MCU clock settings.</p></html>
                        ]]></a:v>
                      </a:a>
                      <a:a name="UUID"
                           value="ECUC:731e81c7-084a-4852-bda3-533b157794e3"/>
                      <!-- /** @requirements MCU183_Conf */ -->
                      <!-- @implements DMCU01015  -->
                      <v:var name="McuClockSettingId" type="INTEGER">
                        <a:a name="LABEL" value="Mcu Clock Setting Id" />
                        <a:a name="DESC">
                          <a:v>
                         <![CDATA[EN:  <html> 
                                         <p>The Id of this McuClockSettingConfig to be used as argument for the API call &quot;Mcu_InitClock&quot;.</p>
                                          </html>
                                          ]]></a:v>
                        </a:a>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS"
                             type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v class="PostBuild">VariantPostBuild</icc:v>
                          <icc:v class="PreCompile">VariantPreCompile</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                        <a:a name="SYMBOLICNAMEVALUE" value="true"/>
                        <a:da name="DEFAULT" type="XPath" expr="num:i((node:fallback((node:current()/../@index),1))+1)"/>
                        <a:a name="UUID" value="ECUC:6bea0045-e7f2-490a-9612-9afdf6684fe3"/>
                        <a:da name="INVALID" type="Range">
                          <a:tst expr="&lt;=255"/>
                          <a:tst expr="&gt;=1"/>
                        </a:da>
                        <a:da name="RANGE" type="XPath">
                          <a:tst expr="text:uniq(node:fallback(../../*/McuClockSettingId, text:split('1 2 3')), node:fallback(., 1))" false="Duplicated value, McuClockSettingId must be unique across McuClockSettingConf. Use the Calc button to calculate correct default value."/>
                          <a:tst expr="node:fallback(., 1) &lt; num:i(count(node:fallback(../../*, 1))+1)" false="Value out of range: must be in range 1 to 255. Use the Calc button to calculate correct default value."/>
                        </a:da>
                      </v:var>
                          <v:var name="McuSystemClockFrequency" type="FLOAT">
                             <a:a name="LABEL" value="Mcu System Clock Frequency" />
                             <a:a name="DESC">
                                  <a:v><![CDATA[EN:
                               <html>
                                 <p> This is the system clock frequency. It shall be given in Hz. </p>
                               </html>
                               ]]></a:v>
                            </a:a>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v class="PostBuild">VariantPostBuild</icc:v>
                              <icc:v class="PreCompile">VariantPreCompile</icc:v>
                            </a:a>
                            <a:a name="ORIGIN" value="Freescale"/>
                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                            <a:a name="UUID" value="ECUC:3cfa53de-6e74-4243-a7eb-92d7cb414a15"/>
                            <a:da name="DEFAULT" type="XPath">
                               <a:tst expr="num:i(num:i(number(node:fallback(../GeneralClockSettings/SystemClockSelect,'McuPLL')='McuPLL')) * num:i(node:fallback(../McuPll_0/McuPll0_Parameter/PLL_0_Frequency,64000000)) + num:i(number(node:fallback(../GeneralClockSettings/SystemClockSelect,'McuPLL')='McuExtQuartzOsc')) * num:i(node:fallback(../../../FrequencyOfFXOSC,8000000)) + num:i(number(node:fallback(../GeneralClockSettings/SystemClockSelect,'McuPLL')='McuDivExtQuartzOsc')) * num:i(node:fallback(../../../FrequencyOfFXOSC,8000000) div node:fallback(../McuXtal_A/McuXtalDivisor,1)) + num:i(number(node:fallback(../GeneralClockSettings/SystemClockSelect,'McuPLL')='McuIntOscRC16MHz')) * 16000000 + num:i(number(node:fallback(../GeneralClockSettings/SystemClockSelect,'McuPLL')='McuDivIntOscRC16MHz')) * 16000000 div node:fallback(../McuRC_16MHz/McuRCDivisor,1))" />
                            </a:da>
                            <a:a name="RANGE" type="XPath">
                                    <a:tst expr="(not(node:empty(.))) and (. != (num:i(num:i(number(node:fallback(../GeneralClockSettings/SystemClockSelect,'McuPLL')='McuPLL')) * num:i(node:fallback(../McuPll_0/McuPll0_Parameter/PLL_0_Frequency,64000000)) + num:i(number(node:fallback(../GeneralClockSettings/SystemClockSelect,'McuPLL')='McuExtQuartzOsc')) * num:i(node:fallback(../../../FrequencyOfFXOSC,8000000)) + num:i(number(node:fallback(../GeneralClockSettings/SystemClockSelect,'McuPLL')='McuDivExtQuartzOsc')) * num:i(node:fallback(../../../FrequencyOfFXOSC,8000000) div node:fallback(../McuXtal_A/McuXtalDivisor,1)) + num:i(number(node:fallback(../GeneralClockSettings/SystemClockSelect,'McuPLL')='McuIntOscRC16MHz')) * 16000000 + num:i(number(node:fallback(../GeneralClockSettings/SystemClockSelect,'McuPLL')='McuDivIntOscRC16MHz')) * 16000000 div node:fallback(../McuRC_16MHz/McuRCDivisor,1))))" true="Please press the button to calculate the value automatically." />
                            </a:a>
                            <a:a name="INVALID" type="Range">
                                <a:tst expr="&lt;=64000000" />
                                <a:tst expr="&gt;=0" />
                            </a:a>
                          </v:var>
                    <v:ctr name="GeneralClockSettings" type="IDENTIFIABLE">
                    <a:a name="LABEL" value="General Clock Settings" />
                    <a:a name="DESC">
                        <a:v><![CDATA[EN:
                        <html>
                         <p>This container contains the SPECIFIC configuration
                           (parameters) of the GeneralClockSettings Configuration.</p>
                           <p> Note: Implementation specific Container.</p>
                         </html>
                         ]]></a:v>
                       </a:a>
                       <a:a name="UUID" value="ECUC:a9ed80ef-bebf-402b-a1ab-076e415c11d6" />
             <v:var name="SystemClockSelect" type="ENUMERATION">
             <a:a name="DESC">
                   <a:v><![CDATA[EN:
                        <html>
                        <p> System Clock Select. The system clock is either: </p>
                         <table>
                         <tbody>
                           <tr>
                             <th>Source </th>
                           </tr>
                           <tr>
                             <td>Internal RC oscillator 16Mhz IRC</td>
                           </tr>
                           <tr>
                             <td>Internal RC oscillator 16 MHz divided IRC Div</td>
                           </tr>
                           <tr>
                             <td>Fast external crystal oscillator XOSC</td>
                           </tr>
                           <tr>
                             <td>Fast external crystal oscillator divided XOSC div</td>
                           </tr>
                           <tr>
                             <td>PLL </td>
                           </tr>
                           <tr>
                             <td>SYSCLK OFF : configurable only in STOP mode, mandatory in STANDBY mode</td>
                           </tr>
                         </tbody>
                        </table>
                             <p> Note: Implementation specific Parameter.</p>
                             <p> Note: For Bolero 256K , in the case that you select Fast external crystal oscillator XOSC or Fast external crystal oscillator divided XOSC as your system clock, it will not be possible to enter in safe mode (see errata e3220 for details) .</p>
                          </html>
                          ]]></a:v>
                          </a:a>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v class="PreCompile">VariantPreCompile</icc:v>
                      <icc:v class="PostBuild">VariantPostBuild</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="Freescale" />
                      <a:a name="SYMBOLICNAMEVALUE" value="false" />
                      <a:a name="UUID" value="ECUC:9f2279a6-68d0-4100-be8c-95d484bb22f3" />
                      <a:a name="LABEL" value="System Clock Select" />
                      <a:da name="DEFAULT" type="XPath" expr="node:fallback(ecu:get('MCU.CLockSelect.Default'),'McuPLL')" />
                      <a:da name="RANGE" type="XPath" expr="ecu:list('MCU.CLockSelect.List')" />
                      <a:da name="INVALID" type="XPath">
                      <a:tst expr="((. = 'McuPLL') and (../McuPLLStatus = 'false'))" true="The clock source can not be selected as system clock because it is disabled. Enable first the clock source." />
                      <a:tst expr="(((. = 'McuIntOscRC16MHz') or (. = 'McuDivIntOscRC16MHz')) and (../McuRC16MHzOscillator = 'false'))" true="The clock source can not be selected as system clock because it is disabled. Enable first the clock source." />
                      <a:tst expr="(((. = 'McuExtQuartzOsc') or (. = 'McuDivExtQuartzOsc')) and (../McuOSC = 'false'))" true="The clock source can not be selected as system clock because it is disabled. Enable first the clock source." />
                      <a:tst expr="((. != 'McuIntOscRC16MHz') and (../McuStartRunMode = 'SAFE'))" true="Only the internal RC oscillator 16MHz can be selected as system clock in SAFE mode." />
                      <a:tst expr="((. = 'McuOff') and (../McuStartRunMode != 'STOP') and (../McuStartRunMode != 'STANDBY'))" true="SysClk can be disabled only in STOP and STANDBY modes" />
                      <a:tst expr="((. != 'McuOff') and (../McuStartRunMode = 'STANDBY'))" true="SysClk must be disabled only in STANDBY mode" />
                     </a:da>
                   </v:var>
                   <v:var name="McuStartRunMode" type="ENUMERATION">
                     <a:a name="DESC">
                              <a:v><![CDATA[EN:
                              <html>
                                 <p> This field contains the operative mode where apply the Clock selected. </p>
                                 <p> This parameter will not be used when the McuOperatingMode is configured as HALT or STOP
                                     mode and the LowPowerClockSettingConfig uses the Clock configuration of the same container.
                                 </p>
                                 <p>Note:Implementation specific Parameter .</p>
                                 </html>
                                             ]]></a:v>
                                 </a:a>
                               <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                       <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                       <icc:v class="PostBuild">VariantPostBuild</icc:v>
                               </a:a>
                               <a:a name="ORIGIN" value="Freescale" />
                               <a:a name="SYMBOLICNAMEVALUE" value="false" />
                               <a:a name="LABEL" value="RUN Mode" />
                    <a:a name="UUID" value="ECUC:c9d4257d-fadf-489f-9445-357f903dd720" />
                    <a:da name="DEFAULT" value="DRUN" />
                    <a:da name="RANGE">
                            <a:v>RUN3</a:v>
                            <a:v>RUN2</a:v>
                            <a:v>RUN1</a:v>
                            <a:v>RUN0</a:v>
                            <a:v>DRUN</a:v>
                            <a:v>SAFE</a:v>
                            <a:v>HALT</a:v>
                            <a:v>STOP</a:v>
                            <a:v>STANDBY</a:v>
                    </a:da>
                    <a:da name="INVALID" type="XPath">
                            <a:tst expr="(((../../../../McuEnableMode/McuModeRun1='false') and .='RUN1') or
                            ((../../../../McuEnableMode/McuModeRun2='false') and .='RUN2') or
                            ((../../../../McuEnableMode/McuModeRun3='false') and .='RUN3'))" true="The selected mode has not been enabled." />
                    </a:da>
                   </v:var>
                   <v:var name="McuOSC" type="BOOLEAN">
                     <a:a name="DESC">
                              <a:v><![CDATA[EN:
                                  <html>
                                 <p>External Oscillator in ON or OFF state.</p>
                                 <p> Note: Implementation specific Parameter .</p>
                                 </html>
                                             ]]></a:v>
                                 </a:a>
                     <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                            <icc:v class="PostBuild">VariantPostBuild</icc:v>
                     </a:a>
                     <a:a name="ORIGIN" value="Freescale" />
                     <a:a name="SYMBOLICNAMEVALUE" value="false" />
                     <a:a name="LABEL" value="XOSC" />
                     <a:a name="UUID" value="ECUC:d5e7f53e-5f89-4795-bbc7-3987cd851b45" />
                     <a:da name="DEFAULT" value="true"/>
                      <a:a name="ENABLE" value="true" />
                      <a:da name="INVALID" type="XPath">
                          <a:tst expr="(node:fallback(../McuStartRunMode,'DRUN') ='SAFE') and (. = 'true')" true="In SAFE mode the PLL is always turned off." />
                       </a:da>
                   </v:var>
                   <v:var name="McuPLLStatus" type="BOOLEAN">
                        <a:a name="DESC">
                        <a:v><![CDATA[EN:
                        <html>
                         <p>Put the PLL0 in ON or OFF state. </p>
                        <p>Note: Implementation specific Parameter. </p>
                        </html>
                        ]]></a:v>
                        </a:a>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                <icc:v class="PostBuild">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="Freescale" />
                        <a:a name="SYMBOLICNAMEVALUE" value="false" />
                        <a:a name="LABEL" value="McuPLLStatus" />
                        <a:a name="UUID" value="ECUC:bd0b5d55-9c12-432d-a8b8-86bcefbfc063" />
                        <a:da name="DEFAULT" value="true" />
                      <a:a name="ENABLE" value="true" />
                      <a:da name="INVALID" type="XPath">
                          <a:tst expr="(node:fallback(../McuStartRunMode,'DRUN') ='SAFE') and (. = 'true')" true="In SAFE mode the PLL is always turned off." />
                       </a:da>
                   </v:var>
                  <v:var name="VoltageRegulator" type="BOOLEAN">
                      <a:a name="DESC">
                        <a:v>
                              <![CDATA[EN:
                              <html>
                      <p> Put the  <b>Main Voltage Regulator </b> in  <b>ON </b> or
                      <b>OFF </b> state.</p>   </html>
                         ]]></a:v>
                       </a:a>
                       <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                           <icc:v class="PreCompile">VariantPreCompile</icc:v>
                           <icc:v class="PostBuild">VariantPostBuild</icc:v>
                       </a:a>
                       <a:a name="ORIGIN" value="Freescale"/>
                       <a:a name="LABEL" value="Voltage Regulator"/>
                       <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                       <a:a name="UUID" value="ECUC:ee043f9c-8b26-4b22-9de1-2ac568ab676f"/>
                        <a:da name="ENABLE" type="XPath">
                          <a:tst expr="../McuStartRunMode='STOP'" />
                        </a:da>
                      <a:a name="ENABLE" value="true" />
                      <a:da name="INVALID" type="XPath">
                          <a:tst expr="(node:fallback(../McuStartRunMode,'DRUN') !='STOP') and (.='false')" true="The voltage regulator can be turned off only in STOP mode." />
                       </a:da>
                       <a:da name="DEFAULT" value="true" />
                  </v:var>
                  <v:var name="McuCodeFlashStatus" type="ENUMERATION">
                     <a:a name="DESC">
                     <a:v><![CDATA[EN:
                      <html>
                          <p> Select the Code Flash Status in new operative Mode. </p>
                          <p> Note: Implementation specific Parameter .</p>
                      </html>
                                                      ]]></a:v>
                      </a:a>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v class="PreCompile">VariantPreCompile</icc:v>
                              <icc:v class="PostBuild">VariantPostBuild</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="Freescale" />
                      <a:a name="SYMBOLICNAMEVALUE" value="false" />
                      <a:a name="UUID" value="ECUC:8a8707ed-b5b6-4970-8f65-bdef39776dbd" />
                      <a:da name="DEFAULT" value="NormalMode" />
                      <a:a name="LABEL" value="Code Flash Status" />
                      <a:da name="RANGE">
                             <a:v>PowerDown</a:v>
                             <a:v>LowPower</a:v>
                             <a:v>NormalMode</a:v>
                      </a:da>
                      <a:a name="ENABLE" value="true" />
                      <a:da name="INVALID" type="XPath">
                          <a:tst expr="(node:fallback(../McuStartRunMode,'DRUN') ='SAFE') and (. != 'NormalMode')" true="In SAFE mode the operating mode of the code flash can be  set only to normal mode." />
                       </a:da>
                   </v:var>
                        <v:var name="McuDataFlashStatus" type="ENUMERATION">
                          <a:a name="DESC">
                            <a:v><![CDATA[EN:
                             <html>
                               <p> Select the Data Flash Status in new operative Mode. Note: Implementation specific Parameter.
                               </p></html>
                             ]]></a:v>
                          </a:a>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v class="PreCompile">VariantPreCompile</icc:v>
                            <icc:v class="PostBuild">VariantPostBuild</icc:v>
                          </a:a>
                          <a:a name="ORIGIN" value="Freescale"/>
                          <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                          <a:a name="UUID" value="ECUC:30d000e9-a4b5-4b7c-af93-7df72ed5ecbe"/>
                          <a:da name="DEFAULT" value="NormalMode"/>
                          <a:a name="LABEL" value="Data Flash Status" />
                          <a:da name="RANGE">
                            <a:v>PowerDown</a:v>
                            <a:v>LowPower</a:v>
                            <a:v>NormalMode</a:v>
                          </a:da>
                      <a:a name="ENABLE" value="true" />
                      <a:da name="INVALID" type="XPath">
                          <a:tst expr="(node:fallback(../McuStartRunMode,'DRUN') ='SAFE') and (. != 'NormalMode')" true="In SAFE mode the operating mode of the data flash can be  set only to normal mode." />
                          <a:tst expr="((ecu:get('MCU.DFLASH.Has_LowPower') = 'false') and (. = 'LowPower'))" true="DFlash low power mode is not available for this derivative"/>
                       </a:da>
                        </v:var>
                   <v:var name="McuRC16MHzOscillator" type="BOOLEAN">
                     <a:a name="DESC">
                         <a:v><![CDATA[EN:
                          <html>
                          <p> Put the RC Oscillator in ON or OFF state. This parameter is configurable when the McuStartRunModeMode is configured as 'HALT' or ' STANDBY' or 'STOP' modes. </p>
                          <p> Note: Implementation specific Parameter .</p>
                           </html>
                        ]]></a:v>
                      </a:a>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v class="PreCompile">VariantPreCompile</icc:v>
                              <icc:v class="PostBuild">VariantPostBuild</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="Freescale" />
                      <a:a name="SYMBOLICNAMEVALUE" value="false" />
                      <a:a name="UUID" value="ECUC:fb4eb675-07c0-49d5-b3eb-16ce437ba38d" />
                      <a:da name="DEFAULT" value="true" />
                      <a:a name="LABEL" value="RC 16MHz" />
                      <a:a name="ENABLE" value="true" />
                      <a:da name="INVALID" type="XPath">
                          <a:tst expr="(node:fallback(.,'true') ='false') and ((node:fallback(../McuStartRunMode,'DRUN') !='HALT') and (node:fallback(../McuStartRunMode,'DRUN') !='STOP') and (node:fallback(../McuStartRunMode,'DRUN') !='STANDBY'))" true="The internal RC oscillator cannot be turned off for the mode selected in the 'RUN Mode' parameter" />
                       </a:da>
                  </v:var>
                  <v:var name="McuOutputPowerDownControl" type="BOOLEAN">
                      <a:a name="DESC">
                      <a:v><![CDATA[EN:
                        <html>
                          <p>Output power-down status:This bit controls the output power-down of I/Os. </p>
                          <p>This parameter is configurable only when McuStartRunMode is configured as SAFE/TEST/ STOP0 mode.</p>
                          <p>Disabled - No automatic safe gating of I/Os used and pads power sequence driver is enabled.</p>
                          <p>Enabled - In SAFE/TEST modes, outputs of pads are forced to high impedance state and pads power sequence driver is disabled. The inputs are level unchanged.
                          In STOP0 mode, only the pad power sequence driver is disabled, but the state of the output remains functional.
                          </p>
                          <p> Note: Implementation specific Parameter .</p>
                        </html>
                      ]]></a:v>
                      </a:a>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v class="PreCompile">VariantPreCompile</icc:v>
                              <icc:v class="PostBuild">VariantPostBuild</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="Freescale" />
                      <a:a name="SYMBOLICNAMEVALUE" value="false" />
                      <a:a name="LABEL" value="Output Power Down Control" />
                      <a:a name="UUID" value="ECUC:d0b4e47d-cee4-4dac-aeda-c71c9ccd7b7c" />
                      <a:da name="DEFAULT" value="false" />
                      <a:a name="ENABLE" value="true" />
                      <a:da name="INVALID" type="XPath">
                           <a:tst expr="((node:fallback(../McuStartRunMode,'DRUN') !='SAFE') and (node:fallback(../McuStartRunMode,'DRUN') !='STOP')) and (node:fallback(.,'true') ='true')" true="The Output power down control can be enabled only in SAFE  mode." />
                       </a:da>
                   </v:var>
               </v:ctr>
                      <v:lst name="McuClockReferencePoint" type="MAP">
                        <a:da name="MIN" value="1"/>
                        <!-- /** @requirements MCU174_Conf */ -->
                        <!-- @implements DMCU01024  -->
                        <v:ctr name="McuClockReferencePoint" type="IDENTIFIABLE">
                          <a:a name="DESC">
                           <a:v><![CDATA[EN:
                               <html>
                               <p>This container defines a reference point in the Mcu Clock tree. It defines the frequency which then can be used by other modules as an input value. Lower multiplicity is 1, as even in the simpliest case (only one frequency is used), there is one frequency to be defined. </p>
                               </html>
                             ]]></a:v>
                          </a:a>
                          <a:a name="UUID"
                               value="ECUC:4e606525-9ba5-4970-bcb8-591436e8bebe"/>
                          <!-- /** @requirements MCU175_Conf */ -->
                          <!-- @implements DMCU01025  -->
                          <v:var name="McuClockReferencePointFrequency" type="FLOAT">
                             <a:a name="DESC">
                                  <a:v><![CDATA[EN:
                               <html>
                                 <p> This is the frequency for the specific instance of the McuClockReferencePoint container. It shall be given in Hz.
                                 McuClockReferencePointFrequency has to be less than or equal to 64 MHz (or 48MHz for Bolero 256K). </p>
                               </html>
                               ]]></a:v>
                            </a:a>
                            <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                              <icc:v class="PostBuild">VariantPostBuild</icc:v>
                              <icc:v class="PreCompile">VariantPreCompile</icc:v>
                            </a:a>
                            <a:a name="LABEL" value="Mcu Clock Reference Point Frequency" />
                            <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                            <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                            <a:a name="UUID" value="ECUC:3cfa53de-6e74-4133-a7eb-92d7cb414a15"/>
                            <a:da name="DEFAULT" type="XPath">
                                <a:tst expr="num:i(number(node:fallback(../McuClockFrequencySelect,'SystemClockFrequency')='SystemClockFrequency')* (node:fallback(../../../McuSystemClockFrequency,64000000)) +number(node:fallback(../McuClockFrequencySelect,'SystemClockFrequency')='PeripheralSet0clock') *node:fallback(../../../McuSystemClockFrequency,64000000) div (1 + number(node:fallback(../../../McuPeripheralClkSet_0/McuPeripheralEnableClk,'false')='true') * (node:fallback(../../../McuPeripheralClkSet_0/McuPeripheralDivisorFactor,'1')-1)) +number(node:fallback(../McuClockFrequencySelect,'SystemClockFrequency')='PeripheralSet1clock') *node:fallback(../../../McuSystemClockFrequency,64000000) div(1 + number(node:fallback(../../../McuPeripheralClkSet_1/McuPeripheralEnableClk,'false')='true') *(node:fallback(../../../McuPeripheralClkSet_1/McuPeripheralDivisorFactor,'1')-1)) + number(node:fallback(../McuClockFrequencySelect,'SystemClockFrequency')='PeripheralSet2clock') *node:fallback(../../../McuSystemClockFrequency,64000000) div(1 + number(node:fallback(../../../McuPeripheralClkSet_2/McuPeripheralEnableClk,'false')='true') * (node:fallback(../../../McuPeripheralClkSet_2/McuPeripheralDivisorFactor,'1')-1)) +  number(node:fallback(../McuClockFrequencySelect,'SystemClockFrequency')='eMiosA_clk_freq') *node:fallback(../../../McuSystemClockFrequency,64000000) div((1 + number(node:fallback(../../../McuPeripheralClkSet_2/McuPeripheralEnableClk,'false')='true') * (node:fallback(../../../McuPeripheralClkSet_2/McuPeripheralDivisorFactor,'1')-1)) * (1 + number(node:fallback(../../../McuEMIOSSettings_A/GlobalPrescalerEnable,'false')='true') * (node:fallback(../../../McuEMIOSSettings_A/GlobalPrescaler,'1')))) + number(node:fallback(../McuClockFrequencySelect,'SystemClockFrequency')='eMiosB_clk_freq') *node:fallback(../../../McuSystemClockFrequency,64000000) div((1 + number(node:fallback(../../../McuPeripheralClkSet_2/McuPeripheralEnableClk,'false')='true') * (node:fallback(../../../McuPeripheralClkSet_2/McuPeripheralDivisorFactor,'1')-1))* (1 + number(node:fallback(../../../McuEMIOSSettings_B/GlobalPrescalerEnable,'false')='true') * (node:fallback(../../../McuEMIOSSettings_B/GlobalPrescaler,'1')))) + number(node:fallback(../McuClockFrequencySelect,'SystemClockFrequency')='Xtal_A') * node:fallback(../../../../../FrequencyOfFXOSC,8000000) div(node:fallback(../../../McuXtal_A/McuXtalDivisor,'1')) + number(node:fallback(../McuClockFrequencySelect,'SystemClockFrequency')='Xtal_B_32KHz') * 32000 div(node:fallback(../../../McuXtal_B_32KHz/McuXtalDivisor,'1')) + number(node:fallback(../McuClockFrequencySelect,'SystemClockFrequency')='RC_16MHz') * 16000000 div(node:fallback(../../../McuRC_16MHz/McuRCDivisor,'1')) + number(node:fallback(../McuClockFrequencySelect,'SystemClockFrequency')='RC_128KHz') * 128000 div(node:fallback(../../../McuRC_128KHz/McuRCDivisor,'1')) )" />
                               </a:da>
                          <a:a name="RANGE" type="XPath">
                           <a:tst expr="((not(node:empty(.))) and (. != num:i(number(node:fallback(../McuClockFrequencySelect,'SystemClockFrequency')='SystemClockFrequency')* (node:fallback(../../../McuSystemClockFrequency,64000000)) +number(node:fallback(../McuClockFrequencySelect,'SystemClockFrequency')='PeripheralSet0clock') *node:fallback(../../../McuSystemClockFrequency,64000000) div (1 + number(node:fallback(../../../McuPeripheralClkSet_0/McuPeripheralEnableClk,'false')='true') * (node:fallback(../../../McuPeripheralClkSet_0/McuPeripheralDivisorFactor,'1')-1)) +number(node:fallback(../McuClockFrequencySelect,'SystemClockFrequency')='PeripheralSet1clock') *node:fallback(../../../McuSystemClockFrequency,64000000) div(1 + number(node:fallback(../../../McuPeripheralClkSet_1/McuPeripheralEnableClk,'false')='true') *(node:fallback(../../../McuPeripheralClkSet_1/McuPeripheralDivisorFactor,'1')-1)) + number(node:fallback(../McuClockFrequencySelect,'SystemClockFrequency')='PeripheralSet2clock') *node:fallback(../../../McuSystemClockFrequency,64000000) div(1 + number(node:fallback(../../../McuPeripheralClkSet_2/McuPeripheralEnableClk,'false')='true') * (node:fallback(../../../McuPeripheralClkSet_2/McuPeripheralDivisorFactor,'1')-1)) +  number(node:fallback(../McuClockFrequencySelect,'SystemClockFrequency')='eMiosA_clk_freq') *node:fallback(../../../McuSystemClockFrequency,64000000) div((1 + number(node:fallback(../../../McuPeripheralClkSet_2/McuPeripheralEnableClk,'false')='true') * (node:fallback(../../../McuPeripheralClkSet_2/McuPeripheralDivisorFactor,'1')-1)) * (1 + number(node:fallback(../../../McuEMIOSSettings_A/GlobalPrescalerEnable,'false')='true') * (node:fallback(../../../McuEMIOSSettings_A/GlobalPrescaler,'1')))) + number(node:fallback(../McuClockFrequencySelect,'SystemClockFrequency')='eMiosB_clk_freq') *node:fallback(../../../McuSystemClockFrequency,64000000) div((1 + number(node:fallback(../../../McuPeripheralClkSet_2/McuPeripheralEnableClk,'false')='true') * (node:fallback(../../../McuPeripheralClkSet_2/McuPeripheralDivisorFactor,'1')-1))* (1 + number(node:fallback(../../../McuEMIOSSettings_B/GlobalPrescalerEnable,'false')='true') * (node:fallback(../../../McuEMIOSSettings_B/GlobalPrescaler,'1')))) + number(node:fallback(../McuClockFrequencySelect,'SystemClockFrequency')='Xtal_A') * node:fallback(../../../../../FrequencyOfFXOSC,8000000) div(node:fallback(../../../McuXtal_A/McuXtalDivisor,'1')) + number(node:fallback(../McuClockFrequencySelect,'SystemClockFrequency')='Xtal_B_32KHz') * 32000 div(node:fallback(../../../McuXtal_B_32KHz/McuXtalDivisor,'1')) + number(node:fallback(../McuClockFrequencySelect,'SystemClockFrequency')='RC_16MHz') * 16000000 div(node:fallback(../../../McuRC_16MHz/McuRCDivisor,'1')) + number(node:fallback(../McuClockFrequencySelect,'SystemClockFrequency')='RC_128KHz') * 128000 div(node:fallback(../../../McuRC_128KHz/McuRCDivisor,'1')) )  ))" true="Please press the button to calculate the value automatically." />
                            </a:a>
                            <a:a name="INVALID" type="Range">
                                <a:tst expr="&lt;=ecu:get('Mcu.McuClockReferencePointFrequency.MaxClockFrequency')"/>
                                <a:tst expr="&gt;=0" />
                            </a:a>
                          </v:var>
                         <v:var name="McuClockFrequencySelect" type="ENUMERATION">
                           <a:a name="LABEL" value="Mcu Clock Frequency Select" />
                           <a:a name="DESC">
                                <a:v>
                                <![CDATA[EN:  <html> <p>Select the source of your reference clock frequency. </p>
                                <p>Note: Implementation specific Parameter.</p>
                                </html> ]]></a:v>
                           </a:a>
                           <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                             <icc:v class="PreCompile">VariantPreCompile</icc:v>
                             <icc:v class="PostBuild">VariantPostBuild</icc:v>
                           </a:a>
                           <a:a name="ORIGIN" value="Freescale"/>
                           <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                           <a:a name="UUID" value="ECUC:7b2cdd2c-6b17-43f7-8d66-50174d99524d"/>
                           <a:da name="DEFAULT" value="SystemClockFrequency"/>
                           <a:da name="RANGE" type="XPath" expr="ecu:list('MCU.McuClockFrequencySelect.List')" />
                           <a:da name="INVALID" type="XPath">
                                 <a:tst expr="((.='PeripheralSet0clock') and (../../../McuPeripheralClkSet_0/McuPeripheralEnableClk='false'))"
                                         true=" Error: Peripheral set 0 clock should be enabled."/>
                                 <a:tst expr="((.='PeripheralSet0clock') and (../McuClockReferencePointFrequency &gt; ecu:get('Mcu.McuClockReferencePointFrequency.MaxClockFrequency')))"
                                         true=" Error: Peripheral set 0 clock frequency should be less than 'Mcu.McuClockReferencePointFrequency.MaxClockFrequency' in Hz."/>
                                 <a:tst expr="((.='PeripheralSet1clock') and (../../../McuPeripheralClkSet_1/McuPeripheralEnableClk='false'))"
                                         true=" Error: Peripheral set 1 clock should be enabled."/>
                                 <a:tst expr="((.='PeripheralSet1clock') and (../McuClockReferencePointFrequency &gt; ecu:get('Mcu.McuClockReferencePointFrequency.MaxClockFrequency')))"
                                         true=" Error: Peripheral set 1 clock frequency should be less than 'Mcu.McuClockReferencePointFrequency.MaxClockFrequency' in Hz."/>
                                 <a:tst expr="((.='PeripheralSet2clock') and (../../../McuPeripheralClkSet_2/McuPeripheralEnableClk='false'))"
                                         true=" Error: Peripheral set 2 clock should be enabled."/>
                                 <a:tst expr="((.='PeripheralSet2clock') and (../McuClockReferencePointFrequency &gt; ecu:get('Mcu.McuClockReferencePointFrequency.MaxClockFrequency')))"
                                         true=" Error: Peripheral set 2 clock frequency should be less than 'Mcu.McuClockReferencePointFrequency.MaxClockFrequency' in Hz."/>
                                 <a:tst expr="((.='eMiosA_clk_freq') and (../../../McuPeripheralClkSet_2/McuPeripheralEnableClk='false'))"
                                         true=" Error: Peripheral set 2 clock should be enabled."/>
                                 <a:tst expr="((.='eMiosA_clk_freq') and (../McuClockReferencePointFrequency &gt; ecu:get('Mcu.McuClockReferencePointFrequency.MaxClockFrequency')))"
                                         true=" Error: eMiosA clock frequency should be less than 'Mcu.McuClockReferencePointFrequency.MaxClockFrequency' in Hz."/>
                                 <a:tst expr="((.='eMiosB_clk_freq') and (../../../McuPeripheralClkSet_2/McuPeripheralEnableClk='false'))"
                                         true=" Error: Peripheral set 2 clock should be enabled."/>
                                 <a:tst expr="((.='eMiosB_clk_freq') and (../McuClockReferencePointFrequency &gt; ecu:get('Mcu.McuClockReferencePointFrequency.MaxClockFrequency')))"
                                         true=" Error: eMiosB clock frequency should be less than 64MHz."/>
                                 <a:tst expr="((.='Xtal_A') and (../../../GeneralClockSettings/McuOSC='false'))"
                                         true=" Error: The fast external oscillator should be enabled."/>
                                 <a:tst expr="((.='Xtal_B_32KHz') and (../../..//McuXtal_B_32KHz/McuXtalOn='false'))"
                                         true=" Error: The slow external oscillator should be enabled."/>
                           </a:da>
                         </v:var>
                        </v:ctr>
                      </v:lst>

                <v:ctr name="McuXtal_A" type="IDENTIFIABLE">
                  <a:a name="TAB" value="McuXtal_A" />
                  <a:a name="LABEL" value="Mcu Xtal A" />
                  <a:a name="DESC">
                    <a:v>
                      <![CDATA[EN:
                      <html>
                        <p> This container contains the SPECIFIC configuration (parameters) of the MCU XOSC (External Oscillator) Configuration.</p>
                        <p>Note: Implementation specific Container.</p>
                      </html>
                      ]]>
                    </a:v>
                  </a:a>
                  <a:a name="UUID" value="ECUC:298909f8-e1fd-408e-a6c1-3d4dd1239d40" />
                  <v:var name="McuXtalByPass" type="BOOLEAN">
                    <a:a name="DESC">
                      <a:v>
                        <![CDATA[EN:
                        <html>
                          <p> If flagged Bypass the XTAL internal circuit.</p>
                          <p> Note: Implementation specific Parameter .</p>
                        </html>
                        ]]>
                      </a:v>
                    </a:a>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v class="PreCompile">VariantPreCompile</icc:v>
                      <icc:v class="PostBuild">VariantPostBuild</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="Freescale" />
                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                    <a:a name="LABEL" value="ByPass XTAL Circuits" />
                    <a:a name="UUID" value="ECUC:ff967a84-0048-4415-ab06-1f08f44c5b0c" />
                    <a:da name="DEFAULT" value="false" />
                    <a:a name="ENABLE" value="true" />
                  </v:var>
                  <v:var name="McuXtalCounterOscillator" type="INTEGER">
                    <a:a name="DESC">
                      <a:v>
                        <![CDATA[EN:
                        <html>
                          <p> When the internal counter reaches the value  the oscillator is stable.</p>
                          <p>Note: Implementation specific Parameter . This parameter value will not be considered when theMcuXtalByPass is true.</p>
                        </html>
                        ]]>
                      </a:v>
                    </a:a>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v class="PreCompile">VariantPreCompile</icc:v>
                      <icc:v class="PostBuild">VariantPostBuild</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="Freescale" />
                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                    <a:a name="LABEL" value="Mcu Counter Oscillator Value" />
                    <a:a name="UUID" value="ECUC:6d5ef8e3-a040-4ebc-9384-f7e14ecfe41b" />
                    <a:da name="DEFAULT" value="100" />
                    <a:a name="ENABLE" value="true" />
                    <a:a name="INVALID" type="Range">
                      <a:tst expr="&lt;=255" />
                      <a:tst expr="&gt;=0" />
                    </a:a>
                  </v:var>
                  <v:var name="McuXtalMaskInterrupt" type="BOOLEAN">
                    <a:a name="DESC">
                      <a:v>
                        <![CDATA[EN:
                        <html>
                          <p> Check if  want  to enable Interrupts for XTAL_A. This parameter value (true/false) will not be considered when theMcuXtalByPass is true. </p>
                          <p> Note: Implementation specific Parameter . </p>
                        </html>
                        ]]>
                      </a:v>
                    </a:a>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v class="PreCompile">VariantPreCompile</icc:v>
                      <icc:v class="PostBuild">VariantPostBuild</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="Freescale" />
                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                    <a:a name="LABEL" value="Xtal Mask Interrupt Status" />
                    <a:a name="UUID" value="ECUC:c20ac5cb-25e3-47ea-984c-a55aaf6b7e70" />
                    <a:da name="DEFAULT" value="false" />
                    <a:a name="ENABLE" value="true" />
                  </v:var>

                  <v:var name="McuXtalDivisor" type="INTEGER">
                    <a:a name="DESC">
                      <a:v>
                        <![CDATA[EN:
                        <html>
                          <p> Set the Divisor factor for XTAL signal </p>
                          <p> Note: Implementation specific Parameter . </p>
                        </html>
                        ]]>
                      </a:v>
                    </a:a>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v class="PreCompile">VariantPreCompile</icc:v>
                      <icc:v class="PostBuild">VariantPostBuild</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="Freescale" />
                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                    <a:a name="LABEL" value="Xtal Divisor" />
                    <a:a name="UUID" value="ECUC:c20ac5cb-25e4-47ea-984c-a55aaf6b7e70" />
                    <a:da name="DEFAULT" value="1" />
                    <a:a name="ENABLE" value="true" />
                    <a:a name="INVALID" type="Range">
                      <a:tst expr="&lt;=32"/>
                      <a:tst expr="&gt;=1"/>
                    </a:a>
                  </v:var>
                </v:ctr>

                <v:ctr name="McuXtal_B_32KHz" type="IDENTIFIABLE">
                  <a:a name="TAB" value="McuXtal_B_32KHz" />
                  <a:a name="LABEL" value="McuXtal B 32KHz" />
                  <a:a name="DESC">
                    <a:v>
                      <![CDATA[EN:
                      <html>
                        <p> This container contains the SPECIFIC configuration (parameters) of the MCU XOSC (External Oscillator) Configuration.</p>
                        <p> 32KHz oscillator is not present for 256K derivatives. These configurations will not be effective for 256K derivatives.</p>
                        <p>Note: Implementation specific Container.</p>
                      </html>
                      ]]>
                    </a:v>
                  </a:a>
                  <a:a name="UUID" value="ECUC:298669f8-e1fd-408e-a6c1-3d4dd1239d40" />
                  <v:var name="McuXtalByPass" type="BOOLEAN">
                    <a:a name="DESC">
                      <a:v>
                        <![CDATA[EN:
                        <html>
                          <p> If flagged Bypass the XTAL internal circuit.</p>
                          <p> Note: Implementation specific Parameter .</p>
                        </html>
                        ]]>
                      </a:v>
                    </a:a>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v class="PreCompile">VariantPreCompile</icc:v>
                      <icc:v class="PostBuild">VariantPostBuild</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="Freescale" />
                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                    <a:a name="LABEL" value="ByPass XTAL Circuits" />
                    <a:a name="UUID" value="ECUC:ff933a84-0048-4415-ab06-1f08f44c5b0c" />
                    <a:da name="DEFAULT" value="false" />
                    <a:a name="ENABLE" value="true" />
                  </v:var>
                  <v:var name="McuXtalCounterOscillator" type="INTEGER">
                    <a:a name="DESC">
                      <a:v>
                        <![CDATA[EN:
                        <html>
                          <p> When the internal counter reaches the value  the oscillator is stable.</p>
                          <p>Note: Implementation specific Parameter . This parameter value will not be considered when theMcuXtalByPass is true.</p>
                        </html>
                        ]]>
                      </a:v>
                    </a:a>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v class="PreCompile">VariantPreCompile</icc:v>
                      <icc:v class="PostBuild">VariantPostBuild</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="Freescale" />
                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                    <a:a name="LABEL" value="Mcu Counter Oscillator Value" />
                    <a:a name="UUID" value="ECUC:6d5ef8e3-a332-4ebc-9384-f7e14ecfe41b" />
                    <a:da name="DEFAULT" value="100" />
                    <a:a name="ENABLE" value="true" />
                    <a:a name="INVALID" type="Range">
                      <a:tst expr="&lt;=255" />
                      <a:tst expr="&gt;=0" />
                    </a:a>
                  </v:var>
                  <v:var name="McuXtalMaskInterrupt" type="BOOLEAN">
                    <a:a name="DESC">
                      <a:v>
                        <![CDATA[EN:
                        <html>
                          <p> Check if  want  to enable Interrupts for XTAL_A. This parameter value (true/false) will not be considered when theMcuXtalByPass is true. </p>
                          <p> Note: Implementation specific Parameter . </p>
                        </html>
                        ]]>
                      </a:v>
                    </a:a>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v class="PreCompile">VariantPreCompile</icc:v>
                      <icc:v class="PostBuild">VariantPostBuild</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="Freescale" />
                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                    <a:a name="LABEL" value="Xtal Mask Interrupt Status" />
                    <a:a name="UUID" value="ECUC:c20cbccb-25e3-47ea-984c-a55aaf6b7e70" />
                    <a:da name="DEFAULT" value="false" />
                    <a:a name="ENABLE" value="true" />
                  </v:var>

                  <v:var name="McuXtalDivisor" type="INTEGER">
                    <a:a name="DESC">
                      <a:v>
                        <![CDATA[EN:
                        <html>
                          <p> Set the Divisor factor for the slow external XTAL clock source </p>
                          <p> Note: Implementation specific Parameter . </p>
                        </html>
                        ]]>
                      </a:v>
                    </a:a>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v class="PreCompile">VariantPreCompile</icc:v>
                      <icc:v class="PostBuild">VariantPostBuild</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="Freescale" />
                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                    <a:a name="LABEL" value="Xtal Divisor" />
                    <a:a name="UUID" value="ECUC:c20ac6ab-25e4-47ea-984c-a55aaf6b7e70" />
                    <a:da name="DEFAULT" value="1" />
                    <a:a name="ENABLE" value="true" />
                    <a:a name="INVALID" type="Range">
                       <a:tst expr="&lt;=32"/>
                       <a:tst expr="&gt;=1"/>
                    </a:a>
                  </v:var>

                  <v:var name="McuXtalOn" type="BOOLEAN">
                    <a:a name="DESC">
                      <a:v>
                        <![CDATA[EN:
                        <html>
                          <p> The XTAL circuit configurable for ON or OFF</p>
                          <p> Note: Implementation specific Parameter . </p>
                        </html>
                        ]]>
                      </a:v>
                    </a:a>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v class="PreCompile">VariantPreCompile</icc:v>
                      <icc:v class="PostBuild">VariantPostBuild</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="Freescale" />
                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                    <a:a name="LABEL" value="Xtal On" />
                    <a:a name="UUID" value="ECUC:c20ac5cb-25e4-47ea-984c-a55aaf6baa70" />
                    <a:da name="DEFAULT" value="false" />
                    <a:a name="ENABLE" value="true" />
                  </v:var>
                </v:ctr>

                <v:ctr name="McuRC_16MHz" type="IDENTIFIABLE">
                  <a:a name="LABEL" value="Mcu RC 16MHz" />
                  <a:a name="DESC">
                    <a:v>
                      <![CDATA[EN:
                      <html>
                        <p> This container contains the SPECIFIC configuration (parameters) of the Internal 16MHz Oscillator(MIRC16M) Configuration.</p>
                        <p>Note: Implementation specific Container.</p>
                      </html>
                      ]]>
                    </a:v>
                  </a:a>
                  <a:a name="TAB" value="McuRC_16MHz" />
                  <a:a name="LABEL" value="Mcu RC 16MHz" />
                  <a:a name="UUID" value="ECUC:a931b16d-0a13-4e35-9990-adc14dc849ac" />
                  <v:var name="McuRCDivisor" type="INTEGER">
                    <a:a name="DESC">
                      <a:v>
                        <![CDATA[EN:
                        <html>
                          <p> Set the divisor factor for RC16MHz signal </p>
                          <p> Note: Implementation specific Parameter . </p>
                        </html>
                        ]]>
                      </a:v>
                    </a:a>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v class="PreCompile">VariantPreCompile</icc:v>
                      <icc:v class="PostBuild">VariantPostBuild</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="Freescale" />
                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                    <a:a name="LABEL" value="RC Divisor" />
                    <a:a name="UUID" value="ECUC:c20ac5cb-25e4-47ea-984c-a56caf6b7e70" />
                    <a:da name="DEFAULT" value="1" />
                    <a:a name="ENABLE" value="true" />
                    <a:a name="INVALID" type="Range">
                      <a:tst expr="&lt;=32"/>
                      <a:tst expr="&gt;=1"/>
                    </a:a>
                  </v:var>
                </v:ctr>

                <v:ctr name="McuRC_128KHz" type="IDENTIFIABLE">
                  <a:a name="LABEL" value="Mcu RC 128KHz" />
                  <a:a name="DESC">
                    <a:v>
                      <![CDATA[EN:
                      <html>
                        <p> This container contains the SPECIFIC configuration (parameters) of the Internal 16MHz Oscillator(MIRC16M) Configuration.</p>
                        <p>Note: Implementation specific Container.</p>
                      </html>
                      ]]>
                    </a:v>
                  </a:a>
                  <a:a name="TAB" value="McuRC_128KHz" />
                  <a:a name="LABEL" value="Mcu RC 128KHz" />
                  <a:a name="UUID" value="ECUC:a931b16d-0bb3-4e35-9990-adc14dc849ac" />
                  <v:var name="McuRCDivisor" type="INTEGER">
                    <a:a name="DESC">
                      <a:v>
                        <![CDATA[EN:
                        <html>
                          <p> Set the divisor factor for the slow internal RC oscillator 128KHz clock source</p>
                          <p> Note: Implementation specific Parameter . </p>
                        </html>
                        ]]>
                      </a:v>
                    </a:a>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v class="PreCompile">VariantPreCompile</icc:v>
                      <icc:v class="PostBuild">VariantPostBuild</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="Freescale" />
                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                    <a:a name="LABEL" value="RC Divisor" />
                    <a:a name="UUID" value="ECUC:c20ac5cb-25e4-47ea-984c-a55aaf6b7e90" />
                    <a:da name="DEFAULT" value="1"/>
                    <a:a name="ENABLE" value="true"/>
                    <a:a name="INVALID" type="Range">
                      <a:tst expr="&lt;=32"/>
                      <a:tst expr="&gt;=1"/>
                   </a:a>
                  </v:var>
                  <v:var name="McuRCStandBy" type="BOOLEAN">
                    <a:a name="DESC">
                    <a:v><![CDATA[EN:
                    <html> 
                    <p> Check if you want enable th Oscillator in Standby mode. </p>
                    <p> Note: Implementation specific Parameter .</p>
                    </html>
                    ]]></a:v>
                     </a:a>
                      <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v class="PreCompile">VariantPreCompile</icc:v>
                      <icc:v class="PostBuild">VariantPostBuild</icc:v>
                      </a:a>
                      <a:a name="ORIGIN" value="Freescale"/>
                      <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                      <a:a name="UUID" value="ECUC:8b7d043d-36eb-4e12-95f8-e9bdaf010f0b"/>
                      <a:da name="DEFAULT" value="false"/>
                      <a:a name="ENABLE" value="true"/>
                      </v:var>
                </v:ctr>

                <v:ctr name="McuClkOutput" type="IDENTIFIABLE">
                  <a:a name="LABEL" value="Mcu Clock Output" />
                  <a:a name="DESC">
                    <a:v>
                      <![CDATA[EN:
                      <html>
                        <p> This container contains the SPECIFIC configuration (parameters) of the Clock Output Configuration. </p>
                        <p> Note: Implementation specific Container.</p>
                      </html>
                      ]]>
                    </a:v>
                  </a:a> 
                  <a:a name="TAB" value="McuClkOutput" />
                  <a:a name="LABEL" value="Mcu Clock Output" />
                  <a:a name="UUID" value="ECUC:0a64c076-3527-4217-ac16-d1ced5a67a05" />
                  <v:var name="McuClkOutput" type="BOOLEAN">
                    <a:a name="DESC">
                      <a:v>
                        <![CDATA[EN:
                        <html>
                          <p> Enable/Disable Clock Out.</p>
                          <p> The configured value of the McuClkDivisor and McuClkSource parameters will be written into the Output Clock Division Select Register only if McuClkOutput is enabled.</p>
                          <p> Note: Implementation specific Parameter.</p>
                        </html>
                        ]]>
                      </a:v>
                    </a:a>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v class="PreCompile">VariantPreCompile</icc:v>
                      <icc:v class="PostBuild">VariantPostBuild</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="Freescale" />
                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                    <a:a name="LABEL" value="Clock Output" />
                    <a:a name="UUID" value="ECUC:d5b21c11-fd50-4f4a-b158-c329312c02d7" />
                    <a:da name="DEFAULT" value="true" />
                    <a:a name="ENABLE" value="true" />
                  </v:var>
                  <v:var name="McuClkDivisor" type="ENUMERATION">
                    <a:a name="DESC">
                      <a:v>
                        <![CDATA[EN:
                        <html>
                          <p> Put the divisor value for Clock Out. </p>
                          <p> Note: Implementation specific Parameter .</p>
                        </html>
                        ]]>
                      </a:v>
                    </a:a>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v class="PreCompile">VariantPreCompile</icc:v>
                      <icc:v class="PostBuild">VariantPostBuild</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="Freescale" />
                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                    <a:a name="UUID" value="ECUC:23fc5f66-8890-43b2-897e-7f82f793f790" />
                    <a:da name="DEFAULT" value="DIV_1" />
                    <a:a name="LABEL" value="Clock Divisor" />
                    <a:a name="ENABLE" type="XPath">
                      <a:tst expr="../McuClkOutput" />
                    </a:a>
                    <a:a name="RANGE">
                      <a:v>DIV_1</a:v>
                      <a:v>DIV_2</a:v>
                      <a:v>DIV_4</a:v>
                      <a:v>DIV_8</a:v>
                    </a:a>
                  </v:var>
                  <v:var name="McuClkSource" type="ENUMERATION">
                    <a:a name="DESC">
                      <a:v>
                        <![CDATA[EN:  <html><p>Select the clock Out source.</p>
                        <p> Note: Implementation specific Parameter.</p>
                      </html> ]]></a:v>
                    </a:a>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v class="PreCompile">VariantPreCompile</icc:v>
                      <icc:v class="PostBuild">VariantPostBuild</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="Freescale" />
                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                    <a:a name="UUID" value="ECUC:812ac164-3726-4345-982b-66b51787f4ce" />
                    <a:a name="LABEL" value="Clock Source" />
                    <a:a name="ENABLE" type="XPath">
                      <a:tst expr="../McuClkOutput" />
                    </a:a>
                    <a:da name="DEFAULT" type="XPath" expr="ecu:get('MCU.OuputClock.Default')" />
                    <a:da name="RANGE" type="XPath" expr="ecu:list('MCU.OuputClock.List')" />
                  </v:var>
                </v:ctr>
                <v:ctr name="McuPll_0" type="IDENTIFIABLE">
                  <a:a name="LABEL" value="Mcu Pll 0" />
                  <a:a name="DESC">
                    <a:v>
                    <![CDATA[EN:  <html><p> This container contains the SPECIFIC configuration (parameters) of the MCU PLL Configuration.</p><p>Note: Implementation specific Container.</p> </html> ]]>
                  </a:v>
                </a:a>
                <a:a name="TAB" value="McuPll_0" />
                <a:a name="LABEL" value="Mcu Pll 0" />
                <a:a name="UUID" value="ECUC:81b130b2-8010-447e-a100-bd597d377187" />
                <v:var name="McuPllMode_0" type="ENUMERATION">
                  <a:a name="DESC">
                    <a:v>
                    <![CDATA[EN:  <html> <p>Select the PLL Mode. </p><p>Note: Implementation specific Parameter .</p> </html> ]]>
                  </a:v>
                </a:a>
                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                  <icc:v class="PreCompile">VariantPreCompile</icc:v>
                  <icc:v class="PostBuild">VariantPostBuild</icc:v>
                </a:a>
                <a:a name="ORIGIN" value="Freescale" />
                <a:a name="SYMBOLICNAMEVALUE" value="false" />
                <a:a name="UUID" value="ECUC:7fad697f-479a-4566-89e0-a8c0f4c0ac5f" />
                <a:da name="DEFAULT" value="Normal" />
                <a:a name="LABEL" value="PLL0 Mode" />
                <a:a name="RANGE">
                  <a:v>Normal</a:v>
                  <a:v>FM</a:v>
                </a:a>
                </v:var>
                <v:ctr name="McuPll0_Parameter" type="IDENTIFIABLE">
                 <a:a name="DESC">
                    <a:v>
                      <![CDATA[
                      <html>
                        <p>
                          This container contains the configuration parameters of the MCU PLL Configuration to generate System clock both in Normal and FM mode. Note: Implementation specific Container.
                        </p>
                      </html>
                      ]]>
                    </a:v>
                  </a:a>

                  <a:a name="UUID" value="ECUC:1f71c0ce-ecb9-4ae6-826d-c874823526ca" />
                  <a:a name="INVALID" type="XPath">
                    <a:tst expr="(node:fallback(PLL_0_Frequency,64000000) * node:fallback(McuOutputDivisionFactor,4) &gt; 512000000)" true="The frequency value of the VCO should be less than or equal to 512000000 Hz." />
                    <a:tst expr="(node:fallback(PLL_0_Frequency,64000000) * node:fallback(McuOutputDivisionFactor,4) &lt; 256000000)" true="The frequency value of the VCO should be greater than or equal to 256000000 Hz." />
                    <a:tst expr="(node:fallback(PLL_0_Frequency,64000000) &gt; ecu:get('Mcu.McuClockReferencePointFrequency.MaxClockFrequency'))" true="The frequency value of the Pll should be less than or equal to 'Mcu.McuClockReferencePointFrequency.MaxClockFrequency' in Hz." />
                    <a:tst expr="(node:fallback(PLL_0_Frequency,64000000) &lt; 16000000)" true="The frequency value of the Pll should be greater than or equal to 16000000 Hz." />
                  </a:a>
                  <v:var name="PLL_0_Frequency" type="INTEGER">
                    <a:a name="DESC">
                      <a:v>
                        <![CDATA[EN:
                        <html>
                          <p>
                          The Clock for <b>Pll_0 </b>.The range value is <b>[16..120]MHz </b>. It should not be edited. </p>
                          <p>Note: implementation specific parameter.</p>
                        </html>
                        ]]>
                      </a:v>
                    </a:a>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v class="PreCompile">VariantPreCompile</icc:v>
                      <icc:v class="PostBuild">VariantPostBuild</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="Freescale" />
                    <a:a name="LABEL" value="PLL0 Frequency" />
                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                    <a:a name="UUID" value="ECUC:b2fbf1d1-3619-4407-b985-abf618507736" />
                    <a:da name="DEFAULT" type="XPath">
                    <a:tst expr="num:i((node:fallback(../McuMultiplicationFactor,96)) * 
                                (node:fallback(../../../../../FrequencyOfFXOSC,8000000)) div 
                                (node:fallback(../McuInputDivisionFactor,3) * 
                                node:fallback(../McuOutputDivisionFactor,4)))"/>
                    </a:da>
                     <a:a name="RANGE" type="XPath">
                    <a:tst expr="(num:i((node:fallback(../McuMultiplicationFactor,96)) * 
                      (../../../../../FrequencyOfFXOSC)) div (node:fallback(../McuInputDivisionFactor,8) * 
                      node:fallback(../McuOutputDivisionFactor,4)) != .)" true="Please press the button to calculate the value automatically."/>
                    </a:a>
                    <a:a name="INVALID" type="XPath">
                      <a:tst expr="(node:fallback(.,64000000) &gt; ecu:get('Mcu.McuClockReferencePointFrequency.MaxClockFrequency'))" true="The frequency value of the Pll should be less than or equal to 'Mcu.McuClockReferencePointFrequency.MaxClockFrequency' in Hz." />
                      <a:tst expr="(node:fallback(.,64000000) &lt; 16000000)" true="The frequency value of the Pll should be greater than or equal to 16000000 Hz." />
                    </a:a>
                    <a:a name="INVALID" type="Range">
                      <a:tst expr="&lt;=64000000" />
                      <a:tst expr="&gt;=16000000" />
                    </a:a>
                  </v:var>
                  <v:var name="McuOutputDivisionFactor" type="INTEGER">
                    <a:a name="DESC">
                      <a:v>
                        <![CDATA[EN:  <html>
                         <p>Put the ODF factor. It is the PLL output division factor.User can provied values only 2/4/8/16.</p>
                        <p>Note: Implementation specific Parameter. </p>
                      </html> ]]></a:v>
                    </a:a>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v class="PreCompile">VariantPreCompile</icc:v>
                      <icc:v class="PostBuild">VariantPostBuild</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="Freescale" />
                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                    <a:a name="UUID" value="ECUC:fc6486eb-0c4a-4296-954a-85dbfbd1b38f" />
                    <a:da name="DEFAULT" value="4" />
                    <a:a name="LABEL" value="Output Divisor Factor (ODF)" />
                    <a:da name="INVALID" type="Range">
                      <a:tst expr="&lt;=16" />
                      <a:tst expr="&gt;=2" />
                    </a:da>
                    <a:da name="RANGE" type="XPath">
                      <a:tst expr="((. !=2) and (. !=4) and (. !=8) and (. !=16))" true="The value should be 2, 4, 8 or 16." />
                    </a:da>
                  </v:var>
                  <v:var name="McuInputDivisionFactor" type="INTEGER">
                    <a:a name="DESC">
                      <a:v>
                         <![CDATA[EN:  <html> <p>PLL Input Divisor factor(IDF): User has to provide value in the range of  [1..15] that is (IDF+1). Internally this value will be written in PLL Control register in the range of [0..14].</p>
                        <p> Note: Implementation specific Parameter.</p>
                      </html> ]]></a:v>
                    </a:a>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v class="PreCompile">VariantPreCompile</icc:v>
                      <icc:v class="PostBuild">VariantPostBuild</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="Freescale" />
                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                    <a:a name="LABEL" value="Input Divisor Factor (IDF)" />
                    <a:a name="UUID" value="ECUC:1be41292-24f9-4377-8dca-7c5d3b840118" />
                    <a:da name="DEFAULT" value="3" />
                    <a:da name="INVALID" type="Range">
                      <a:tst expr="&lt;=15" />
                      <a:tst expr="&gt;=1" />
                    </a:da>
                  </v:var>
                  <v:var name="McuMultiplicationFactor" type="INTEGER">
                    <a:a name="DESC">
                      <a:v>
                         <![CDATA[EN:  <html> <p>It sets the PLL loop division factor. Put the NDIV value in the range of [32..96]. Internally this value is written in the  PLL control register.</p>
                        <p> Note: Implementation specific Parameter .</p>
                      </html> ]]></a:v>
                    </a:a>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v class="PreCompile">VariantPreCompile</icc:v>
                      <icc:v class="PostBuild">VariantPostBuild</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="Freescale" />
                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                    <a:a name="LABEL" value="Multiplicator Factor (NDIV)" />
                    <a:a name="UUID" value="ECUC:31191f45-c495-41b6-973d-1016f62164cc" />
                    <a:da name="DEFAULT" value="96" />
                    <a:da name="INVALID" type="Range">
                      <a:tst expr="&lt;=96" />
                      <a:tst expr="&gt;=32" />
                    </a:da>
                  </v:var>
                  <v:var name="McuProgressiveClockSwitching" type="BOOLEAN">
                    <a:a name="DESC">
                      <a:v>
                        <![CDATA[EN:  <html> <p>Enable the Progressive Clock Switching. </p>
                        <p> Note: Implementation specific Parameter .</p>
                      </html> ]]></a:v>
                    </a:a>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v class="PreCompile">VariantPreCompile</icc:v>
                      <icc:v class="PostBuild">VariantPostBuild</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="Freescale" />
                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                    <a:a name="UUID" value="ECUC:b36830b3-86f7-4781-bfe0-512446ce27db" />
                    <a:da name="DEFAULT" value="false" />
                    <a:a name="LABEL" value="Progressive Clock Switching" />
                  </v:var>
                  <v:var name="McuEnableFailInterrupt" type="BOOLEAN">
                    <a:a name="DESC">
                      <a:v>
                      <![CDATA[EN:  <html> <p>Enable or Disable the Interrupt on System clock Fail. </p> <p> Note: Implementation specific Parameter .</p> </html> ]]>
                    </a:v>
                  </a:a>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v class="PreCompile">VariantPreCompile</icc:v>
                    <icc:v class="PostBuild">VariantPostBuild</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="Freescale" />
                  <a:a name="SYMBOLICNAMEVALUE" value="false" />
                  <a:a name="UUID" value="ECUC:8f4f51e1-c091-4b5e-abbe-fc13054a0965" />
                  <a:da name="DEFAULT" value="false" />
                  <a:a name="LABEL" value="Fail Interrupt" />
                </v:var>
                </v:ctr>
                <v:ctr name="McuFmPll0_Parameter" type="IDENTIFIABLE">
                  <a:a name="LABEL" value="Mcu Fm Pll 0 Parameter" />
                  <a:a name="DESC">
                    <a:v>
                      <![CDATA[
                      <html>
                        <p>
                          This container contains the additional configuration parameters of the MCU PLL Configuration in FM mode. Note: Implementation specific Container.
                        </p>
                      </html>
                      ]]>
                    </a:v>
                  </a:a>
                  <a:a name="UUID" value="ECUC:eb8d337d-4d50-41ee-77b2-7d56e7862f77" />
                  <a:a name="ENABLE" type="XPath">
                    <a:tst expr="../McuPllMode_0='FM'" />
                  </a:a>
                  <v:var name="McuModulationFrequency" type="INTEGER">
                    <a:a name="DESC">
                      <a:v>
                      <![CDATA[EN:  <html> <p>Frequency for the triangular wave modulation (Fmod). The units is in Hz. </p><p>Note: Implementation specific Parameter. The maximum configurable value for this parameter has to be configured based on the formula - Modulation frequency = ((Crystal Frequency / Input division factior) / (4*Modulation period)). It is the responsibility of the User to take of this value</p> </html> ]]>
                    </a:v>
                  </a:a>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v class="PreCompile">VariantPreCompile</icc:v>
                    <icc:v class="PostBuild">VariantPostBuild</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="Freescale" />
                  <a:a name="SYMBOLICNAMEVALUE" value="false" />
                  <a:a name="UUID" value="ECUC:fa977967-962e-477c-8985-057ba8437136" />
                  <a:da name="DEFAULT" value="4000" />
                  <a:a name="INVALID" type="XPath">
                    <a:tst expr="(node:fallback(.,64000000) &gt; ecu:get('Mcu.McuClockReferencePointFrequency.MaxClockFrequency'))" true="The Modulation frequency value of the Pll should be less than or equal to 'Mcu.McuClockReferencePointFrequency.MaxClockFrequency' in Hz." />
                  </a:a>
                  <a:a name="INVALID" type="Range">
                    <a:tst expr="&lt;=64000000" />
                    <a:tst expr="&gt;=0" />
                  </a:a>
                  <a:a name="LABEL" value="Modulation Frequency" />
                  <a:a name="RANGE" type="XPath">
                    <a:tst expr=". &lt; ((../../../../../FrequencyOfFXOSC)) div ((../../McuPll0_Parameter/McuInputDivisionFactor )* 4 * 8191)" true="Frequency is too small. Please select a proper value for this parameter as it is used for calculating Modulation period. Modulation frequency=((Reference Frequency / Input division factor) / (4*Modulation period)). The values taken by Modulation period ranges from 0 to 0x1FFF" />
                  </a:a>
                </v:var>
                <v:var name="McuPercentualModulationDepth" type="FLOAT">
                  <a:a name="DESC">
                    <a:v>
                      <![CDATA[EN:
                      <html>
                        <p> The modulation Depth value in percentage.It must be in [0.25..4]% deviation from center frequency.  </p>
                        <p>Note: Implementation specific Parameter .</p>
                      </html>
                      ]]>
                    </a:v>
                  </a:a>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v class="PreCompile">VariantPreCompile</icc:v>
                    <icc:v class="PostBuild">VariantPostBuild</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="Freescale" />
                  <a:a name="SYMBOLICNAMEVALUE" value="false" />
                  <a:a name="LABEL" value="Modulation Depth (%)" />
                  <a:a name="UUID" value="ECUC:96779d41-2f77-44b4-9d50-ac5bd6a773d8" />
                  <a:da name="DEFAULT" value="0.25" />
                  <a:a name="INVALID" type="Range">
                    <a:tst expr="&lt;=4.00" />
                    <a:tst expr="&gt;=0.25" />
                  </a:a>
                </v:var>
                <v:var name="McuSpreadSelection" type="ENUMERATION">
                  <a:a name="DESC">
                    <a:v>
                      <![CDATA[EN:
                      <html>
                        <p> Select the Spread value. </p>
                        <p>Note: Implementation specific Parameter .</p>
                      </html> ]]></a:v>
                    </a:a>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v class="PreCompile">VariantPreCompile</icc:v>
                      <icc:v class="PostBuild">VariantPostBuild</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="Freescale" />
                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                    <a:a name="LABEL" value="Spread Selection" />
                    <a:a name="UUID" value="ECUC:7613015f-bbe8-4e27-80e4-abff76990179" />
                    <a:da name="DEFAULT" value="Down_Spread" />
                    <a:da name="RANGE">
                      <a:v>Down_Spread</a:v>
                      <a:v>Center_Spread</a:v>
                    </a:da>
                  </v:var>
                </v:ctr>
                </v:ctr>


                <v:ctr name="McuEMIOSSettings_A" type="IDENTIFIABLE">
                  <a:a name="LABEL" value="EMIOS Settings A" />
                  <a:a name="DESC">
                    <a:v>
                      <![CDATA[EN:
                      <html>
                        <p>  This container enables and selects the source clocks for Motor Control and Sine Wave Generator.                                           </p>
                      </html>
                      ]]>
                    </a:v>
                  </a:a>
                  <a:a name="TAB" value="McuEMIOSSettings_A" />
                  <a:a name="LABEL" value="EMIOS Settings A" />
                  <a:a name="UUID" value="ECUC:c2471756-3206-43de-9d39-402621f3274c" />
                  <v:var name="GlobalPrescaler" type="INTEGER">
                  <a:a name="LABEL" value="Global Prescaler" />
                    <a:a name="DESC">
                      <a:v>
                        <![CDATA[EN:
                        <html>
                          <p>
                            Global Prescaler Bits (GPRE[0:7] in EMIOS_MCR_A register).
                            The bits select the clock divider value for the global prescaler.
                            The allowed values are 0 up to 255 (divide ratio 1 up to 256).
                          </p>
                          <p> Note:implementation specific parameter.</p>
                        </html>
                        ]]>
                      </a:v>
                    </a:a>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v class="PreCompile">VariantPreCompile</icc:v>
                      <icc:v class="PostBuild">VariantPostBuild</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="Freescale" />
                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                    <a:a name="UUID" value="ECUC:5275692b-b8be-4164-9f06-e5ca588e1919" />
                    <a:da name="DEFAULT" value="0" />
                    <a:a name="ENABLE" value="true" />
                    <a:da name="INVALID" type="Range">
                       <a:tst expr="&lt;=255"/>
                       <a:tst expr="&gt;=0"/>
                    </a:da>
                  </v:var>
                  <v:var name="MdisBit" type="BOOLEAN">
                    <a:a name="DESC">
                      <a:v>
                        <![CDATA[EN:
                        <html>
                          <p>
                          Check this to put the eMIOS200 in low power mode. The MDIS bit is used to stop the clock
                          of the block, except the access to registers EMIOSMCR, EMIOSOUDIS and EMIOSUCDIS.
                          </p>
                          <p> Note:implementation specific parameter.</p>
                        </html>
                        ]]>
                      </a:v>
                    </a:a>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v class="PreCompile">VariantPreCompile</icc:v>
                      <icc:v class="PostBuild">VariantPostBuild</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="Freescale" />
                    <a:a name="LABEL" value="Mdis Bit" />
                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                    <a:a name="UUID" value="ECUC:d43153fb-fef9-4172-97d1-6e5d21cf94fc" />
                    <a:da name="DEFAULT" value="true" />
                    <a:a name="ENABLE" value="true" />
                  </v:var>
                  <v:var name="GlobalTimeBaseEnable" type="BOOLEAN">
                    <a:a name="DESC">
                      <a:v>
                        <![CDATA[EN:
                        <html>
                          <p>
                            Global Time Base Enable Bit (GTBE in EMIOS_MCR register).The GTBE bit is used to export
                            a global time base enable from the module and provide a method to start time bases of several
                            blocks simultaneously.
                          </p>
                        </html>
                        ]]>
                      </a:v>
                    </a:a>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v class="PreCompile">VariantPreCompile</icc:v>
                      <icc:v class="PostBuild">VariantPostBuild</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="Freescale" />
                    <a:a name="LABEL" value="Global Time Base Enable" />
                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                    <a:a name="UUID" value="ECUC:fe333203-cde0-4456-b2f4-3ab0da4e673d" />
                    <a:da name="DEFAULT" value="true" />
                  </v:var>
                  <v:var name="FreezeBit" type="BOOLEAN">
                    <a:a name="DESC">
                      <a:v>
                        <![CDATA[EN:
                        <html>
                          <p>
                            Freeze Bit (FRZ in EMIOS_MCR_A register).Enable the eMIOS200 to freeze the registers
                            of the unified channels when debug mode is requested at MCU level. Each unified channel
                            must have FREN bit set in order to enter freeze mode.
                          </p>
                        </html>
                        ]]>
                      </a:v>
                    </a:a>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v class="PreCompile">VariantPreCompile</icc:v>
                      <icc:v class="PostBuild">VariantPostBuild</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="Freescale" />
                    <a:a name="LABEL" value="Freeze Bit" />
                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                    <a:a name="UUID" value="ECUC:d4bbb3fb-fcc9-4172-97d1-aa5d21cf94fb" />
                    <a:da name="DEFAULT" value="false" />
                  </v:var>
                  <v:var name="GlobalPrescalerEnable" type="BOOLEAN">
                    <a:a name="DESC">
                      <a:v>
                        <![CDATA[EN:
                        <html>
                          <p>
                          Select the clock source clock. </p>
                          <p>Note:implementation specific parameter.
                          </p>
                        </html>
                        ]]>
                      </a:v>
                    </a:a>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v class="PreCompile">VariantPreCompile</icc:v>
                      <icc:v class="PostBuild">VariantPostBuild</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="Freescale" />
                    <a:a name="LABEL" value="Global Prescaler Enable" />
                    <a:a name="SYMBOLICNAMEVALUE" value="false" />
                    <a:a name="UUID" value="ECUC:d4aaaafb-fcc9-4172-97d1-6e5d21cf94fb" />
                    <a:da name="DEFAULT" value="true" />
                  </v:var>
                </v:ctr>

                <v:ctr name="McuEMIOSSettings_B" type="IDENTIFIABLE">
                  <a:a name="LABEL" value="EMIOS Settings B" />
                  <a:a name="DESC">
                    <a:v>
                      <![CDATA[EN:
                      <html>
                        <p> This container enables and selects the source clocks for Motor Control and Sine Wave Generator.</p>
                        <p> EMIOS B is not present for 256K derivatives. These configurations will not be effective for 256K derivatives.</p>
                      </html>
                      ]]>
                    </a:v>
                  </a:a>
                  <a:a name="TAB" value="McuEMIOSSettings_B" />
