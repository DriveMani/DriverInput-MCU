                                                <a:tst expr="((ecu:get('Mcu.ResourceSubderivative') = 'mpc5602bxll_lqfp100' or ecu:get('Mcu.ResourceSubderivative') = 'spc560b40_lqfp100' ) or (ecu:get('Mcu.ResourceSubderivative') = 'mpc5602bxlq_lqfp144' or ecu:get('Mcu.ResourceSubderivative') = 'spc560b40_lqfp144' ) or (ecu:get('Mcu.ResourceSubderivative') = 'mpc5603bxll_lqfp100' or ecu:get('Mcu.ResourceSubderivative') = 'spc560b44_lqfp100' ) or (ecu:get('Mcu.ResourceSubderivative') = 'mpc5603bxlq_lqfp144' or ecu:get('Mcu.ResourceSubderivative') = 'spc560b44_lqfp144' ) or (ecu:get('Mcu.ResourceSubderivative') = 'mpc5604bxll_lqfp100' or ecu:get('Mcu.ResourceSubderivative') = 'spc560b50_lqfp100' ) or (ecu:get('Mcu.ResourceSubderivative') = 'mpc5604bxlq_lqfp144' or ecu:get('Mcu.ResourceSubderivative') = 'spc560b50_lqfp144' ) or (ecu:get('Mcu.ResourceSubderivative') = 'mpc5602cxll_lqfp100' or ecu:get('Mcu.ResourceSubderivative') = 'spc560c40_lqfp100' ) or (ecu:get('Mcu.ResourceSubderivative') = 'mpc5603cxll_lqfp100' or ecu:get('Mcu.ResourceSubderivative') = 'spc560c44_lqfp100' ) or (ecu:get('Mcu.ResourceSubderivative') = 'mpc5604bxmg_mapbga208' or ecu:get('Mcu.ResourceSubderivative') = 'spc560b50_mapbga208' ) or (ecu:get('Mcu.ResourceSubderivative') = 'mpc5604cxll_lqfp100' or ecu:get('Mcu.ResourceSubderivative') = 'spc560c50_lqfp100' ) or ecu:get('Mcu.ResourceSubderivative') = 'mpc5602bxlh_lqfp64' or ecu:get('Mcu.ResourceSubderivative') = 'mpc5602cxlh_lqfp64' or ecu:get('Mcu.ResourceSubderivative') = 'mpc5603bxlh_lqfp64' or ecu:get('Mcu.ResourceSubderivative') = 'mpc5603cxlh_lqfp64' or ecu:get('Mcu.ResourceSubderivative') = 'mpc5604bxlh_lqfp64' or ecu:get('Mcu.ResourceSubderivative') = 'mpc5604cxlh_lqfp64') and (.='false')" true="The External reset event cannot be disabled from triggering a reset sequence"/>
                                                </a:a>
                                            </v:var>
