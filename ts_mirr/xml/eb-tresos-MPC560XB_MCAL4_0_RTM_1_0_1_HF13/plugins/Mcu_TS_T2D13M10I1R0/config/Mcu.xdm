<?xml version='1.0'?>
<datamodel version="3.0"
           xmlns="http://www.tresos.de/_projects/DataModel2/08/root.xsd"
           xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd"
           xmlns:v="http://www.tresos.de/_projects/DataModel2/06/schema.xsd"
           xmlns:d="http://www.tresos.de/_projects/DataModel2/06/data.xsd">
<!--
*   @file    Mcu.xdm
*   @version 1.0.1
*
*   @brief   AUTOSAR Mcu - Tresos Studio plugin schema file
*   @details This file contains the schema configuration for and Mcu Tresos Studio plugin.
-->
<!--
====================================================================================================
*   Project              : AUTOSAR 4.0 MCAL
*   Platform             : PA
*   Peripheral           : MC
*   Dependencies         : none
*
*   Autosar Version      : 4.0.3
*   Autosar Revision     : ASR_REL_4_0_REV_0003
*   Autosar Conf.Variant :
*   SW Version           : 1.0.1
*   Build Version        : MPC560xB_MCAL_1_0_1_RTM_HF13_ASR_REL_4_0_REV_0003_20170719

*   (c) Copyright 2006-2016 Freescale Semiconductor Inc and STMicroelectronics
*   All Rights Reserved.
====================================================================================================
====================================================================================================
====================================================================================================
-->
  <d:ctr type="AUTOSAR" factory="autosar"
         xmlns:ad="http://www.tresos.de/_projects/DataModel2/08/admindata.xsd"
         xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd">
    <d:lst type="TOP-LEVEL-PACKAGES">
      <d:ctr name="TS_T2D13M10I1R0" type="AR-PACKAGE">
        <a:a name="UUID" value="ECUC:812226a5-a211-5373-82db-0012932c55bd"/>
        <d:lst type="ELEMENTS">
          <!-- @implements DMCU01001 -->
          <d:chc name="Mcu" type="AR-ELEMENT" value="MODULE-DEF">
            <v:ctr type="MODULE-DEF">
                <a:a name="DESC">
                                <a:v><![CDATA[EN:
                                    <html>
                                        <p> Configuration of the MicroController Unit (MCU) module .</p>
                                    </html>
                                ]]></a:v>
                            </a:a>
                      <a:a name="LOWER-MULTIPLICITY" value="1" />
                      <a:a name="UPPER-MULTIPLICITY" value="1" />
              <a:a name="RELEASE" value="asc:4.0"/>
              <a:a name="ADMIN-DATA" type="ADMIN-DATA">
                <ad:ADMIN-DATA>
                  <ad:DOC-REVISIONS>
                    <ad:DOC-REVISION>
                      <ad:REVISION-LABEL>4.1.0</ad:REVISION-LABEL>
                      <ad:ISSUED-BY>AUTOSAR</ad:ISSUED-BY>
                      <ad:DATE>2010-12-03</ad:DATE>
                    </ad:DOC-REVISION>
                  </ad:DOC-REVISIONS>
                </ad:ADMIN-DATA>
              </a:a>
              <a:a name="DESC"
                   value="EN: Configuration of the Mcu (Microcontroler Unit) module."/>
              <a:a name="LOWER-MULTIPLICITY" value="1"/>
              <a:a name="UPPER-MULTIPLICITY" value="1"/>
              <a:a name="UUID" value="ECUC:10dfc222-84b7-4b78-9ec8-801b09ec53a0"/>
              <!-- /** @requirements MCU129, MCU130 */ -->
              <!-- @implements DMCU01028 */ -->
              <v:var name="IMPLEMENTATION_CONFIG_VARIANT" type="ENUMERATION">
                <a:a name="LABEL" value="Config Variant"/>
                <a:a name="UUID" value="ECUC:bea2b389-f03a-4318-b6e0-4d99bddbf4a5"/>
                                <a:a name="DESC">
                                    <a:v><![CDATA[EN:
                                        <html>
                                            <table>
                                                <tbody>
                                                <tr>
                                                    <th>Value</th>
                                                    <th>Description</th>
                                                </tr>
                                                <tr>
                                                    <td>VariantPreCompile</td>
                                                    <td>Only precompile time configuration parameters. If Config Variant is equal to VariantPreCompile, the files Mcu_Cfg.h and Mcu_Cfg.c should be used.</td>
                                                </tr>
                                                <tr>
                                                    <td>VariantPostBuild</td>
                                                    <td>Mix of precompile and postbuild time configuration parameters. If Config Variant is equal to VariantPostBuild, the files Mcu_Cfg.h and Mcu_PBcfg.c should be used.</td>
                                                </tr>
                                                </tbody>
                                            </table>
                                        </html>
                                        ]]></a:v>
                                </a:a>
                <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                  <icc:v class="PreCompile">VariantPostBuild</icc:v>
                  <icc:v class="PreCompile">VariantPreCompile</icc:v>
                </a:a>
                <a:da name="DEFAULT" value="VariantPostBuild"/>
                <a:da name="RANGE">
                  <a:v>VariantPostBuild</a:v>
                  <a:v>VariantPreCompile</a:v>
                </a:da>
              </v:var>
              <v:ctr name="NonAutosar" type="IDENTIFIABLE">
                  <a:a name="UUID" value="ECUC:f9793957-805b-400b-921f-acc6d3289e14"/>
                  <a:a name="DESC">
                     <a:v>
                        <![CDATA[EN:
                            <html>
                                <h1>NonAutosar</h1>
                                <p>Autosar Requirements: </p>
                                <p>This container contains the global configuration parameters of the Non-Autosar Mcu driver. 
                                   This container is a MultipleConfigurationContainer, i.e. this container and 
                                   its sub-containers exist once per configuration set.</p>
                            </html>
                        ]]>
                     </a:v>
                  </a:a>
                  <v:var name="McuGetDeviceInfoApi" type="BOOLEAN">
                     <a:a name="LABEL" value="Mcu Get Device Info Api"/>
                     <a:a name="DESC" value="EN: Pre-processor switch to enable/disable the API Mcu_GetDeviceInfo."/>
                     <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                         <icc:v class="PreCompile">VariantPostBuild</icc:v>
                         <icc:v class="PreCompile">VariantPreCompile</icc:v>
                     </a:a>
                     <a:a name="ORIGIN" value="Freescale"/>
                     <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                     <a:a name="UUID" value="ECUC:ba1b5632-3b9b-41bc-b5a6-887640dfc93f"/>
                     <a:da name="DEFAULT" value="false"/>
                  </v:var>
                  <!-- @implements DMCU06059 -->
                  <v:var name="McuDisableDemReportErrorStatus" type="BOOLEAN">
                     <a:a name="LABEL" value="Mcu Disable Production Error Reporting"/>
                     <a:a name="DESC">
                      <a:v>
                        <![CDATA[EN:
                            <html>
                                <h1>McuDisableDemReportErrorStatus</h1>
                                <p>Switches the Diagnostic Error Reporting and Notification OFF.</p>
                            </html>
                        ]]>
                      </a:v>
                     </a:a>
                     <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                       <icc:v class="PreCompile">VariantPostBuild</icc:v>
                       <icc:v class="PreCompile">VariantPreCompile</icc:v>
                     </a:a>
                     <a:a name="ORIGIN" value="Freescale"/>
                     <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                     <a:a name="UUID" value="ECUC:7228a638-4009-4639-124a-bb3d9f762a7b"/>
                     <a:da name="DEFAULT" value="false"/>
                  </v:var>
                <!-- @implements PR-MCAL-3284 -->
                  <v:var name="McuSscmGetSystemStatus" type="BOOLEAN">
                     <a:a name="LABEL" value="Mcu Get System Status"/>
                     <a:a name="DESC" value="EN: Pre-processor switch to enable/disable the API Mcu_SscmGetStatus."/>
                     <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                       <icc:v class="PreCompile">VariantPostBuild</icc:v>
                       <icc:v class="PreCompile">VariantPreCompile</icc:v>
                     </a:a>
                     <a:a name="ORIGIN" value="Freescale"/>
                     <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                     <a:a name="UUID" value="ECUC:e600f3a8-67dc-44a4-823e-da88b2304d8d"/>
                     <a:da name="DEFAULT" value="false"/>
                  </v:var>
                  <!-- @implements PR-MCAL-3285, PR-MCAL-3287  -->
                  <v:var name="McuSscmGetMemConfig" type="BOOLEAN">
                     <a:a name="LABEL" value="Mcu Get Memory Configuration"/>
                     <a:a name="DESC" value="EN: Pre-processor switch to enable/disable the API Mcu_SscmGetMemConfig."/>
                     <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                       <icc:v class="PreCompile">VariantPostBuild</icc:v>
                       <icc:v class="PreCompile">VariantPreCompile</icc:v>
                     </a:a>
                     <a:a name="ORIGIN" value="Freescale"/>
                     <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                     <a:a name="UUID" value="ECUC:c301a770-5b94-4fb0-a727-52954f6bf543"/>
                     <a:da name="DEFAULT" value="false"/>
                  </v:var>
              </v:ctr>
              <!-- /** @requirements MCU118_Conf */ -->
              <!-- @implements DMCU01002  -->
              <v:ctr name="McuGeneralConfiguration" type="IDENTIFIABLE">
                              <a:a name="LABEL" value="Mcu General Configuration"/>
                                <a:a name="DESC">
                                    <a:v><![CDATA[EN:
                                        <html>
                                            <p>This container contains the configuration (parameters) of the MCU driver. </p>
                                        </html>
                                    ]]></a:v>
                                </a:a>
                <a:a name="UUID" value="ECUC:1643108b-83a9-4ff7-bbb5-1d31c57e2d29"/>
                <!-- /** @requirements MCU166_Conf */ -->
                <!-- @implements DMCU01003 -->
                <v:var name="McuDevErrorDetect" type="BOOLEAN">
                <a:a name="LABEL" value="Mcu Dev Error Detect"/>
                                    <a:a name="DESC">
                                        <a:v><![CDATA[EN:
                                            <html>
                                                <p>Pre-processor switch for enabling the development error detection and reporting to the DEM.
                                                The switch McuDevErrorDetect shall activate or deactivate the detection of all development errors.
                                                The detection of development errors is configurable (ON/OFF) at precompile time.
                                                The detection of production code errors cannot be switched off.  </p>
                                            </html>
                                        ]]></a:v>
                                    </a:a>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS"
                       type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v class="PreCompile">VariantPostBuild</icc:v>
                    <icc:v class="PreCompile">VariantPreCompile</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="ECUC:dec1dc8b-95cb-4ec3-a92b-ebcb6665f3c8"/>
                  <a:da name="DEFAULT" value="false" />
                </v:var>
                <!-- /** @requirements MCU181_Conf */ -->
                <!-- @implements DMCU01004  -->
                <v:var name="McuGetRamStateApi" type="BOOLEAN">
                  <a:a name="LABEL" value="Mcu Get Ram State Api" />
                  <a:a name="DESC"
                       value="EN: Pre-processor switch to enable/disable the API Mcu_GetRamState."/>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS"
                       type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v class="PreCompile">VariantPostBuild</icc:v>
                    <icc:v class="PreCompile">VariantPreCompile</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="ECUC:53d944c0-547f-445b-9e1c-af72e44e5fd0"/>
                  <a:da name="DEFAULT" value="false" />
                </v:var>
                <!-- /** @requirements MCU182_Conf */ -->
                <!-- @implements DMCU01005  -->
                <v:var name="McuInitClock" type="BOOLEAN">
                  <a:a name="LABEL" value="Mcu Init Clock" />
                    <a:a name="DESC">
                        <a:v><![CDATA[EN:
                            <html>
                                <p>If this parameter is set to FALSE, the clock initialization has to be disabled from the MCU driver. This concept applies when there are some write once clock registers and a bootloader is present. If this parameter is set to TRUE, the MCU driver is responsible of the clock initialization </p>
                            </html>
                        ]]></a:v>
                    </a:a>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS"
                       type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v class="PreCompile">VariantPostBuild</icc:v>
                    <icc:v class="PreCompile">VariantPreCompile</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="ECUC:ca8ede6e-c9e4-45e0-983c-c370bc6fba5e"/>
                  <a:da name="DEFAULT" value="true"/>
                </v:var>
                <!-- /** @requirements MCU180_Conf */ -->
                <!-- @implements DMCU01006  -->
                <v:var name="McuNoPll" type="BOOLEAN">
                  <a:a name="LABEL" value="Mcu No Pll" />
                    <a:a name="DESC">
                        <a:v><![CDATA[EN:
                            <html>
                                <p>This parameter shall be set True, if the H/W does not have a PLL or the PLL circuitry is enabled after the power on without S/W intervention. In this case MCU_DistributePllClock has to be disabled and  MCU_GetPllStatus has to return MCU_PLL_STATUS_UNDEFINED. Otherwise this parameters has to be set False </p>
                            </html>
                        ]]></a:v>
                    </a:a>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS"
                       type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v class="PreCompile">VariantPostBuild</icc:v>
                    <icc:v class="PreCompile">VariantPreCompile</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="ECUC:a510bcde-e003-4260-9a40-0f3af3720345"/>
                  <a:da name="DEFAULT" value="true"/>
                </v:var>
                <!-- /** @requirements MCU167_Conf */ -->
                <!-- @implements DMCU01007  -->
                <v:var name="McuPerformResetApi" type="BOOLEAN">
                 <a:a name="DESC">
                     <a:v><![CDATA[EN:
                         <html>
                    <p> Pre-processor switch to enable/disable the use of the function Mcu_PerformReset(). </p>
                    <table>
                         <tbody>
                     <tr>
                       <th>Value</th>
                       <th>Description</th>
                     </tr>
                     <tr>
                        <td>0</td>
                        <td>Mcu_PerformReset() API is not used</td>
                     </tr>
                     <tr>
                          <td>1</td>
                      <td>Mcu_PerformReset() API is used</td>
                     </tr>
                         </tbody>
                         </table>
                 </html>
                    ]]></a:v>
                  </a:a>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS"
                       type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v class="PreCompile">VariantPostBuild</icc:v>
                    <icc:v class="PreCompile">VariantPreCompile</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                  <a:a name="LABEL" value="Perform Reset API" />
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="ECUC:1ac846d4-be20-4e1d-8f5b-c4ab129f03c3"/>
                  <a:da name="DEFAULT" value="false" />
                </v:var>
                <!-- /* @requirements PR-MCAL-3133*/ -->
                <!-- @implements DMCU01031 -->
                <v:var name="McuCalloutBeforePerformReset" type="BOOLEAN">
                    <a:a name="LABEL" value="Mcu Callout Before PerformReset" />
                    <a:a name="DESC">
                        <a:v><![CDATA[EN:
                            <html>
                                <p>Check this if you want a callout function, called by MCU right before Mcu_PerformReset(). </p>
                                <p>Note:Implementation Specific Parameter</p>
                            </html>
                        ]]></a:v>
                    </a:a>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v class="PreCompile">VariantPreCompile</icc:v>
                        <icc:v class="PreCompile">VariantPostBuild</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="Freescale"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" value="ECUC:69afe146-0f7a-4b31-9b82-ff2b3f913708"/>
                    <a:da name="DEFAULT" value="false"/>
                    <a:a name="ENABLE" type="XPath">
                        <a:tst expr="../McuPerformResetApi = 'true'"/>
                    </a:a>
                </v:var>
                <!-- /* @requirements PR-MCAL-3133*/ -->
                <v:var name="McuPerformResetCallout" type="FUNCTION-NAME">
                    <a:a name="LABEL" value="Mcu Perform Reset Callout" />
                    <a:a name="DESC">
                        <a:v><![CDATA[EN:
                            <html>
                                <p>Function name of callout. The field is editable only if McuCalloutBeforePerformReset is true. </p>
                                <p>Note:Implementation Specific Parameter</p>
                            </html>
                        ]]></a:v>
                    </a:a>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v class="PreCompile">VariantPreCompile</icc:v>
                        <icc:v class="PostBuild">VariantPostBuild</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="Freescale"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" value="ECUC:b01614dc-13c6-4e20-8cb5-b73394fef867"/>
                    <a:da name="DEFAULT" value="NULL_PTR"/>
                    <a:da name="INVALID" type="XPath">
                        <a:tst expr="((.='NULL') or (.='Null') or (.='false') or (.='FALSE') or (.='null') or
                           (.='null_ptr') or (.='Null_Ptr') or (.='NULL_PTR'))"
                           true="Invalid name, it must be a valid C function name."/>
                        <a:tst expr="normalize-space(.) = '&quot;NULL_PTR&quot;' or normalize-space(.) = 'NULL_PTR' or
                           normalize-space(.) = '&quot;NULL&quot;' or normalize-space(.) = 'NULL' or
                           text:match(normalize-space(.),'^[_a-zA-Z]+[_0-9a-zA-Z]*$')"
                           false="Invalid name, it must be a valid C function name"/>
                    </a:da>
                    <a:da name="ENABLE" type="XPath">
                        <a:tst expr="../McuCalloutBeforePerformReset"/>
                    </a:da>
                </v:var>
                <!-- /** @requirements MCU168_Conf */ -->
                <!-- @implements DMCU01008 */ -->
                <v:var name="McuVersionInfoApi" type="BOOLEAN">
                  <a:a name="DESC">
                     <a:v><![CDATA[EN:
                         <html>
                             <p>Pre-processor switch to enable / disable the API to read out the modules version information. </p>
                         </html>
                     ]]></a:v>
                  </a:a>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS"
                       type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v class="PreCompile">VariantPostBuild</icc:v>
                    <icc:v class="PreCompile">VariantPreCompile</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="ECUC:5f5b293e-02ed-435f-8bef-885cc9bd9905"/>
                  <a:a name="LABEL" value="Version Info API" />
                  <a:da name="DEFAULT" value="false" />
                </v:var>
                 <v:var name="McuConfigureFlash" type="BOOLEAN">
                   <a:a name="LABEL" value="Mcu Configure Flash" />
                   <a:a name="DESC">
                     <a:v><![CDATA[EN:
                       <html>
                         <table>
                             <tbody>
                                 <tr>
                                     <th>Value</th>
                                     <th>Description</th>
                                 </tr>
                                 <tr>
                                     <td>0</td>
                                     <td>Global Flash Settings including latency timings are not configured by the driver (reset values will not be updated).</td>
                                 </tr>
                                 <tr>
                                     <td>1</td>
                                     <td>Global Flash Settings including latency timings are configured by the driver</td>
                                 </tr>
                             </tbody>
                         </table>
                         <p>Note:Implementation Specific Parameter</p>
                       </html>
                     ]]></a:v>
                   </a:a>
                   <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS"
                     xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd">
                     <icc:v class="PreCompile" xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd">VariantPreCompile</icc:v>
                     <icc:v class="PreCompile" xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd">VariantPostBuild</icc:v>
                   </a:a>
                   <a:a name="ORIGIN" value="Freescale" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                   <a:a name="SYMBOLICNAMEVALUE" value="false" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                   <a:a name="UUID" value="ECUC:a8629932-3b4c-4197-9e4c-5641619d71e7" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                   <a:da name="DEFAULT" value="true" xmlns:a="http://www.tresos.de/_projects/DataModel2/08/attribute.xsd" />
                 </v:var>
                 <v:var name="McuDmaInit" type="BOOLEAN">
                    <a:a name="LABEL" value="Mcu DMA Init" />
                    <a:a name="DESC">
                    <a:v><![CDATA[EN:
                          <html>
                              <p>If this parameter is set to FALSE, DMA initialization is not performed by MCU driver. This concept is to give possibility to application to initialize DMA by its own way.</p>
                              <p>If this parameter is set to TRUE, the MCU driver is responsible of the DMA initialization via container McuDMAMUXandEDMAConfig and McuDMA.</p>
                          </html>
                    ]]></a:v>
                    </a:a>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                        <icc:v class="PreCompile">VariantPostBuild</icc:v>
                        <icc:v class="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="Freescale"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" value="ECUC:1f306124-8c49-4deb-a5a8-0c3a0ff87020"/>
                    <a:da name="DEFAULT" value="true"/>
                  </v:var>
                 <v:var name="McuLPTransitionCheck" type="BOOLEAN">
                   <a:a name="LABEL" value="Mcu LP Transition Check" />
                   <a:a name="DESC">
                     <a:v><![CDATA[EN:
                        <html>
                         <table>
                            <tbody>
                              <tr>
                                <th>Value</th>
                                <th>Description</th>
                              </tr>
                              <tr>
                                <td>0</td>
                                <td>No check is performed for low power transition complete.</td>
                              </tr>
                              <tr>
                                <td>1</td>
                                <td>The transition to low power will be checked by driver. If DET is enabled, a DET error will be reported after the timeout loop waiting for the transition to complete will expire.</td>
                              </tr>
                            </tbody>
                           </table>
                           <p>Note:Implementation Specific Parameter</p>
                          </html>
                      ]]></a:v>
                   </a:a>
                   <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                     <icc:v class="PreCompile">VariantPreCompile</icc:v>
                     <icc:v class="PreCompile">VariantPostBuild</icc:v>
                   </a:a>
                   <a:a name="ORIGIN" value="Freescale"/>
                   <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                   <a:a name="UUID" value="ECUC:a8fe2c8d-4600-44fe-9c75-f4666ecac838"/>
                   <a:da name="DEFAULT" value="true"/>
                 </v:var>
                 <!-- /** @implements DMCU01030 */ -->
                 <v:var name="McuEnterLowPowerMode" type="BOOLEAN">
                   <a:a name="LABEL" value="Mcu Enter Low Power Mode" />
                                   <a:a name="DESC">
                                     <a:v><![CDATA[EN:
                                        <html>
                                         <table>
                                            <tbody>
                                              <tr>
                                                <th>Value</th>
                                                <th>Description</th>
                                              </tr>
                                              <tr>
                                                <td>0</td>
                                                <td>Transition to Mcu in LOW POWER mode is performed in customer function.</td>
                                              </tr>
                                              <tr>
                                                <td>1</td>
                                                <td>Transition to Mcu in LOW POWER mode is performed by Mcu_SetMode API.</td>
                                              </tr>
                                            </tbody>
                                           </table>
                                           <p>Note:Implementation Specific Parameter</p>
                                          </html>
                                      ]]></a:v>
                                   </a:a>
                   <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                     <icc:v class="PreCompile">VariantPreCompile</icc:v>
                     <icc:v class="PreCompile">VariantPostBuild</icc:v>
                   </a:a>
                   <a:a name="ORIGIN" value="Freescale"/>
                   <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                   <a:a name="UUID" value="ECUC:a8ff2c8d-4600-44fe-9c75-f4666ecac838"/>
                   <a:da name="DEFAULT" value="true"/>
                 </v:var>
                 <v:var name="McuSkipFunction" type="BOOLEAN">
                         <a:a name="DESC">
                         <a:v><![CDATA[
                        <html>
                           <p>
                                 EN: TRUE: Mcu_SkipFunction() is enabled
                                     FALSE: Mcu_SkipFunction() is disabled
                           </p>
                        </html>
                         ]]>
                         </a:v>
                         </a:a>
                         <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                         <icc:v class="PreCompile">VariantPreCompile</icc:v>
                         <icc:v class="PreCompile">VariantPostBuild</icc:v>
                         </a:a>
                         <a:a name="ORIGIN" value="Freescale"/>
                         <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                         <a:a name="UUID" value="ECUC:ad451043-0af0-4a92-b5a0-0151d09d4fb7"/>
                         <a:da name="DEFAULT" value="false"/>
                 </v:var>
                 <v:var name="McueMiosConfigureGPRENApi" type="BOOLEAN">
                     <a:a name="DESC">
                      <a:v><![CDATA[<html>
                           <p> Pre-processor switch to enable/disable the use of the function Mcu_eMios_Configure_GPREN(). </p>
                            <table>
                            <tbody>
                            <tr>
                              <th>Value</th>
                              <th>Description</th>
                            </tr>
                            <tr>
                              <td>0</td>
                              <td>Mcu_eMios_Configure_GPREN() API is not used</td>
                            </tr>
                            <tr>
                              <td>1</td>
                              <td>Mcu_eMios_Configure_GPREN() API is used</td>
                            </tr>
                           </tbody>
                         </table></html>]]></a:v>
                       </a:a>
                   <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                     <icc:v class="PreCompile">VariantPreCompile</icc:v>
                     <icc:v class="PreCompile">VariantPostBuild</icc:v>
                   </a:a>
                   <a:a name="ORIGIN" value="Freescale"/>
                   <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                   <a:a name="UUID" value="ECUC:1adf4b87-60ea-4c3e-8c07-1e85c254cc2c"/>
                   <a:da name="DEFAULT" value="false"/>
                 </v:var>
                 <v:var name="McuEnableDisableNotificationApi" type="BOOLEAN">
                  <a:a name="LABEL" value="Enable Notification Api" />
                  <a:a name="DESC">
                    <a:v>
                      <![CDATA[
                        <html>
                          <p>
                            TRUE: Notification Api is enabled
                            FALSE: Notification Api is disabled
                          </p>
                        </html>
                      ]]>
                    </a:v>
                  </a:a>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v class="PreCompile">VariantPreCompile</icc:v>
                    <icc:v class="PostBuild">VariantPostBuild</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="Freescale"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="ECUC:b7058e18-744a-4a67-9f4c-5c263eae756e"/>
                  <a:da name="DEFAULT" value="false"/>
                </v:var>
                <v:var name="McuNotification" type="FUNCTION-NAME">
                  <a:a name="LABEL" value="Mcu Clock Notification Callout" />
                  <a:a name="DESC">
                    <a:v>
                      <![CDATA[EN:
                        <html>
                          <p> Function name of callout.</p>
                          <p> Prototype: void FunctionName(uint8 cmuIndex). </p>
                          <p> param[in] cmuIndex. </p>
                          <p>   0  --> Select CMU. </p>
                          <p> The field is editable only if McuEnableDisableNotificationApi is true. </p>
                          <p> Note:Implementation Specific Parameter</p>
                        </html>
                      ]]>
                    </a:v>
                  </a:a>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                    <icc:v class="PreCompile">VariantPreCompile</icc:v>
                    <icc:v class="PostBuild">VariantPostBuild</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="Freescale"/>
                  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                  <a:a name="UUID" value="ECUC:86115182-ac88-4378-9f6b-a37bcdc1aa1e"/>
                  <a:da name="DEFAULT" value="NULL_PTR"/>
                  <a:da name="INVALID" type="XPath">
                    <a:tst expr="((.='NULL') or (.='Null') or (.='false') or (.='FALSE') or (.='null') or (.='null_ptr') or (.='Null_Ptr') or (.='NULL_PTR'))" true="Invalid name of the, it must be a valid C function name."/>
                    <a:tst expr="normalize-space(.) = '&quot;NULL_PTR&quot;' or normalize-space(.) = 'NULL_PTR' or normalize-space(.) = '&quot;NULL&quot;' or normalize-space(.) = 'NULL' or text:match(normalize-space(.),'^[_a-zA-Z]+[_0-9a-zA-Z]*$')" false="Invalid name, it must be a valid C function name"/>
                  </a:da>
                  <a:da name="ENABLE" type="XPath">
                    <a:tst expr="../McuEnableDisableNotificationApi"/>
                  </a:da>
                </v:var>
                 <v:var name="McuConfClkOutput" type="BOOLEAN">
                  <a:a name="LABEL" value="Mcu Configure Clock Output" />
                  <a:a name="DESC">
                  <a:v>
                      <![CDATA[
                        <html>
                           <p>
                             Configuration Flag to allow Enable/Disable Clock Out.
                             Note: Clock output is configured or not in Mcu_InitClock/Mcu_SetMode API. 
                             Note: Implementation specific Parameter.
                           </p>
                        </html>
                     ]]>
                  </a:v>
                  </a:a>
                  <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                     <icc:v class="PreCompile">VariantPreCompile</icc:v>
                     <icc:v class="PostBuild">VariantPostBuild</icc:v>
                  </a:a>
                  <a:a name="ORIGIN" value="Freescale" />
                  <a:a name="SYMBOLICNAMEVALUE" value="false" />
                  <a:a name="UUID" value="ECUC:d5b21c11-fd50-4f4a-b158-c198112c02d7" />
                  <a:da name="DEFAULT" value="true" />
                  <a:a name="ENABLE" value="true" />
                </v:var>
                <v:var name="McuSscmPAE" type="BOOLEAN">
                                         <a:a name="DESC">
                                                 <a:v><![CDATA[EN:
                                                      <html>
                                                       EN: TRUE: SSCM ERROR Peripheral Bus Abort Enable(PAE) is enabled
                                                       FALSE: SSCM ERROR Peripheral Bus Abort Enable(PAE) is disabled
                                                     </html>
                                         ]]></a:v>
                                         </a:a>
                                         <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                         <icc:v class="PreCompile">VariantPostBuild</icc:v>
                         <icc:v class="PreCompile">VariantPreCompile</icc:v>
                     </a:a>
                                         <a:a name="ORIGIN" value="Freescale"/>
                                         <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                         <a:a name="UUID" value="ECUC:b217bbcd-eba5-4c67-b07a-0748f51d99bb"/>
                                         <a:da name="DEFAULT" value="true"/>
                </v:var>
                <v:var name="McuSscmRAE" type="BOOLEAN">
                                         <a:a name="DESC">
                                                 <a:v><![CDATA[EN:
                                                       <html>EN: TRUE: SSCM ERROR Register Bus Abort Enable(RAE) is enabled
                                                         FALSE: SSCM ERROR Register Bus Abort Enable(RAE) is disabled
                                                       </html>
                                         ]]>
                                         </a:v>
                                         </a:a>
                                         <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                         <icc:v class="PreCompile">VariantPostBuild</icc:v>
                         <icc:v class="PreCompile">VariantPreCompile</icc:v>
                     </a:a>
                                         <a:a name="ORIGIN" value="Freescale"/>
                                         <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                                         <a:a name="UUID" value="ECUC:f4363e22-5a47-4930-bf9b-a0d4d541008d"/>
                                         <a:da name="DEFAULT" value="true"/>
                </v:var>
                <v:var name="McuDisablePeripheralDuringInitclock" type="BOOLEAN">
                   <a:a name="LABEL" value="Mcu Disable all peripherals during init clock" />
                                   <a:a name="DESC">
                                     <a:v><![CDATA[EN:
                                        <html>
                                         <p>This configuration is applicable also in case of fast transition mode. </p>
                                         <table>
                                            <tbody>
                                              <tr>
                                                <th>Value</th>
                                                <th>Description</th>
                                              </tr>
                                              <tr>
                                                <td>0</td>
                                                <td>Not recommended mode. In this case, there is no gate of peripherals (Mcu_Disable_Peripheral is not called) during Mcu_InitClock. This mode implies that it is up to application to ensure that new clock tree is applicable (see note bellowed)</td>
                                              </tr>
                                              <tr>
                                                <td>1</td>
                                                <td>It is default value: during execution of Mcu_InitClock, all peripherals will be gated via internal functions Mcu_Disable_Peripheral in order to apply new clock tree.</td>
                                              </tr>
                                            </tbody>
                                           </table>
                                           <p><b>Warning</b>: in the case that you want to remove the gate of peripheral during init clock procedure, be aware that it is up to application to check that such update of clock tree will not lead to unexpected behaviour.
                                           Indeed, hardware (and then MCU plugin) is not able to guarantee following use case due to new clock tree/configuration provided:</p>
                                           <p>-Change of system clock in new clock tree.</p>
                                           <p>-Need to change any clock dividers compared to previous clock configuration.</p>
                                           <p>-Disable CMU/eMIOS clock is impossible during init clock. Ie user must ensure that this this peripheral is well configured in new clock configuration provided.</p>
                                           <p>Note:Implementation Specific Parameter</p>
                                          </html>
                                      ]]></a:v>
                                   </a:a>
                   <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                     <icc:v class="PreCompile">VariantPreCompile</icc:v>
                     <icc:v class="PreCompile">VariantPostBuild</icc:v>
                   </a:a>
                   <a:a name="ORIGIN" value="Freescale"/>
                   <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                   <a:a name="UUID" value="ECUC:07a1611a-3905-484b-adee-4e1a37c60f45"/>
                   <a:da name="DEFAULT" value="true"/>
                 </v:var>
              </v:ctr>
              <v:lst name="McuModuleConfiguration"
                     type="MULTIPLE-CONFIGURATION-CONTAINER">
                <a:da name="MIN" value="1"/>
                <a:da name="INVALID" type="XPath">
                     <a:tst expr="(num:i(num:i(count(../McuModuleConfiguration/*))) > 1) and (../IMPLEMENTATION_CONFIG_VARIANT = 'VariantPreCompile')"
                            true =" For Variant PreCompile, only 1 ' McuModuleConfiguration ' should exist."/>
                </a:da>
                <!-- /** @requirements MCU119_Conf */ -->
                <!-- @implements DMCU01009  -->
                <v:ctr name="McuModuleConfiguration"
                    type="MULTIPLE-CONFIGURATION-CONTAINER">
                    <a:a name="LABEL" value="Mcu Module Configuration" />
                  <a:a name="DESC">
                     <a:v><![CDATA[EN:
                       <html>
                         <p>This container contains the configuration (parameters) of the MCU driver.</p>
                       </html>
                      ]]></a:v>
                     </a:a>
                  <a:a name="UUID" value="ECUC:ad451043-0af0-4a92-b5a0-0564d09d4fb7"/>
                  <!-- /** @requirements MCU170_Conf */ -->
                  <!-- @implements DMCU01010  -->
                  <v:var name="McuClockSrcFailureNotification"
                         type="ENUMERATION">
                    <a:a name="LABEL" value="Mcu Clock Src Failure Notification"/>
                    <a:a name="DESC">
                        <a:v><![CDATA[EN:
                          <html>
                           <p>Enables/Disables clock failure notification. In case this feature is not supported by HW the setting should be disabled.</p>
                          </html>
                         ]]></a:v>
                    </a:a>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                         type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v class="PostBuild">VariantPostBuild</icc:v>
                      <icc:v class="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID"
                         value="ECUC:00e78c97-dfed-4edb-ae75-6a521b59c7f1"/>
                    <a:da name="DEFAULT" value="ENABLED" />
                    <a:da name="RANGE">
                      <a:v>DISABLED</a:v>
                      <a:v>ENABLED</a:v>
                    </a:da>
                    <a:da name="INVALID" type="XPath">
                      <a:tst expr="((node:fallback(., 'DISABLED') = 'DISABLED') or (
                      ((node:fallback(../McuResetSource/PLL/McuEnableInterrupt, 'true') = 'true') 
                      and (node:fallback(../McuResetSource/PLL/McuEnableReset, 'false') = 'false') ) 
                      or  ((node:fallback(../McuResetSource/CMU0_OLR/McuEnableInterrupt, 'true') = 'true') 
                      and(node:fallback(../McuResetSource/CMU0_OLR/McuEnableReset, 'false') = 'false') ) 
                      or  ((node:fallback(../McuResetSource/CMU0_FHL/McuEnableInterrupt, 'true') = 'true') 
                      and (node:fallback(../McuResetSource/CMU0_FHL/McuEnableReset, 'false') = 'false'))
                      ))" false="Invalid Value - The Clock notification is enabled so any one of the clock source interrupts (ISR/SAFE Event: PLL, CMU 0 OLR, CMU 0 FHL in McuResetSource tab) needs to be enabled" />
                    </a:da> 
                  </v:var>
                  <!-- /** @requirements MCU171_Conf */ -->
                  <!-- @implements DMCU01011  -->
                  <v:var name="McuNumberOfMcuModes" type="INTEGER">
                   <a:a name="LABEL" value="Mcu Number Of Mcu Modes"/>
                   <a:a name="CALCULATION-FORMULA" value="number of configured mcumodesettingconf" />
                   <a:a name="CALCULATION-LANGUAGE" value="INFORMAL" />
                   <a:a name="DERIVED" value="true" />
                   <a:a name="DESC">
                     <a:v><![CDATA[EN:
                     <html>
                       <p>This parameter shall represent the number of Modes available for the MCU.
                         CalculationFormula = Number of configured McuModeSettingConf.  </p>
                     </html>
                     ]]></a:v>
                   </a:a>
                   <a:a name="IMPLEMENTATIONCONFIGCLASS"
                         type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v class="PostBuild">VariantPostBuild</icc:v>
                      <icc:v class="PreCompile">VariantPreCompile</icc:v>
                   </a:a>
                   <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                   <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                   <a:a name="UUID"
                         value="ECUC:85768384-779c-4d23-afde-2133d6a7ab17"/>
                   <a:da name="INVALID" type="Range">
                      <a:tst expr="&lt;=255"/>
                      <a:tst expr="&gt;=1"/>
                   </a:da>
                     <a:da name="DEFAULT" type="XPath">
                      <a:tst expr="num:i(count(node:fallback(../McuModeSettingConf/*, 1)))"/>
                   </a:da>
                    <a:da name="RANGE" type="XPath">
                      <a:tst expr="node:fallback(., 1) = num:i(count(node:fallback(../McuModeSettingConf/*, 1)))" false="The value for the McuNumberOfMcuModes must match with the McuModeSettingConf. For calculating the correct value use the CALC button"/>
                    </a:da>
                  </v:var>
                  <!-- /** @requirements MCU172_Conf */ -->
                  <!-- @implements DMCU01012 -->
                  <v:var name="McuRamSectors" type="INTEGER">
                   <a:a name="CALCULATION-FORMULA" value="number of configured mcuramsectorsettingconf" />
                   <a:a name="CALCULATION-LANGUAGE" value="INFORMAL" />
                   <a:a name="DERIVED" value="true" />
                   <a:a name="LABEL" value="Mcu Ram Sectors"/>
                      <a:a name="DESC">
                        <a:v><![CDATA[EN:
                        <html>
                          <p>This parameter shall represent the number of RAM sectors available for the MCU.
                            ClculationFormula = Number of configured McuRamSectorSettingConf.  </p>
                        </html>
                        ]]></a:v>
                      </a:a>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                         type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v class="PostBuild">VariantPostBuild</icc:v>
                      <icc:v class="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:a name="UUID" value="ECUC:c6ddbd84-9f0c-424a-9674-80b786af68d0"/>
                    <a:da name="INVALID" type="Range">
                      <a:tst expr="&lt;=4294967295"/>
                      <a:tst expr="&gt;=1"/>
                    </a:da>
                    <a:da name="DEFAULT" type="XPath">
                      <a:tst expr="num:i(count(node:fallback(../McuRamSectorSettingConf/*, 1)))"/>
                    </a:da>
                    <a:da name="RANGE" type="XPath">
                      <a:tst expr="node:fallback(., 1) = num:i(count(node:fallback(../McuRamSectorSettingConf/*, 1)))" false="The value for the McuRamSector must match with the McuRamSectorSettingConf. For calculating the correct value use the CALC button"/>
                    </a:da>
                  </v:var>
                  <!-- /** @requirements MCU173_Conf */ -->
                  <!-- @implements DMCU01013  -->
                  <v:var name="McuResetSetting" type="INTEGER">
                    <a:a name="LABEL" value="Reset Setting" />
                    <a:a name="DESC">
                       <a:v><![CDATA[EN:
                       <html>
                         <p>This parameters applies to the function Mcu_PerformReset, which performs a microcontroller reset using the hardware feature of the microcontroller.  </p>
                         <p> Note: This parameter is not used by the current Implementation. Software Reset occurs when Mcu_PerformReset fucntion is called. The Reset is not user configurable parameter.</p></html>
                     ]]></a:v>
                    </a:a>
                    <a:a name="IMPLEMENTATIONCONFIGCLASS"
                         type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v class="PreCompile">VariantPostBuild</icc:v>
                      <icc:v class="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="OPTIONAL" value="true"/>
                    <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                    <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                    <a:da name="DEFAULT" value="0" />
                    <a:a name="UUID"
                         value="ECUC:24a9fd7b-8246-4cda-bbfb-15b558134461"/>
                    <a:da name="ENABLE" value="false"/>
                    <a:da name="INVALID" type="Range">
                      <a:tst expr="&lt;=255"/>
                      <a:tst expr="&gt;=1"/>
                    </a:da>
                  </v:var>
                   <v:var name="FrequencyOfFXOSC" type="FLOAT">
                          <a:a name="DESC">
                             <a:v><![CDATA[EN:
                              <html>
                                <p> Frequency Of FXOSC [Hz].
                                    FrequencyOfFXOSC has to be in range 4 MHz up to 16 MHz. </p>
                                  <p> Note: Implementation specific Parameter.</p></html>
                              ]]></a:v>
                           </a:a>
                           <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                                  <icc:v class="PreCompile">VariantPreCompile</icc:v>
                                  <icc:v class="PreCompile">VariantPostBuild</icc:v>
                           </a:a>
                           <a:a name="ORIGIN" value="Freescale" />
                           <a:a name="SYMBOLICNAMEVALUE" value="false" />
                           <a:a name="LABEL" value="Frequency Of FXOSC (Fast external crystal oscillator) [Hz]" />
                           <a:a name="UUID" value="ECUC:889cdd04-d16d-40f4-88a5-4abc1c64b40e" />
                           <a:da name="DEFAULT" value="8000000" />
                           <a:da name="INVALID" type="Range">
                              <a:tst expr="&lt;=16000000" />
                              <a:tst expr="&gt;=4000000" />
                           </a:da>
                    </v:var>
                    <v:var name="McuTimeout" type="INTEGER">
                      <a:a name="DESC">
                      <a:v><![CDATA[EN:
                       <html>
                         <p> This parameter is used for internal loop, oscillator stability. It represents the maximum number of loops for blocking functionality.
                             Choose a value of this parameter which is large enough to avoid early exits from loops.
                         </p>
                         <p>Note: Implementation specific Parameter.</p></html>
                       ]]></a:v>
                       </a:a>
                        <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
                          <icc:v class="PreCompile">VariantPreCompile</icc:v>
                          <icc:v class="PostBuild">VariantPostBuild</icc:v>
                        </a:a>
                        <a:a name="ORIGIN" value="Freescale" />
                        <a:a name="SYMBOLICNAMEVALUE" value="false" />
                        <a:a name="UUID" value="ECUC:0ea33274-0efa-45c1-93a6-e9f72696254c" />
                        <a:da name="DEFAULT" value="4294967294" />
                        <a:a name="LABEL" value="Loops TimeOut" />
                        <a:da name="INVALID" type="Range">
                           <a:tst expr="&gt;=0" />
                           <a:tst expr="&lt;=4294967294" />
                        </a:da>
                     </v:var>
    <v:ctr name="McuEnableMode" type="IDENTIFIABLE">
      <a:a name="LABEL" value="Mcu Enable Mode" />
      <a:a name="DESC">
        <a:v>
          <![CDATA[EN:  <html>  <p> This container allows a way to disable the device modes which are not required for a given device. RESET, SAFE, DRUN and RUN0 modes are always enabled.
          </p>
        </html> ]]></a:v>
      </a:a>
      <a:a name="UUID" value="ECUC:efb1a307-e01d-4b5a-ac2f-a5853c80a090" />
      <v:var name="McuModeStop" type="BOOLEAN">
        <a:a name="DESC">
          <a:v>
          <![CDATA[EN:  <html> <p>Check if you want enable the STOP mode. </p><p>Note: Implementation specific Parameter .</p> </html> ]]>
        </a:v>
      </a:a>
      <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
        <icc:v class="PreCompile">VariantPreCompile</icc:v>
        <icc:v class="PostBuild">VariantPostBuild</icc:v>
      </a:a>
      <a:a name="ORIGIN" value="Freescale" />
      <a:a name="SYMBOLICNAMEVALUE" value="false" />
      <a:a name="LABEL" value="STOP Mode" />
      <a:a name="UUID" value="ECUC:61a93789-8cb1-44ed-a4d1-bed9683a1978" />
      <a:da name="DEFAULT" value="true" />
    </v:var>
    <v:var name="McuModeSTBY" type="BOOLEAN">
      <a:a name="DESC">
        <a:v>
        <![CDATA[EN:  <html> <p> Check if you want enable the StandBy mode. </p><p>Note: Implementation specific Parameter .</p> </html> ]]>
      </a:v>
    </a:a>
    <a:a name="IMPLEMENTATIONCONFIGCLASS" type="IMPLEMENTATIONCONFIGCLASS">
      <icc:v class="PreCompile">VariantPreCompile</icc:v>
      <icc:v class="PostBuild">VariantPostBuild</icc:v>
    </a:a>
    <a:a name="ORIGIN" value="Freescale" />
    <a:a name="SYMBOLICNAMEVALUE" value="false" />
    <a:a name="LABEL" value="STANDBY Mode" />
